{
  "name": "score-docs-checks",
  "private": true,
  "description": "Checks for the ossia score documentation (the site itself is built with Jekyll)",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:html": "html-validate \"_site/**/*.html\"",
    "check:privacy": "node .github/scripts/privacy-scan.mjs _site",
    "check:a11y": "node .github/scripts/a11y-audit.mjs _site",
    "check:release": "node .github/scripts/check-latest-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
