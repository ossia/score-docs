ue,"Custom":"Output","Exposed":"output","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Reset","Exposed":"reset","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Send","Exposed":"send","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["EveryTick",{"Int":0}],["OnInput",{"Int":1}],["Manually",{"Int":2}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Count","Exposed":"count"},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Ceiling","Exposed":"ceiling"}]},{"uuid":"3127c11b-61d3-4d5e-a896-8b56e628dfbc","ObjectName":"avnd_arraytobuffer","id":3,"Metadata":{"ScriptingName":"Array to buffer","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-927.4403554314767,-133.35449842048388],"Size":[198.0,80.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Input","Exposed":"input"},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Type","Exposed":"type","Value":{"String":"Float32"},"Init":{"String":"Float32"},"Domain":{"String":{"Values":["Float32","Float64","SInt32","UInt32","SInt16","UInt16","SInt8","UInt8"]}},"Values":["Float32","Float64","SInt32","UInt32","SInt16","UInt16","SInt8","UInt8"],"Pixmaps":[]}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Output","Exposed":"output"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":2,"Metadata":{"ScriptingName":"ParticleTrail","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-712.314637429256,-157.6611880038887],"Size":[360.0,311.5],"Loops":false,"FoldMode":0,"Compute":"/*{\n\"DESCRIPTION\": \"Generates a particle trail from an SSBO. Each frame, new points are appended into a circular buffer in the output geometry. Old particles fade and shrink over time.\",\n\"CREDIT\": \"ossia score\",\n\"ISFVSN\": \"2.0\",\n\"MODE\": \"COMPUTE_SHADER\",\n\"CATEGORIES\": [\"Geometry Generator\", \"Particles\"],\n\"RESOURCES\": [\n  {\n    \"NAME\": \"geo\",\n    \"TYPE\": \"geometry\",\n    \"VERTEX_COUNT\": 6,\n    \"INSTANCE_COUNT\": \"$maxParticles\",\n    \"ATTRIBUTES\": [\n      { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\", \"RATE\": \"instance\" },\n      { \"NAME\": \"color\",    \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\", \"RATE\": \"instance\" },\n      { \"NAME\": \"sprite_size\", \"SEMANTIC\": \"sprite_size\",  \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\", \"RATE\": \"instance\" }\n    ]\n  },\n  {\n    \"NAME\": \"xyBuffer\",\n    \"TYPE\": \"storage\",\n    \"ACCESS\": \"read_only\",\n    \"LAYOUT\": [\n      { \"NAME\": \"particles\", \"TYPE\": \"vec2[]\" }\n    ],\n    \"DESCRIPTION\": \"SSBO containing the NEW points for this frame as flat [x,y,x,y...].\"\n  },\n  { \"NAME\": \"maxParticles\",    \"TYPE\": \"long\",  \"DEFAULT\": 100, \"MIN\": 1, \"MAX\": 2048 },\n  { \"NAME\": \"newPointCount\",   \"TYPE\": \"long\",  \"DEFAULT\": 0,   \"MIN\": 0, \"MAX\": 2048, \"DESCRIPTION\": \"How many new points are in xyBuffer this frame.\" },\n  { \"NAME\": \"writeHead\",       \"TYPE\": \"long\",  \"DEFAULT\": 0,   \"MIN\": 0, \"MAX\": 2147483647, \"DESCRIPTION\": \"Circular buffer write head. Host increments this by newPointCount each frame.\" },\n  { \"NAME\": \"totalWritten\",    \"TYPE\": \"long\",  \"DEFAULT\": 0,   \"MIN\": 0, \"MAX\": 2147483647, \"DESCRIPTION\": \"Total points written so far (for knowing when buffer isn't full yet).\" },\n  { \"NAME\": \"trailFade\",       \"TYPE\": \"bool\",  \"DEFAULT\": true },\n  { \"NAME\": \"baseColor\",       \"TYPE\": \"color\", \"DEFAULT\": [0.2, 0.8, 1.0, 1.0] },\n  { \"NAME\": \"tailColor\",       \"TYPE\": \"color\", \"DEFAULT\": [0.0, 0.1, 0.3, 0.0] },\n  { \"NAME\": \"startSize\",       \"TYPE\": \"float\", \"DEFAULT\": 1.0, \"MIN\": 0.0, \"MAX\": 10.0 },\n  { \"NAME\": \"endSize\",         \"TYPE\": \"float\", \"DEFAULT\": 0.0, \"MIN\": 0.0, \"MAX\": 10.0 }\n],\n\"PASSES\": [\n  { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_INSTANCE\" } }\n]\n}*/\n\nvoid main()\n{\n    uint idx = gl_GlobalInvocationID.x;\n    uint uMax = uint(maxParticles);\n\n    if (idx >= uMax)\n        return;\n\n    uint uNewCount    = uint(newPointCount);\n    uint uWriteHead   = uint(writeHead);\n    uint uTotalWritten = uint(totalWritten);\n\n    // --- Phase 1: Write new points into the circular buffer ---\n    // Threads where idx < newPointCount are responsible for writing new data.\n    // The write position in the ring is (writeHead + idx) % maxParticles.\n    if (idx < uNewCount)\n    {\n        uint writeSlot = (uWriteHead + idx) % uMax;\n        vec2 p = xyBuffer.particles[idx];\n        ISF_WRITE(geo, position)[writeSlot] = vec4(p.x, p.y, 0.0, 1.0);\n    }\n\n    // --- Phase 2: Update color and size for ALL particles based on age ---\n    // After new points are written, the new head will be at:\n    uint newHead = (uWriteHead + uNewCount) % uMax;\n    // How many particles are actually alive:\n    uint aliveCount = min(uTotalWritten + uNewCount, uMax);\n\n    // Compute this particle's age in the ring buffer.\n    // Age 0 = newest (just written), age (aliveCount-1) = oldest.\n    // The newest particle is at index (newHead - 1) mod uMax,\n    // so age of slot idx = (newHead - 1 - idx) mod uMax.\n    uint age = (newHead + uMax - 1u - idx) % uMax;\n\n    // If the buffer isn't full yet, some slots are unoccupied.\n    // Hide them by giving size 0 and alpha 0.\n    if (age >= aliveCount)\n    {\n        ISF_WRITE(geo, color)[idx]       = vec4(0.0);\n        ISF_WRITE(geo, sprite_size)[idx] = vec4(0.0);\n        return;\n    }\n\n    float normalizedAge = float(age) / float(max(aliveCount - 1u, 1u));\n\n    vec4  finalColor = baseColor;\n    float finalSize  = startSize;\n\n    if (trailFade)\n    {\n        finalColor = mix(baseColor, tailColor, normalizedAge);\n        finalSize  = mix(startSize, endSize,   normalizedAge);\n    }\n \n    ISF_WRITE(geo, color)[idx]       = finalColor;\n    ISF_WRITE(geo, sprite_size)[idx] = vec4(finalSize);\n}","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geo","Exposed":"geo"},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"xyBuffer","Exposed":"xybuffer","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"maxParticles","Exposed":"maxparticles","Value":{"Int":2048},"Init":{"Int":100},"Domain":{"Int":{"Min":1,"Max":2048}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"newPointCount","Exposed":"newpointcount","Value":{"Int":762},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":2048}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"writeHead","Exposed":"writehead","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":2147483647}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"totalWritten","Exposed":"totalwritten","Value":{"Int":2048},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":2147483647}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"trailFade","Exposed":"trailfade","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"baseColor","Exposed":"basecolor","Value":{"Vec4f":[0.20000000298023224,0.800000011920929,1.0,1.0]},"Init":{"Vec4f":[0.20000000298023224,0.800000011920929,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"tailColor","Exposed":"tailcolor","Value":{"Vec4f":[0.9951323866844177,0.23038071393966675,0.045136187225580215,1.0]},"Init":{"Vec4f":[0.0,0.10000000149011612,0.30000001192092896,0.0]},"Domain":{}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"startSize","Exposed":"startsize","Value":{"Float":0.5374671816825867},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"endSize","Exposed":"endsize","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":10.0}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geo_out","Exposed":"geo_out"}]},{"uuid":"898078f0-b825-4c29-a997-dc856e351a97","ObjectName":"point2d_view","id":33,"Metadata":{"ScriptingName":"Point2D View","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-1687.2911334086357,159.28010302678922],"Size":[200.0,100.0],"Loops":false,"FoldMode":2,"Inlets":[{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"XY","Exposed":"xy","Value":{},"Init":{},"Domain":{}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Min X","Exposed":"min x","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Min Y","Exposed":"min y","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Max X","Exposed":"max x","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Max Y","Exposed":"max y","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}}],"Outlets":[]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":34,"Metadata":{"ScriptingName":"Text Box","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-2105.46893582975,-509.2299422999223],"Size":[567.0,143.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">This example shows how to go from keypoints from pose tracking, </p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">to 3D geometry and GPU pipelines.<br /><br />First, you need to download a model pack and presets, <br />for instance from LivePose (SAT):<br />https://github.com/sat-mtl/livepose/releases/download/model-storage/onnx-models-large.7z<br />and extract them in your score user library (&amp; restart score for it to parse the new presets).<br /><br />Then, pick the preset of your choice: the default preset is a simple face tracking.</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":35,"Metadata":{"ScriptingName":"Text Box.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-1461.7575916089254,162.76807207619458],"Size":[334.0,23.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The data in this case is between [0; 1] : we extend it a bit</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":36,"Metadata":{"ScriptingName":"Text Box.2","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-1194.2575916089254,116.76807207619458],"Size":[252.0,38.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">We're going to have a virtual point queue<br />in a compute shader</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":37,"Metadata":{"ScriptingName":"Text Box.3","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":105840