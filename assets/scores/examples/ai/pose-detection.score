 text-indent:0px;\"><span style=\" font-size:12px;\">ossia score supports many pose detection models, as well as multi-person-tracking and ReID, <br />on GPU.<br /><br />You can use the model packs from the Suite SAT and LivePose: <br />https://github.com/sat-mtl/livepose/releases/tag/model-storage ; <br />extract them in ~/Documents/ossia/score/packages/ and restart score to have all the presets<br />appear.<br /><br />On Windows with NVidia GPU, you must install the latest version of the CUDA Toolkit  (at this time, 13.3) <br />and restart your machine to get GPU acceleration. https://developer.nvidia.com/cuda-downloads<br /><br />Same on Linux, but install it through your distro.  Older versions won't work.<br /></span></p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"4cf2f89f-45b6-4878-92ff-23d3cee1c67e","ObjectName":"object_filter","id":8,"Metadata":{"ScriptingName":"Object filter","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[269.77206480628064,-386.8556600720792],"Size":[227.0,55.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Input","Exposed":"input"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Filter","Exposed":"filter","Value":{"String":".keypoints[0].x"},"Init":{"String":""},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"bang","Exposed":"bang"}]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":9,"Metadata":{"ScriptingName":"Text Box.10","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[260.09107977564,-22.54743550602973],"Size":[464.0,86.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:12px;\">The object's outputs give either the complete data, for instance for <br />processing through Javascript or in the tracking-zones object, <br />or individual geometry if one just wants to quickly get geometry on a GPU.<br />First two outlets are for an individual detection, the next two will return a list with <br />all the detected poses instead of just the first one.<br />Last outlet returns the number of detections.</span></p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":10,"Metadata":{"ScriptingName":"Text Box.11","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[267.41