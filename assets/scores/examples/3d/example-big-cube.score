    }]\n}*/ \n\nfloat hash(uint seed) {\n    seed ^= seed >> 17u;\n    seed *= 0xed5ad4bbu; \n    seed ^= seed >> 11u;\n    seed *= 0xac4c1b51u;\n    seed ^= seed >> 15u;\n    seed *= 0x31848babu;\n    seed ^= seed >> 14u;\n    return float(seed) / 4294967296.0; \n}\n\nfloat randomFloat(uint seed) {\n    return hash(seed) * 100.0 - 50.0;\n}\n\nvoid main() \n{\n    uint totalX = gl_NumWorkGroups.x * gl_WorkGroupSize.x;\n    uint totalY = gl_NumWorkGroups.y * gl_WorkGroupSize.y;\n    \n    uint globalIndex = gl_GlobalInvocationID.x + \n                       gl_GlobalInvocationID.y * totalX + \n                       gl_GlobalInvocationID.z * totalX * totalY;\n    \n    uint size = uint(float_array.length());\n    \n    // Each invocation handles 24 floats (8 points)\n    uint coord = 64u * globalIndex;\n    \n    if (coord + 63u >= size)\n        return;\n    \n    uint timeSeed = uint(TIME * 1000.0);\n    \n    // Generate 24 floats (8 xyz points)\n    for(int i = 0; i < 64; i++) {\n        uint seed = (coord + uint(i)) * 747796405u + timeSeed * 2891336453u;\n        float_array[coord + uint(i)] = randomFloat(seed);\n    }\n}","Inlets":[{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"NoiseBuffer size","Exposed":"noisebuffer size","Value":{"Int":536870910},"Init":{"Int":1024},"Domain":{"Int":{"Min":1,"Max":536870911}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"NoiseBuffer","Exposed":"noisebuffer"}]},{"uuid":"2450ffbf-04ed-4b42-8848-69f200d2742a","ObjectName":"pointcloud_to_mesh","id":6,"Metadata":{"ScriptingName":"Pointcloud to mesh","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-34.191953125000055,-30.361382812499983],"Size":[221.0,159.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","