{"Document":{"ObjectName":"Scenario::ScenarioDocumentModel","id":1,"BaseScenario":{"ObjectName":"Scenario::BaseScenario","id":0,"Constraint":{"ObjectName":"Scenario::IntervalModel","id":0,"Metadata":{"ScriptingName":"example-big-cube","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Inlet":{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Audio In","Exposed":"audio in"},"Outlet":{"uuid":"a1d97535-18ac-444a-8417-0cbc1692d897","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Audio Out","Exposed":"audio out","Address":"audio:/out/main","GainInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10000,"Hidden":false,"Custom":"Gain","Exposed":"gain","Value":{},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},"PanInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[{"uuid":"d757bd0d-c0a1-4aec-bf72-945b722ab85b","ObjectName":"MathGenerator","id":14,"Metadata":{"ScriptingName":"XYZ","Comment":"","Color":"Transparent1","Label":"XYZ","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-262.0573359778805,47.76616830744746],"Size":[216.0,85.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Expression (ExprTK)","Exposed":"expression (exprtk)","Value":{"String":"return [360sin(pos), 360cos(pos), c];"},"Init":{"String":"cos(t) + log(pos * (1+a) / (1+abs(dt)))"},"Domain":{}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Param (a)","Exposed":"param (a)","Value":{"Float":1.0},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Param (b)","Exposed":"param (b)","Value":{"Float":1.0},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Param (c)","Exposed":"param (c)","Value":{"Float":1.0},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":13,"Metadata":{"ScriptingName":"Noise","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-217.2232335800781,-26.829108787695304],"Size":[168.0,32.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n    \"DESCRIPTION\": \"Generates random RGB noise in a read-write image\",\n    \"CREDIT\": \"ossia score\",\n    \"ISFVSN\": \"2.0\",\n    \"MODE\": \"COMPUTE_SHADER\",\n    \"CATEGORIES\": [\"GENERATOR\", \"NOISE\"],\n    \"RESOURCES\": [\n      {\n        \"NAME\": \"NoiseBuffer\",\n        \"TYPE\": \"storage\",\n        \"ACCESS\": \"read_write\",\n        \"LAYOUT\": [ \n           { \"NAME\": \"float_array\", \"TYPE\": \"float[]\" }\n        ]\n      }\n    ], \n    \"PASSES\": [{\n      \"LOCAL_SIZE\": [64, 1, 1],\n      \"EXECUTION_MODEL\": {  \"TYPE\": \"MANUAL\", \"WORKGROUPS\": [12208, 8, 1] }\n    }]\n}*/\n\nfloat hash(uint seed) {\n    seed ^= seed >> 17u;\n    seed *= 0xed5ad4bbu;\n    seed ^= seed >> 11u;\n    seed *= 0xac4c1b51u;\n    seed ^= seed >> 15u;\n    seed *= 0x31848babu;\n    seed ^= seed >> 14u;\n    return float(seed) / 4294967296.0;\n}\n\nfloat randomFloat(uint seed) {\n    return hash(seed) * 100.0 - 50.0;\n}\n\nvoid main() \n{\n    uint totalX = gl_NumWorkGroups.x * gl_WorkGroupSize.x;\n    uint totalY = gl_NumWorkGroups.y * gl_WorkGroupSize.y;\n    \n    uint globalIndex = gl_GlobalInvocationID.x + \n                       gl_GlobalInvocationID.y * totalX + \n                       gl_GlobalInvocationID.z * totalX * totalY;\n    \n    uint size = uint(NoiseBuffer.float_array.length());\n    \n    // Each invocation handles 24 floats (8 points)\n    uint coord = 64u * globalIndex;\n     \n    if (coord + 63u >= size)\n        return;\n    \n    uint timeSeed = uint(TIME * 1000.0);\n    \n    // Generate 24 floats (8 xyz points)\n    for(int i = 0; i < 64; i++) {\n        uint seed = (coord + uint(i)) * 747796405u + timeSeed * 2891336453u;\n        NoiseBuffer.float_array[coord + uint(i)] = randomFloat(seed);\n    }\n}","Inlets":[{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"NoiseBuffer size","Exposed":"noisebuffer size","Value":{"Int":10240000},"Init":{"Int":1024},"Domain":{"Int":{"Min":1,"Max":536870911}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"NoiseBuffer","Exposed":"noisebuffer"}]},{"uuid":"2450ffbf-04ed-4b42-8848-69f200d2742a","ObjectName":"pointcloud_to_mesh","id":6,"Metadata":{"ScriptingName":"Pointcloud to mesh","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-2.1919531250000546,-45.36138281249998],"Size":[221.0,159.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Buffer","Exposed":"buffer","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Position","Exposed":"position","Value":{"Vec3f":[96.04925537109375,58.12565612792969,39.49650192260742]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[-8388608.0,-8388608.0,-8388608.0],"Max":[8388608.0,8388608.0,8388608.0],"Values":[[],[],[]]}}},{"uuid":"377e8205-b442-4d54-8832-3761d