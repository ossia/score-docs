{"Document":{"ObjectName":"Scenario::ScenarioDocumentModel","id":1,"BaseScenario":{"ObjectName":"Scenario::BaseScenario","id":0,"Constraint":{"ObjectName":"Scenario::IntervalModel","id":0,"Metadata":{"ScriptingName":"array-to-mesh","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Inlet":{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Audio In","Exposed":"audio in"},"Outlet":{"uuid":"a1d97535-18ac-444a-8417-0cbc1692d897","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Audio Out","Exposed":"audio out","Address":"audio:/out/main","GainInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10000,"Hidden":false,"Custom":"Gain","Exposed":"gain","Value":{},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},"PanInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[{"uuid":"cf3df02f-a563-4e92-a739-b321d3a84252","ObjectName":"ArrayGenerator","id":5,"Metadata":{"ScriptingName":"Arraygen.3","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-705.0,-46.66666666666673],"Size":[180.0,232.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"var v := floor(i / 3) ; \nvar c := i - 3 * v; \nvar tri := floor(v / 3); \nvar j := v - 3 * tri; \nvar a0 := tri * 0.157 + pos; \nvar a := j == 1 ? a0 : a0 + 0.157;\n var r := j == 0 ? 0 : 1 + 0.3 * sin(tri * sin(pos)); \nc == 0 \n  ? r * cos(a) \n  : (c == 1 ? r * sin(a) : 0.2 * sin(tri * 0.5) * (j > 0))"},"Init":{"String":"i"},"Domain":{}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Size","Exposed":"size","Value":{"Int":360},"Init":{"Int":12},"Domain":{"Int":{"Min":0,"Max":1024}}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"dfc5bae9-c75c-4180-b4e8-be3063c8d8f2","ObjectName":"array_to_mesh","id":6,"Metadata":{"ScriptingName":"Array to mesh.2","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-506.5,-48.33333333333339],"Size":[221.0,148.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Input","Exposed":"input"},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Position","Exposed":"position","Value":{"Vec3f":[0.0,0.0,0.0]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[-8388608.0,-8388608.0,-8388608.0],"Max":[8388608.0,8388608.0,8388608.0],"Values":[[],[],[]]}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Rotation","Exposed":"rotation","Value":{"Vec3f":[0.0,0.0,0.0]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[0.0,0.0,0.0],"Max":[360.0,360.0,360.0],"Values":[[],[],[]]}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Scale","Exposed":"scale","Value":{"Vec3f":[1.0,1.0,1.0]},"Init":{"Vec3f":[1.0,1.0,1.0]},"Domain":{"Vec3f":{"Min":[0.000009999999747378752,0.000009999999747378752,0.000009999999747378752],"Max":[1000.0,1000.0,1000.0],"Values":[[],[],[]]}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Triangulate","Exposed":"triangulate","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Geometry","Exposed":"geometry"}]},{"uuid":"dbfc2101-40d7-4807-8804-571e88992e7e","ObjectName":"gfxProcess","id":7,"Metadata":{"ScriptingName":"Render Pipeline.4","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-277.5,-46.5],"Size":[584.0,239.0],"Loops":false,"FoldMode":0,"Vertex":"// Reverse-Z perspective, same convention as the engine's CameraMath.hpp\n// setReverseZPerspective (GL-style NDC in, clipSpaceCorrMatrix remaps).\nmat4 gallery_perspective(float fovYDeg, float aspect, float n, float f)\n{\n    float c = 1.0 / tan(radians(fovYDeg) * 0.5);\n    mat4 m = mat4(0.0);\n    m[0][0] = c / aspect;\n    m[1][1] = c;\n    m[2][2] = (f + n) / (f - n);\n    m[3][2] = (2.0 * f * n) / (f - n);\n    m[2][3] = -1.0;\n    return m;\n}\n\nmat4 gallery_lookAt(vec3 e, vec3 c, vec3 up)\n{\n    vec3 f = normalize(c - e);\n    vec3 s = normalize(cross(f, up));\n    vec3 u = cross(s, f);\n    mat4 m = mat4(1.0);\n    m[0][0] = s.x; m[1][0] = s.y; m[2][0] = s.z;\n    m[0][1] = u.x; m[1][1] = u.y; m[2][1] = u.z;\n    m[0][2] = -f.x; m[1][2] = -f.y; m[2][2] = -f.z;\n    m[3][0] = -dot(s, e);\n    m[3][1] = -dot(u, e);\n    m[3][2] = dot(f, e);\n    return m;\n}\n\nvoid main()\n{\n    isf_vertShaderInit();\n\n    vec4 wp = MODEL_MATRIX * vec4(position, 1.0);\n    v_worldPos = wp.xyz;\n    v_normal = mat3(MODEL_MATRIX) * normal;\n    v_uv = texcoord;\n    v_color = color;\n\n    float aspect = RENDERSIZE.x / max(RENDERSIZE.y, 1.0);\n    mat4 P = gallery_perspective(fov, aspect, 0.05, 200.0);\n    mat4 Vw = gallery_lookAt(eye, target, vec3(0.0, 1.0, 0.0));\n    gl_Position = clipSpaceCorrMatrix * P * Vw * wp;\n\n    isf_vertShaderFinish();\n}\n","Fragment":"/*{\n  \"DESCRIPTION\": \"Gallery viewer for the GEOMETRY path (primitives, mesh loaders, mesh modifiers, CSF producers wired straight into a Render Pipeline). Placement from MODEL_MATRIX (the producer's own Position/Rotation/Scale controls), camera built from the eye/target/fov INPUTS with the engine's reverse-Z perspective (CameraMath.hpp setReverseZPerspective: near maps to NDC +1, far to -1, GREATER compare). Shading: one directional key light (Lambert + Blinn-Phong highlight) plus a hemispheric ambient term, over a base colour optionally modulated by a procedural UV checker (so texcoords are visible) and by the vertex colour. Missing normals fall back to screen-space derivatives of the world position (flat shading), so point-less meshes without normals still read as 3D.\",\n  \"CREDIT\": \"threedim gallery; Blinn-Phong after J. F. Blinn, 'Models of light reflection for computer synthesized pictures', SIGGRAPH 1977; hemispheric ambient after the classic sky/ground lerp.\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"RAW_RASTER_PIPELINE\",\n  \"CATEGORIES\": [\"GALLERY\", \"Renderer\"],\n  \"VERTEX_INPUTS\": [\n    { \"TYPE\": \"vec3\", \"NAME\": \"position\" },\n    { \"TYPE\": \"vec3\", \"NAME\": \"normal\", \"REQUIRED\": false },\n    { \"TYPE\": \"vec2\", \"NAME\": \"texcoord\", \"REQUIRED\": false },\n    { \"TYPE\": \"vec4\", \"NAME\": \"color\", \"REQUIRED\": false }\n  ],\n  \"VERTEX_OUTPUTS\": [\n    { \"TYPE\": \"vec3\", \"NAME\": \"v_worldPos\" },\n    { \"TYPE\": \"vec3\", \"NAME\": \"v_normal\" },\n    { \"TYPE\": \"vec2\", \"NAME\": \"v_uv\" },\n    { \"TYPE\": \"vec4\", \"NAME\": \"v_color\" }\n  ],\n  \"FRAGMENT_INPUTS\": [\n    { \"TYPE\": \"vec3\", \"NAME\": \"v_worldPos\" },\n    { \"TYPE\": \"vec3\", \"NAME\": \"v_normal\" },\n    { \"TYPE\": \"vec2\", \"NAME\": \"v_uv\" },\n    { \"TYPE\": \"vec4\", \"NAME\": \"v_color\" }\n  ],\n  \"FRAGMENT_OUTPUTS\": [ { \"TYPE\": \"vec4\", \"NAME\": \"isf_FragColor\" } ],\n  \"PIPELINE_STATE\": { \"CULL_MODE\": \"none\", \"DEPTH_TEST\": true, \"DEPTH_WRITE\": true },\n  \"INPUTS\": [\n    { \"NAME\": \"eye\", \"TYPE\": \"point3D\", \"DEFAULT\": [2.0, 1.5, 3.0], \"MIN\": [-100.0, -100.0, -100.0], \"MAX\": [100.0, 100.0, 100.0] },\n    { \"NAME\": \"target\", \"TYPE\": \"point3D\", \"DEFAULT\": [0.0, 0.0, 0.0], \"MIN\": [-100.0, -100.0, -100.0], \"MAX\": [100.0, 100.0, 100.0] },\n    { \"NAME\": \"fov\", \"TYPE\": \"float\", \"DEFAULT\": 45.0, \"MIN\": 5.0, \"MAX\": 150.0 },\n    { \"NAME\": \"lightDir\", \"TYPE\": \"point3D\", \"DEFAULT\": [0.4, 0.8, 0.5], \"MIN\": [-1.0, -1.0, -1.0], \"MAX\": [1.0, 1.0, 1.0] },\n    { \"NAME\": \"baseColor\", \"TYPE\": \"color\", \"DEFAULT\": [0.85, 0.55, 0.3, 1.0] }\n  ]\n}*/\n\nvoid main()\n{\n    vec3 N = v_normal;\n    if(dot(N, N) < 1e-8)\n        N = normalize(cross(dFdx(v_worldPos), dFdy(v_worldPos)));\n    else\n        N = normalize(N);\n\n    vec3 V = normalize(eye - v_worldPos);\n    if(dot(N, V) < 0.0)\n        N = -N; // two-sided: planes and open meshes shade on both faces\n\n    vec3 L = normalize(lightDir);\n    vec3 H = normalize(L + V);\n\n    vec3 albedo = baseColor.rgb;\n\n    float hemi = 0.5 + 0.5 * N.y;\n    vec3 ambient = mix(vec3(0.10, 0.09, 0.08), vec3(0.28, 0.32, 0.40), hemi);\n    float diff = max(dot(N, L), 0.0);\n    float spec = pow(max(dot(N, H), 0.0), 48.0) * step(0.0, dot(N, L));\n\n    vec3 col = albedo * (ambient + 0.9 * diff) + 0.35 * spec;\n    isf_FragColor = vec4(col, 1.0);\n}\n","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":1000,"Hidden":false,"Custom":"Geometry In","Exposed":"geometry in"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Mode","Exposed":"mode","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3]}},"Values":[["Triangles",{"Int":0}],["Points",{"Int":1}],["Lines",{"Int":2}],["Geometry",{"Int":3}]],"FolderPort":"","FileExtensions":""},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"EnableBlend","Exposed":"enableblend","Value":{"Bool":true},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":