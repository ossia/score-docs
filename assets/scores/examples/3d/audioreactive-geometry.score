ax":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Jitter","Exposed":"jitter","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Phase","Exposed":"phase","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-1.0,"Max":1.0}}},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Waveform","Exposed":"waveform","Value":{"String":"SampleAndHold"},"Init":{"String":"Sin"},"Domain":{"String":{"Values":["Sin","Triangle","Saw","Square","SampleAndHold","Noise1","Noise2","Noise3"]}},"Values":["Sin","Triangle","Saw","Square","SampleAndHold","Noise1","Noise2","Noise3"],"Pixmaps":[":/icons/wave_sin_off.png",":/icons/wave_sin_on.png",":/icons/wave_triangle_off.png",":/icons/wave_triangle_on.png",":/icons/wave_saw_off.png",":/icons/wave_saw_on.png",":/icons/wave_square_off.png",":/icons/wave_square_on.png",":/icons/wave_sample_and_hold_off.png",":/icons/wave_sample_and_hold_on.png",":/icons/wave_noise1_off.png",":/icons/wave_noise1_on.png",":/icons/wave_noise2_off.png",":/icons/wave_noise2_on.png",":/icons/wave_noise3_off.png",":/icons/wave_noise3_on.png"]},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Quantification","Exposed":"quantification","Value":{"Float":0.25},"Init":{"Float":0.25},"Domain":{"Float":{"Values":[0.0,1.0,0.5,0.25,0.125,0.0625,0.03125,0.015625,0.75,0.375,0.1875,0.09375,0.046875]}},"Values":[["None",{"Float":0.0}],["Whole",{"Float":1.0}],["Half",{"Float":0.5}],["4th",{"Float":0.25}],["8th",{"Float":0.125}],["16th",{"Float":0.0625}],["32th",{"Float":0.03125}],["64th",{"Float":0.015625}],["Dotted Half",{"Float":0.75}],["Dotted 4th",{"Float":0.375}],["Dotted 8th",{"Float":0.1875}],["Dotted 16th",{"Float":0.09375}],["Dotted 32th",{"Float":0.046875}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":7,"Metadata":{"ScriptingName":"AddColor","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-42.719375,135.61400000000003],"Size":[275.0,391.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Add or replace the color attribute on geometry. Solid: solidColor. By Index: a rainbow along the vertex order (saturation). Random: a random hue per vertex (seed, saturation). Axis Gradient: colorA at -1 to colorB at +1 along gradientAxis (clamped outside). alpha multiplies the result.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Geometry Modifier\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" },\n        { \"NAME\": \"color\",    \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\" }\n      ]\n    },\n    {\n      \"NAME\": \"colorMode\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 1,\n      \"VALUES\": [0, 1, 2, 3],\n      \"LABELS\": [\"Solid\", \"By Index\", \"Random\", \"Axis Gradient\"]\n    },\n    {\n      \"NAME\": \"solidColor\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [1.0, 1.0, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"colorA\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [0.2, 0.4, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"colorB\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [1.0, 0.3, 0.1, 1.0]\n    },\n    {\n      \"NAME\": \"seed\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 42.0,\n      \"MIN\": 0.0,\n      \"MAX\": 1000.0\n    },\n    {\n      \"NAME\": \"saturation\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.7,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"alpha\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.0,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"gradientAxis\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 1,\n      \"VALUES\": [0, 1, 2],\n      \"LABELS\": [\"X\", \"Y\", \"Z\"]\n    }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\nuint pcg(uint s)\n{\n  s ^= s >> 17u; s *= 0xed5ad4bbu;\n  s ^= s >> 11u; s *= 0xac4c1b51u;\n  s ^= s >> 15u; s *= 0x31848babu;\n  s ^= s >> 14u;\n  return s;\n}\n\nfloat rand01(uint s) { return float(pcg(s)) / 4294967296.0; }\n\n// HSV to RGB\nvec3 hsv2rgb(float h, float s, float v)\n{\n  vec3 c = vec3(h, s, v);\n  vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0);\n  return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);\n}\n\nvoid main()\n{\n  uint idx = gl_GlobalInvocationID.x;\n  uint count = uint(ISF_READ(geo, position).length());\n  if(idx >= count)\n    return;\n\n  vec4 col;\n\n  // Mode 0: Solid color\n  if(colorMode == 0)\n  {\n    col = solidColor;\n  }\n  // Mode 1: By index (HSV rainbow)\n  else if(colorMode == 1)\n  {\n    float t = float(idx) / max(float(count - 1u), 1.0);\n    col = vec4(hsv2rgb(t, saturation, 1.0), 1.0);\n  }\n  // Mode 2: Random per-vertex\n  else if(colorMode == 2)\n  {\n    uint s = idx * 7919u + uint(seed * 65537.0);\n    float hue = rand01(s);\n    col = vec4(hsv2rgb(hue, saturation, 0.8 + 0.2 * rand01(s + 1u)), 1.0);\n  }\n  // Mode 3: Axis gradient (colorA -> colorB)\n  else\n  {\n    vec3 pos = ISF_READ(geo, position)[idx].xyz;\n    float v = pos[gradientAxis];\n\n    // Auto-normalize: scan is too expensive, use a reasonable range\n    // Map [-1, 1] to [0, 1] — works for most generators\n    float t = clamp(v * 0.5 + 0.5, 0.0, 1.0);\n    col = mix(colorA, colorB, t);\n  }\n\n  col.a *= alpha;\n  ISF_WRITE(geo, color)[idx] = col;\n}\n","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geo","Exposed":"geo"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"colorMode","Exposed":"colormode","Value":{"Int":0},"Init":{"Int":1},"Domain":{"Int":{"Values":[0,1,2,3]}},"Values":[["Solid",{"Int":0}],["By Index",{"Int":1}],["Random",{"Int":2}],["Axis Gradient",{"Int":3}]],"FolderPort":"","FileExtensions":""},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"solidColor","Exposed":"solidcolor","Value":{"Vec4f":[0.08499275147914886,0.05377279222011566,0.025925077497959137,1.0]},"Init":{"Vec4f":[1.0,1.0,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"colorA","Exposed":"colora","Value":{"Vec4f":[0.42119479179382324,0.6749981045722961,0.1586327850818634,1.0]},"Init":{"Vec4f":[0.20000000298023224,0.4000000059604645,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"colorB","Exposed":"colorb","Value":{"Vec4f":[0.6549935340881348,0.7545281052589417,1.0,1.0]},"Init":{"Vec4f":[1.0,0.30000001192092896,0.10000000149011612,1.0]},"Domain":{}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"seed","Exposed":"seed","Value":{"Float":42.0},"Init":{"Float":42.0},"Domain":{"Float":{"Min":0.0,"Max":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"saturation","Exposed":"saturation","Value":{"Float":1.0},"Init":{"Float":0.699999988079071},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"alpha","Exposed":"alpha","Value":{"Float":0.23098959028