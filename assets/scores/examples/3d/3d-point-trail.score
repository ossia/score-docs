ain":{"Float":{"Min":5.0,"Max":120.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":14,"Hidden":true,"Custom":"nearPlane","Exposed":"nearplane","Value":{"Float":0.10100000351667404},"Init":{"Float":0.009999999776482582},"Domain":{"Float":{"Min":0.0010000000474974513,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":15,"Hidden":true,"Custom":"farPlane","Exposed":"farplane","Value":{"Float":1000.0},"Init":{"Float":100.0},"Domain":{"Float":{"Min":1.0,"Max":1000.0}}},{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":1001,"Hidden":false,"Custom":"Camera","Exposed":"camera"}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1000,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":2,"Metadata":{"ScriptingName":"Trail","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-725.314637429256,-262.6611880038887],"Size":[353.0,220.5],"Loops":false,"FoldMode":0,"Compute":"/*{\n\"DESCRIPTION\": \"Generates a particle trail from a single point. Each frame writes one particle into a circular buffer. Old particles fade and shrink.\",\n\"CREDIT\": \"ossia score\",\n\"ISFVSN\": \"2.0\",\n\"MODE\": \"COMPUTE_SHADER\",\n\"CATEGORIES\": [\"Geometry Generator\", \"Particles\"],\n\"RESOURCES\": [\n  {\n    \"NAME\": \"geo\",\n    \"TYPE\": \"geometry\",\n    \"VERTEX_COUNT\": \"6\",\n    \"INSTANCE_COUNT\": \"$maxParticles\",\n    \"ATTRIBUTES\": [\n      { \"NAME\": \"position\",    \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\",  \"ACCESS\": \"read_write\", \"RATE\": \"instance\" },\n      { \"NAME\": \"color\",       \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\",  \"ACCESS\": \"read_write\", \"RATE\": \"instance\" },\n      { \"NAME\": \"sprite_size\", \"SEMANTIC\": \"sprite_size\",     \"TYPE\": \"float\", \"ACCESS\": \"read_write\", \"RATE\": \"instance\" }\n    ]\n  },\n  { \"NAME\": \"maxParticles\", \"TYPE\": \"long\",  \"DEFAULT\": 100, \"MIN\": 1,   \"MAX\": 2048 },\n  { \"NAME\": \"point3D\",      \"TYPE\": \"point3D\", \"DEFAULT\": [0.0, 0.0, 0.0] },\n  { \"NAME\": \"trailFade\",    \"TYPE\": \"bool\",  \"DEFAULT\": true },\n  { \"NAME\": \"baseColor\",    \"TYPE\": \"color\", \"DEFAULT\": [0.2, 0.8, 1.0, 1.0] },\n  { \"NAME\": \"tailColor\",    \"TYPE\": \"color\", \"DEFAULT\": [0.0, 0.1, 0.3, 0.0] },\n  { \"NAME\": \"startSize\",    \"TYPE\": \"float\", \"DEFAULT\": 1.0, \"MIN\": 0.0, \"MAX\": 10.0 },\n  { \"NAME\": \"endSize\",      \"TYPE\": \"float\", \"DEFAULT\": 0.0, \"MIN\": 0.0, \"MAX\": 10.0 }\n],\n\"PASSES\": [\n  { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_INSTANCE\" } }\n]\n}*/\n\nvoid main()\n{\n    uint idx  = gl_GlobalInvocationID.x;\n    uint uMax = uint(maxParticles);\n\n    if (idx >= uMax)\n        return;\n\n    // Current write slot in the circular buffer\n    uint head = uint(FRAMEINDEX  ) % uMax;\n\n    // Phase 1: The thread that matches the head writes the new position\n    if (idx == head)\n    {\n        ISF_WRITE(geo, position)[idx] = vec4(point3D, 1.0);\n    }\n    else\n    {\n      //  return;\n    }\n\n    // Phase 2: All threads update their color and size based on age\n    // Age 0 = just written (head), age increases going backwards in the ring\n    uint age = (head + uMax - idx) % uMax;\n\n    // Before the buffer is full, hide unused slots\n    uint aliveCount = uMax;//min(uint(TIME) + 1u, uMax);\n    if (age >= aliveCount)\n    {\n        ISF_WRITE(geo, color)[idx]       = vec4(0.0);\n      //  ISF_WRITE(geo, sprite_size)[idx] = 0.0;\n        return;\n    }\n\n    float normalizedAge = float(age) / float(max(aliveCount - 1u, 1u));\n\n    vec4  finalColor = baseColor;\n    float finalSize  = startSize;\n\n    if (trailFade)\n    {\n        finalColor = mix(baseColor, tailColor, normalizedAge);\n        finalSize  = mix(startSize, endSize,   normalizedAge);\n    }\n\n    ISF_WRITE(geo, color)[idx]       = finalColor;\n    ISF_WRITE(geo, sprite_size)[idx] = finalSize;\n}","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geo","Exposed":"geo"},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"maxParticles","Exposed":"maxparticles","Value":{"Int":2048},"Init":{"Int":100},"Domain":{"Int":{"Min":1,"Max":2048}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"point3D","Exposed":"point3d","Value":{"Vec3f":[0.0,0.0,0.0]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[-1.0,-1.0,-1.0],"Max":[1.0,1.0,1.0],"Values":[[],[],[]]}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"trailFade","Exposed":"trailfade","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"baseColor","Exposed":"basecolor","Value":{"Vec4f":[1.0,0.5174639225006104,0.05693140998482704,1.0]},"Init":{"Vec4f":[0.20000000298023224,0.800000011920929,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"tailColor","Exposed":"tailcolor","Value":{"Vec4f":[0.9440146684646606,0.11511406302452087,0.8044861555099487,1.0]},"Init":{"Vec4f":[0.0,0.10000000149011612,0.30000001192092896,0.0]},"Domain":{}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"startSize","Exposed":"startsize","Value":{"Float":2.3564326763153076},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"endSize","Exposed":"endsize","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":10.0}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geo_out","Exposed":"geo_out"}]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":37,"Metadata":{"ScriptingName":"Text Box","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-727.5557576715901,-404.4348775511073],"Size":[437.0,113.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">This example shows how to generate a simple trail of points on the GPU, <br />to create dynamic live meshes. <br />Points append themselves on a buffer handled by the Trail<br />compute shader on each step.<br />Replace the input of point3D by an accelerometer or orientation <br />meter, for instance through the Sensors2OSC Android app, <br />or the upcoming puara-server.</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]}],"SmallViewRack":[{"Pr