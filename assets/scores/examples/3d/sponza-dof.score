tName":"Outlet","id":0,"Hidden":false,"Custom":"Pair","Exposed":"pair"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":24,"Metadata":{"ScriptingName":"Micromap.25","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[493.3976772511662,1685.3694258181083],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"10x"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"b5da735b-a76d-4314-8853-3e8a96486fb9","ObjectName":"Gradient","id":27,"Metadata":{"ScriptingName":"Smooth pride","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[585.086204943181,1543.9736009307446],"Size":[200.0,100.0],"Loops":true,"FoldMode":2,"Outlet":{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Value Out","Exposed":"value out","Address":":/@[color.rgba]"},"Gradient":[[0.0,[65535,0,6168,65535]],[0.2,[65535,42405,11308,65535]],[0.4,[65535,65535,16705,65535]],[0.6,[0,32896,6168,65535]],[0.8,[0,0,63993,65535]],[1.0,[34438,0,32125,65535]]],"Tween":false},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":28,"Metadata":{"ScriptingName":"Text Box","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[384.2631493060549,1615.6961208011464],"Size":[180.0,23.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":