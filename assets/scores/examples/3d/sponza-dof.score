rcColor",{"Int":3}],["DstColor",{"Int":4}],["OneMinusDstColor",{"Int":5}],["SrcAlpha",{"Int":6}],["OneMinusSrcAlpha",{"Int":7}],["DstAlpha",{"Int":8}],["OneMinusDstAlpha",{"Int":9}],["ConstantColor",{"Int":10}],["OneMinusConstantColor",{"Int":11}],["ConstantAlpha",{"Int":12}],["OneMinusConstantAlpha",{"Int":13}],["SrcAlphaSaturate",{"Int":14}]],"FolderPort":"","FileExtensions":""},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"OpAlpha","Exposed":"opalpha","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4]}},"Values":[["Add",{"Int":0}],["Substract",{"Int":1}],["Reverse Substract",{"Int":2}],["Min",{"Int":3}],["Max",{"Int":4}]],"FolderPort":"","FileExtensions":""},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":8,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":9,"Hidden":false,"Custom":"scene_lights","Exposed":"scene_lights","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":10,"Hidden":false,"Custom":"scene_light_indices","Exposed":"scene_light_indices","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":11,"Hidden":false,"Custom":"world_transforms","Exposed":"world_transforms","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":12,"Hidden":false,"Custom":"scene_materials","Exposed":"scene_materials","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":13,"Hidden":false,"Custom":"scene_material_uv_xforms","Exposed":"scene_material_uv_xforms","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":14,"Hidden":false,"Custom":"per_draws","Exposed":"per_draws","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":15,"Hidden":false,"Custom":"indirect_draw_cmds","Exposed":"indirect_draw_cmds","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":16,"Hidden":false,"Custom":"scene_counts","Exposed":"scene_counts","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":17,"Hidden":false,"Custom":"env","Exposed":"env","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":18,"Hidden":true,"Custom":"alpha_a2c_enabled","Exposed":"alpha_a2c_enabled","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":1}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":19,"Hidden":true,"Custom":"volumetric_enabled","Exposed":"volumetric_enabled","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":1}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":20,"Hidden":true,"Custom":"volumetric_intensity","Exposed":"volumetric_intensity","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":4.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1000,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"3c9d6c2b-1f04-4f7d-9bc2-a4b1d7c8e5f0","ObjectName":"extract_buffer_by_name","id":9,"Metadata":{"ScriptingName":"Extract buffer (by name).9","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[1650.4579662474275,1044.5576505190015],"Size":[234.0,110.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Geometry","Exposed":"geometry"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Mode","Exposed":"mode","Value":{"Int":1},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1]}},"Values":[["Attribute",{"Int":0}],["Buffer",{"Int":1}]],"FolderPort":"","FileExtensions":""},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Name / index","Exposed":"name _ index","Value":{"String":"camera"},"Init":{"String":"position"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Pad vec3 to vec4","Exposed":"pad vec3 to vec4","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Buffer","Exposed":"buffer"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":10,"Metadata":{"ScriptingName":"Depth of Field","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[3120.0740344169517,854.2404051604802],"Size":[240.0,145.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia team; scatter-as-gather after D. Gustafsson (2018)\",\n    \"ISFVSN\": \"2\",\n    \"MODE\": \"ISF\",\n    \"DESCRIPTION\": \"Depth-of-field with bokeh-biased sampling. Bright pixels contribute more strongly, letting highlights form the characteristic disc / hexagonal bokeh. `bokehShape` selects the sample pattern. Single-pass scatter-as-gather: every tap is weighted by whether ITS OWN circle of confusion reaches this pixel, so a sharp subject does not bleed into the blurred background and a blurred foreground does spill over a sharp background (D. Gustafsson, 'Bokeh depth of field in a single pass', 2018). The circle of confusion is a stylised ramp: 0 within focusRange of focusDepth, reaching blurAmount pixels one more focusRange away (the physical thin-lens CoC, Potmesil & Chakravarty 1981, grows with |1/focus - 1/z| instead). The blur works on premultiplied colour and alpha, so a blurred silhouette also spreads over a transparent background.\",\n    \"CATEGORIES\": [\"Post-process\", \"Focus\"],\n    \"ALPHA\": \"premultiplied\",\n\n    \"PIPELINE_STATE\": {\n        \"DEPTH_TEST\": true,\n        \"DEPTH_COMPARE\": \"always\",\n        \"DEPTH_WRITE\": true\n    },\n\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\", \"DEPTH\": true, \"LABEL\": \"Scene color + depth\" },\n        { \"NAME\": \"camera\", \"TYPE\": \"uniform\", \"LABEL\": \"Camera matrices\",\n            \"LAYOUT\": [\n                { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n                { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n                { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n                { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n                { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n                { \"NAME\": \"params\",         \"TYPE\": \"vec4\" } ] },\n        { \"NAME\": \"focusDepth\", \"TYPE\": \"float\", \"LABEL\": \"Focus depth (world units)\",\n          \"DEFAULT\": 8.0, \"MIN\": 0.01, \"MAX\": 1000.0 },\n        { \"NAME\": \"focusRange\", \"TYPE\": \"float\", \"LABEL\": \"Focus range (world units)\",\n          \"DEFAULT\": 1.5, \"MIN\": 0.0, \"MAX\": 100.0 },\n        { \"NAME\": \"blurAmount\", \"TYPE\": \"float\", \"LABEL\": \"Max blur radius (pixels)\",\n          \"DEFAULT\": 16.0, \"MIN\": 0.0, \"MAX\": 80.0 },\n        { \"NAME\": \"bokehShape\", \"TYPE\": \"long\", \"LABEL\": \"Bokeh shape\",\n          \"VALUES\": [0, 1, 2], \"LABELS\": [\"Disc\", \"Hexagon\", \"Pentagon\"], \"DEFAULT\": 0 },\n        { \"NAME\": \"highlightBias\", \"TYPE\": \"float\", \"LABEL\": \"Highlight bokeh bias\",\n          \"DEFAULT\": 1.5, \"MIN\": 0.0, \"MAX\": 5.0 }\n    ]\n}*/\n\n#include \"depth_helpers.glsl\"\n\n// Shape the radius by polygon: for angle a and vertex count n, returns the\n// distance from centre to the polygon boundary at that angle.\nfloat polyRadius(float a, float n)\n{\n    if (n < 2.5) return 1.0;  // disc\n    float seg = 6.28318 / n;\n    float half_seg = seg * 0.5;\n    float theta = mod(a, seg) - half_seg;\n    return cos(half_seg) / cos(theta);\n}\n\nvec2 bokehOffset(int i, int total, int shape)\n{\n    float t = (float(i) + 0.5) / float(total);\n    float r = sqrt(t);\n    float a = float(i) * 2.39996323;\n    float vertexCount = (shape == 1) ? 6.0 : (shape == 2 ? 5.0 : 0.0);\n    float shaped = (shape == 0) ? r : r * polyRadius(a, vertexCount);\n    return vec2(cos(a), sin(a)) * shaped;\n}\n\n// Circle-of-confusion radius in pixels for a raw depth sample.\nfloat cocRadius(float rawDepth)\n{\n    float eye = dh_linearizeDepth(rawDepth, camera.projection);\n    float coc = max(abs(eye - focusDepth) - focusRange, 0.0);\n    return clamp(coc / max(focusRange, 0.001), 0.0, 1.0) * blurAmount;\n}\n\nvoid main()\n{\n    vec2  uv    = isf_FragNormCoord;\n    vec4  color = IMG_NORM_PIXEL_PREMULTIPLIED(inputImage, uv);\n    float rawD  = IMG_DEPTH_NORM_PIXEL(inputImage, uv);\n    float eye   = dh_linearizeDepth(rawD, camera.projection);\n    float radius = cocRadius(rawD);\n\n    // Gather over the MAXIMUM radius, not this pixel's own: a sharp pixel\n    // must still collect a blurred foreground that overlaps it.\n    const int N = 48;\n    vec2 texel = 1.0 / RENDERSIZE;\n    vec4  acc  = color;\n    float wsum = 1.0;\n    for (int i = 0; i < N; ++i) {\n        vec2  o  = bokehOffset(i, N, bokehShape);   // unit-disc / polygon\n        float r  = length(o) * blurAmount;           // tap distance (px)\n        vec2  sUV = uv + o * blurAmount * texel;\n        float sRaw = IMG_DEPTH_NORM_PIXEL(inputImage, sUV);\n        vec4  s    = IMG_NORM_PIXEL_PREMULTIPLIED(inputImage, sUV);\n        float sEye = dh_linearizeDepth(sRaw, camera.projection);\n        float sCoc = cocRadius(sRaw);\n        // A tap BEHIND this pixel cannot blur over it by more than this\n        // pixel's own blur (Gustafsson's clamp): keeps a sharp subject from\n        // leaking into the background around it.\n        if (sEye > eye) sCoc = min(sCoc, radius);\n        // Does the tap's own disc reach this pixel?\n        float m = smoothstep(r - 1.0, r + 1.0, sCoc);\n        // Highlight bias: brighter samples count more, shaping bokeh.\n        float w = m * (1.0 + pow(dh_luma(s.rgb), 2.0) * highlightBias);\n        acc  += s * w;\n        wsum += w;\n    }\n\n    isf_FragColor = acc / wsum;\n    gl_FragDepth = rawD;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/depth/Depth Bokeh DoF.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"focusDepth","Exposed":"focusdepth","Value":{"Float":1000.0},"Init":{"Float":8.0},"Domain":{"Float":{"Min":0.009999999776482582,"Max":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"focusRange","Exposed":"focusrange","Value":{"Float":4.579586505889893},"Init":{"Float":1.5},"Domain":{"Float":{"Min":0.0,"Max":100.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"blurAmount","Exposed":"bluramount","Value":{"Float":9.359999656677246},"Init":{"Float":16.0},"Domain":{"Float":{"Min":0.0,"Max":80.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"bokehShape","Exposed":"bokehshape","Value":{"Int":1},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Disc",{"Int":0}],["Hexagon",{"Int":1}],["Pentagon",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"highlightBias","Exposed":"highlightbias","Value":{"Float":4.418333530426025},"Init":{"Float":1.5},"Domain":{"Float":{"Min":0.0,"Max":5.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"0b1b1816-c33e-4796-a16d-5aab27fe600f","ObjectName":"LFO","id":11,"Metadata":{"ScriptingName":"LFO","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[2510.380375461142,1033.4964080381246],"Size":[261.0,117.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Period","Exposed":"period","Value":{"Vec2f":[8.61225700378418,0.0]},"Init":{"Vec2f":[0.5,1.0]},"Domain":{"Vec2f":{"Min":[0.009999999776482582,0.0],"Max":[60.0,1.0],"Values":[[],[]]}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Shape","Exposed":"shape","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Retrigger","Exposed":"retrigger","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Ampl.","Exposed":"ampl.","Value":{"Float":0.9959337711334229},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Offset","Exposed":"offset","Value":{"Float":1.0},"Init":{"Float":0.5},"Domain":{"Float":{"Min":-1.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Jitter","Exposed":"jitter","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":180.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Phase","Exposed":"phase","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":360.0}}},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Waveform","Exposed":"waveform","Value":{"String":"Sin"},"Init":{"String":"Sin"},"Domain":{"String":{"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"]}},"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"],"Pixmaps":[":/icons/wave_sin_off.png",":/icons/wave_sin_on.png",":/icons/wave_triangle_off.png",":/icons/wave_triangle_on.png",":/icons/wave_saw_off.png",":/icons/wave_saw_on.png",":/icons/wave_ramp_down_off.png",":/icons/wave_ramp_down_on.png",":/icons/wave_square_ticks_off.png",":/icons/wave_square_ticks_on.png",":/icons/wave_square_changes_off.png",":/icons/wave_square_changes_on.png",":/icons/wave_sample_and_hold_ticks_off.png",":/icons/wave_sample_and_hold_ticks_on.png",":/icons/wave_sample_and_hold_changes_off.png",":/icons/wave_sample_and_hold_changes_on.png",":/icons/wave_noise1_off.png",":/icons/wave_noise1_on.png",":/icons/wave_noise2_off.png",":/icons/wave_noise2_on.png",":/icons/wave_noise3_off.png",":/icons/wave_noise3_on.png",":/icons/wave_drift_off.png",":/icons/wave_drift_on.png"]},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Lock to bars","Exposed":"lock to bars","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":12,"Metadata":{"ScriptingName":"Micromap","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[2904.355768034422,1035.5456228915646],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"10x"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":13,"Metadata":{"ScriptingName":"Depth Micro AO","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[2927.1163581658047,855.410602430639],"Size":[166.0,145.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia team\",\n    \"ISFVSN\": \"2\",\n    \"MODE\": \"ISF\",\n    \"DESCRIPTION\": \"Fast single-pass ambient occlusion. Samples eight neighbours at a user radius, counts how many rise more than `bias` above the tangent plane of the current pixel (normal-oriented hemisphere, with a range check), and darkens proportionally. Not as clean as GTAO (see the Multi-pass wave) but cheap, punchy, and single-pass.\",\n    \"CATEGORIES\": [\"Post-process\", \"Lighting\"],\n\n    \"PIPELINE_STATE\": {\n        \"DEPTH_TEST\": true,\n        \"DEPTH_COMPARE\": \"always\",\n        \"DEPTH_WRITE\": true\n    },\n\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\", \"DEPTH\": true, \"LABEL\": \"Scene color + depth\" },\n        { \"NAME\": \"camera\", \"TYPE\": \"uniform\", \"LABEL\": \"Camera matrices\",\n            \"LAYOUT\": [\n                { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n                { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n                { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n                { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n                { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n                { \"NAME\": \"params\",         \"TYPE\": \"vec4\" } ] },\n        { \"NAME\": \"radius\", \"TYPE\": \"float\", \"LABEL\": \"AO radius (pixels)\",\n          \"DEFAULT\": 8.0, \"MIN\": 1.0, \"MAX\": 40.0 },\n        { \"NAME\": \"bias\", \"TYPE\": \"float\", \"LABEL\": \"Height above the tangent plane (world units)\",\n          \"DEFAULT\": 0.01, \"MIN\": 0.0, \"MAX\": 5.0 },\n        { \"NAME\": \"intensity\", \"TYPE\": \"float\", \"LABEL\": \"Occlusion strength\",\n          \"DEFAULT\": 1.2, \"MIN\": 0.0, \"MAX\": 4.0 }\n    ]\n}*/\n\n#include \"depth_helpers.glsl\"\n\nvoid main()\n{\n    vec2  uv    = isf_FragNormCoord;\n    vec4  color = IMG_NORM_PIXEL(inputImage, uv);\n    float rawD  = IMG_DEPTH_NORM_PIXEL(inputImage, uv);\n\n    if (dh_isSky(rawD)) {\n        isf_FragColor = color; gl_FragDepth = rawD; return;\n    }\n\n    float eye0 = dh_linearizeDepth(rawD, camera.projection);\n    vec2 texel = 1.0 / RENDERSIZE;\n    mat4 invP = inverse(camera.projection);\n    vec3 P0 = dh_viewPosFromDepth(uv, rawD, invP);\n\n    // Tangent plane at this pixel. Counting \"nearer\" samples in a flat 2D\n    // disc (the first Crytek SSAO) makes every slanted plane occlude itself:\n    // a floor seen at an angle has its lower taps nearer than the centre, so\n    // the whole floor went grey. A sample only occludes if it rises above\n    // the tangent plane by more than `bias` -- the normal-oriented hemisphere\n    // test of later SSAO (e.g. McGuire et al., \"The Alchemy screen-space\n    // ambient obscurance algorithm\", HPG 2011).\n    vec3 N = dh_reconstructViewNormalImproved(uv, texel, rawD,\n        IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2( texel.x, 0.0)),\n        IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(-texel.x, 0.0)),\n        IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(0.0,  texel.y)),\n        IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(0.0, -texel.y)),\n        camera.projection);\n\n    // The sampling radius in world units at this depth: `radius` pixels\n    // times the size of one pixel at eye0 (2 * eye * tan(fov/2) / height,\n    // and projection[1][1] = 1 / tan(fov/2)).\n    float radiusWorld = radius * 2.0 * eye0 / (camera.projection[1][1] * RENDERSIZE.y);\n    float occ = 0.0;\n    const int NS = 8;\n    // Jittered sample angles per fragment so the 8 taps don't line up in\n    // screen space.\n    float rot = dh_ign(isf_FragCoord.xy) * DH_TWO_PI;\n    for (int i = 0; i < NS; ++i) {\n        float a = rot + DH_TWO_PI * float(i) / float(NS);\n        vec2 sUV = uv + vec2(cos(a), sin(a)) * radius * texel;\n        float dS = IMG_DEPTH_NORM_PIXEL(inputImage, sUV);\n        if (dS < DH_EPSILON) continue;  // skip sky\n        vec3 v = dh_viewPosFromDepth(sUV, dS, invP) - P0;\n        float dist = length(v);\n        // Range check (J. Chapman, \"SSAO tutorial\", 2013; LearnOpenGL\n        // \"SSAO\"): an occluder much farther away than the sampling radius\n        // is a different object in front, not something that occludes this\n        // point. Without it every pixel next to a silhouette got a halo.\n        if (dot(v, N) > bias) occ += smoothstep(0.0, 1.0, 2.0 * radiusWorld / max(dist, DH_EPSILON));\n    }\n    float ao = 1.0 - (occ / float(NS)) * intensity;\n    ao = clamp(ao, 0.0, 1.0);\n\n    isf_FragColor = vec4(color.rgb * ao, color.a);\n    gl_FragDepth = rawD;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/depth/Depth Micro AO.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"radius","Exposed":"radius","Value":{"Float":2.335505962371826},"Init":{"Float":8.0},"Domain":{"Float":{"Min":1.0,"Max":40.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"bias","Exposed":"bias","Value":{"Float":0.08583475649356842},"Init":{"Float":0.009999999776482582},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"intensity","Exposed":"intensity","Value":{"Float":4.0},"Init":{"Float":1.2000000476837158},"Domain":{"Float":{"Min":0.0,"Max":4.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"0b1b1816-c33e-4796-a16d-5aab27fe600f","ObjectName":"LFO","id":14,"Metadata":{"ScriptingName":"LFO.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[587.4048083325466,515.1295309539951],"Size":[261.0,117.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectNa