lor":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[34.98562883323859,-728.1284640898318],"Size":[352.0,176.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Ambient Color","Exposed":"ambient color","Value":{"Vec3f":[0.029999999329447746,0.029999999329447746,0.029999999329447746]},"Init":{"Vec3f":[0.029999999329447746,0.029999999329447746,0.029999999329447746]},"Domain":{"Vec3f":{"Min":[0.0,0.0,0.0],"Max":[1.0,1.0,1.0],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Ambient Intensity","Exposed":"ambient intensity","Value":{"Float":4.043548583984375},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":8.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Exposure EV100","Exposed":"exposure ev100","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-6.0,"Max":18.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Exposure (stops)","Exposed":"exposure (stops)","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-8.0,"Max":8.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Gamma","Exposed":"gamma","Value":{"Float":2.200000047683716},"Init":{"Float":2.200000047683716},"Domain":{"Float":{"Min":1.0,"Max":3.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Fog","Exposed":"fog","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Fog Color","Exposed":"fog color","Value":{"Vec3f":[0.800000011920929,0.800000011920929,0.800000011920929]},"Init":{"Vec3f":[0.800000011920929,0.800000011920929,0.800000011920929]},"Domain":{"Vec3f":{"Min":[0.0,0.0,0.0],"Max":[1.0,1.0,1.0],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Fog Start","Exposed":"fog start","Value":{"Float":10.0},"Init":{"Float":10.0},"Domain":{"Float":{"Min":0.0,"Max":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Fog End","Exposed":"fog end","Value":{"Float":100.0},"Init":{"Float":100.0},"Domain":{"Float":{"Min":0.0,"Max":10000.0}}},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"Render target size","Exposed":"render target size","Value":{"Vec2f":[0.0,0.0]},"Init":{"Vec2f":[0.0,0.0]},"Domain":{"Vec2f":{"Min":[0.0,0.0],"Max":[16384.0,16384.0],"Values":[[],[]]}},"Integral":true}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Scene","Exposed":"scene"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":19,"Metadata":{"ScriptingName":"OrbitParticles.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-324.21649045056995,10.634455642642365],"Size":[226.0,175.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Simple orbital particle emitter — every slot is always alive and traces a deterministic orbit on a sphere whose radius breathes with TIME. No dead/alive bookkeeping, no auxiliary buffers. Drop-in source for Instancer.points: position drives per-instance translation, color drives per-instance color0.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"PARTICLES\"],\n  \"RESOURCES\": [\n    { \"NAME\": \"radius\",      \"TYPE\": \"float\", \"DEFAULT\": 1.0,  \"MIN\": 0.01, \"MAX\": 10.0 },\n    { \"NAME\": \"breathDepth\", \"TYPE\": \"float\", \"DEFAULT\": 0.3,  \"MIN\": 0.0,  \"MAX\": 1.0 },\n    { \"NAME\": \"breathSpeed\", \"TYPE\": \"float\", \"DEFAULT\": 1.0,  \"MIN\": 0.0,  \"MAX\": 10.0 },\n    { \"NAME\": \"orbitSpeed\",  \"TYPE\": \"float\", \"DEFAULT\": 0.5,  \"MIN\": 0.0,  \"MAX\": 5.0 },\n    { \"NAME\": \"spread\",      \"TYPE\": \"float\", \"DEFAULT\": 1.0,  \"MIN\": 0.0,  \"MAX\": 1.0 },\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"VERTEX_COUNT\": \"$USER\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\" },\n        { \"NAME\": \"color\",    \"SEMANTIC\": \"color0\",   \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\" }\n      ]\n    }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\n// PCG-flavoured 32-bit hash → [0,1). Deterministic per-particle so\n// the orbit parameters stay stable across frames; only TIME advances.\nfloat hash11(uint n)\n{\n  n = (n << 13u) ^ n;\n  n = n * (n * n * 15731u + 789221u) + 1376312589u;\n  return float(n & 0x7fffffffu) / float(0x7fffffff);\n}\n\nconst float TWO_PI = 6.28318530718;\nconst float PI     = 3.14159265359;\n\nvoid main()\n{\n  uint idx = gl_GlobalInvocationID.x;\n  uint count = uint(ISF_WRITE(geo, position).length());\n  if(idx >= count)\n    return;\n\n  // Five independent hashes per particle index. Each samples a\n  // different orbit parameter so neighbouring slots don't trace\n  // visually correlated paths.\n  float h0 = hash11(idx * 17u + 0u);   // azimuth phase at TIME=0\n  float h1 = hash11(idx * 17u + 1u);   // polar angle (clustered by `spread`)\n  float h2 = hash11(idx * 17u + 2u);   // angular velocity sign + magnitude\n  float h3 = hash11(idx * 17u + 3u);   // breath phase offset\n  float h4 = hash11(idx * 17u + 4u);   // hue offset\n\n  // Angular velocity: signed, scaled by orbitSpeed. Half the particles\n  // orbit clockwise and half counter-clockwise, which prevents the\n  // cloud from drifting in any one direction.\n  float omega = (h2 - 0.5) * 2.0 * orbitSpeed;\n\n  // Polar angle: `spread` controls how clustered around the equator\n  // the orbits are. spread=0 puts every particle on a single equatorial\n  // ring; spread=1 distributes them uniformly over the sphere.\n  float phi = acos(mix(0.0, 2.0 * h1 - 1.0, spread));\n\n  // Azimuth: deterministic phase plus TIME-driven sweep.\n  float theta = h0 * TWO_PI + omega * TIME;\n\n  // Radial breath. Each particle has its own phase offset h3 so the\n  // sphere doesn't pulse rigidly as a whole — particles flow in and\n  // out at different times, producing a swirling layered effect.\n  float radial = radius * (1.0 + breathDepth * sin(breathSpeed * TIME + h3 * TWO_PI));\n\n  vec3 pos = radial * vec3(\n      sin(phi) * cos(theta),\n      sin(phi) * sin(theta),\n      cos(phi));\n\n  ISF_WRITE(geo, position)[idx] = vec4(pos, 1.0);\n\n  // Color: HSV-ish hue from polar angle + per-particle offset.\n  // Cosine-palette gives a smooth continuous spectrum without abrupt\n  // colour cuts.\n  float hue = fract(phi / PI + h4);\n  vec3 col = 0.5 + 0.5 * cos(TWO_PI * (hue + vec3(0.0, 0.33, 0.67)));\n  ISF_WRITE(geo, color)[idx] = vec4(col, 1.0);\n}\n","Root":"<LIBRARY>:packages/csf-examples/csf-last/OrbitParticles.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"radius","Exposed":"radius","Value":{"Float":10.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.009999999776482582,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"breathDepth","Exposed":"breathdepth","Value":{"Float":0.0},"Init":{"Float":0.30000001192092896},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"breathSpeed","Exposed":"breathspeed","Value":{"Float":0.7436676621437073},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"orbitSpeed","Exposed":"orbitspeed","Value":{"Float":0.03850048780441284},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"spread","Exposed":"spread","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"geo vertex count","Exposed":"geo vertex count","Value":{"Int":30000},"Init":{"Int":1024},"Domain":{"Int":{"Min":1,"Max":536870911}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geo_out","Exposed":"geo_out"}]},{"uuid":"5e8a2c7f-9b4d-4e3a-a1c6-2d7f0b3e8c4a","ObjectName":"instancer","id":5,"Metadata":{"ScriptingName":"Instancer","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-9.401361058341998,-205.22968945865296],"Size":[418.0,175.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Scene In","Exposed":"scene in"},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"Transforms","Exposed":"transforms","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":2,"Hidden":false,"Custom":"Colors","Exposed":"colors","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":3,"Hidden":false,"Custom":"Custom","Exposed":"custom","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"f2ab2