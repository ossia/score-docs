-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":14,"Metadata":{"ScriptingName":"Micromap","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-758.741413263808,-135.67840439679816],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"360x"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"dbfc2101-40d7-4807-8804-571e88992e7e","ObjectName":"gfxProcess","id":15,"Metadata":{"ScriptingName":"wireframe","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[88.03158509594047,625.731800741681],"Size":[574.0,160.0],"Loops":false,"FoldMode":0,"Vertex":"// Companion vertex stage for wireframe.frag. MDI vertex — picks the\n// per-draw model matrix from per_draws[draw_id], applies it, transforms\n// to clip space. No varyings — the fragment stage just outputs a flat\n// color, no interpolated data needed.\n//\n// Vertex INPUTS / position / inst_translation / draw_id are declared by\n// the ISF parser from the sibling .frag's VERTEX_INPUTS block —\n// redeclaring `position` here would trigger a redefinition compile error\n// (which is what was breaking the previous version of this preset).\n\nvoid main()\n{\n    isf_vertShaderInit();\n\n    uint drawId = draw_id;\n    PerDraw pd  = per_draws.data[drawId];\n    mat3 instLinear = pd.normal[3].x > 0.5\n        ? mat3(inst_matrix0.xyz, inst_matrix1.xyz, inst_matrix2.xyz)\n        : mat3(1.0);\n    mat4 model  = pd.model;\n    vec4 wp     = model * vec4(instLinear * position + inst_translation, 1.0);\n    gl_Position = clipSpaceCorrMatrix * camera.viewProjection * wp;\n\n    isf_vertShaderFinish();\n}\n","Fragment":"/*{\n  \"CREDIT\": \"ossia team\",\n  \"ISFVSN\": \"2\",\n  \"MODE\": \"RAW_RASTER_PIPELINE\",\n  \"ALPHA\": \"straight\",\n  \"DESCRIPTION\": \"Wireframe overlay over a flattened scene. MDI variant — one drawIndexedIndirect for the whole scene, vertex picks model matrix from per_draws[draw_id]. Fragment outputs a flat color per fragment; pipeline state forces line rasterization (POLYGON_MODE: line) and disables back-face culling so both edges of a triangle are visible. DEPTH_WRITE: false keeps it composable as an overlay over a solid pass; clear DEPTH_WRITE to true for a standalone wireframe pass.\",\n  \"CATEGORIES\": [\"3D\", \"Scene\", \"Debug\"],\n\n  \"VERTEX_INPUTS\": [\n    { \"TYPE\": \"vec3\", \"NAME\": \"position\" },\n    { \"TYPE\": \"vec3\", \"NAME\": \"inst_translation\",\n      \"SEMANTIC\": \"translation\", \"REQUIRED\": false },\n    {\n      \"TYPE\": \"vec4\",\n      \"NAME\": \"inst_matrix0\",\n      \"REQUIRED\": false\n    },\n    {\n      \"TYPE\": \"vec4\",\n      \"NAME\": \"inst_matrix1\",\n      \"REQUIRED\": false\n    },\n    {\n      \"TYPE\": \"vec4\",\n      \"NAME\": \"inst_matrix2\",\n      \"REQUIRED\": false\n    },\n    { \"TYPE\": \"uint\", \"NAME\": \"draw_id\",\n      \"SEMANTIC\": \"instance_draw_id\" }\n  ],\n  \"FRAGMENT_OUTPUTS\": [\n    { \"TYPE\": \"vec4\", \"NAME\": \"isf_FragColor\" }\n  ],\n\n  \"INPUTS\": [\n    { \"NAME\": \"camera\", \"TYPE\": \"uniform\", \"VISIBILITY\": \"vertex\",\n      \"LAYOUT\": [\n        { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n        { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n        { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n        { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n        { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n        { \"NAME\": \"params\",         \"TYPE\": \"vec4\" }\n      ]\n    },\n    { \"NAME\": \"per_draws\", \"TYPE\": \"storage\", \"ACCESS\": \"read_only\",\n      \"VISIBILITY\": \"vertex\",\n      \"LAYOUT\": [ { \"NAME\": \"data\", \"TYPE\": \"PerDraw[]\" } ]\n    },\n    { \"NAME\": \"indirect_draw_cmds\", \"TYPE\": \"storage\", \"ACCESS\": \"read_only\",\n      \"VISIBILITY\": \"none\",\n      \"BUFFER_USAGE\": \"indirect_draw_indexed\",\n      \"LAYOUT\": [ { \"NAME\": \"cmds\", \"TYPE\": \"DrawIndexedCmd[]\" } ]\n    },\n    { \"NAME\": \"color\", \"TYPE\": \"color\", \"DEFAULT\": [1.0, 1.0, 1.0, 1.0],\n      \"LABEL\": \"Wire color\" }\n  ],\n\n  \"TYPES\": [\n    { \"NAME\": \"PerDraw\", \"LAYOUT\": [\n        { \"NAME\": \"model\",           \"TYPE\": \"mat4\" },\n        { \"NAME\": \"normal\",          \"TYPE\": \"mat4\" },\n        { \"NAME\": \"material_index\",  \"TYPE\": \"uint\" },\n        { \"NAME\": \"tag_hash\",        \"TYPE\": \"uint\" },\n        { \"NAME\": \"transform_slot\",  \"TYPE\": \"uint\" },\n        { \"NAME\": \"skeleton_offset\", \"TYPE\": \"uint\" }\n    ] },\n    { \"NAME\": \"DrawIndexedCmd\", \"LAYOUT\": [\n        { \"NAME\": \"indexCount\",   \"TYPE\": \"uint\" },\n        { \"NAME\": \"instanceCount\",\"TYPE\": \"uint\" },\n        { \"NAME\": \"firstIndex\",   \"TYPE\": \"uint\" },\n        { \"NAME\": \"baseVertex\",   \"TYPE\": \"int\"  },\n        { \"NAME\": \"baseInstance\", \"TYPE\": \"uint\" }\n    ] }\n  ],\n\n  \"PIPELINE_STATE\": {\n    \"DEPTH_TEST\":   true,\n    \"DEPTH_WRITE\":  false,\n    \"CULL_MODE\":    \"none\",\n    \"POLYGON_MODE\": \"line\",\n    \"LINE_WIDTH\":   1.0\n  }\n}*/\n\nvoid main()\n{\n    isf_FragColor = color;\n}\n","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":1000,"Hidden":false,"Custom":"Geometry In","Exposed":"geometry in"},{"uu