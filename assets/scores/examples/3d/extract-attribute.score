ame":"Outlet","id":0,"Hidden":false,"Custom":"Buffer","Exposed":"buffer"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":21,"Metadata":{"ScriptingName":"Color Test Grid","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-333.4682677139377,429.91199253226034],"Size":[157.0,140.0],"Loops":false,"FoldMode":2,"Vertex":"","Fragment":"/*{\n    \"CATEGORIES\": [\n        \"Color\",\n        \"Utility\"\n    ],\n    \"CREDIT\": \"VIDVOX\",\n    \"DESCRIPTION\": \"\",\n    \"INPUTS\": [\n        {\n            \"DEFAULT\": 16,\n            \"LABEL\": \"Grid Columns\",\n            \"MAX\": 32,\n            \"MIN\": 1,\n            \"NAME\": \"gridCols\",\n            \"TYPE\": \"float\"\n        },\n        {\n            \"DEFAULT\": 9,\n            \"LABEL\": \"Grid Rows\",\n            \"MAX\": 32,\n            \"MIN\": 1,\n            \"NAME\": \"gridRows\",\n            \"TYPE\": \"float\"\n        },\n        {\n            \"DEFAULT\": 0,\n            \"LABEL\": \"Color Shift\",\n            \"MAX\": 1,\n            \"MIN\": 0,\n            \"NAME\": \"colorShift\",\n            \"TYPE\": \"float\"\n        },\n        {\n            \"DEFAULT\": 1,\n            \"LABEL\": \"Color Range\",\n            \"MAX\": 1,\n            \"MIN\": 0,\n            \"NAME\": \"colorRange\",\n            \"TYPE\": \"float\"\n        }\n    ],\n    \"ISFVSN\": \"2\"\n}\n*/\n\n\n\n\nvec3 rgb2hsv(vec3 c)\t{\n\tvec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);\n\t//vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));\n\t//vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));\n\tvec4 p = c.g < c.b ? vec4(c.bg, K.wz) : vec4(c.gb, K.xy);\n\tvec4 q = c.r < p.x ? vec4(p.xyw, c.r) : vec4(c.r, p.yzx);\n\t\n\tfloat d = q.x - min(q.w, q.y);\n\tfloat e = 1.0e-10;\n\treturn vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\n}\n\nvec3 hsv2rgb(vec3 c)\t{\n\tvec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n\tvec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n\treturn c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\n\n\n\nvoid main()\t{\t\n\tvec4\t\toutputPixelColor = vec4(1.0);\n\tvec2\t\tloc = isf_FragNormCoord.xy;\n\tvec2\t\tgridLoc = loc * vec2(gridCols, gridRows);\n\t\t\n\t//\tfigure out which grid square we are in, normalized, and use it for the hue\n\toutputPixelColor.r = (floor(gridLoc.x) + gridCols * floor(mod(gridLoc.y, gridRows))) / (gridCols * gridRows - 1.0);\n\t\n\t//\tscale to the hue range\n\toutputPixelColor.r = outputPixelColor.r * colorRange;\n\t\n\t//\tapply the hue shift\n\toutputPixelColor.r = mod(outputPixelColor.r + colorShift, 1.0);\n\t\n\t//\tfinally convert to RGB\n\toutputPixelColor.rgb = hsv2rgb(outputPixelColor.rgb);\n\t\n\tgl_FragColor = outputPixelColor;\n}\n","Root":"<LIBRARY>:packages/default/Presets/GLSL_shaders/basic/generator/Color Test Grid.fs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"gridCols","Exposed":"gridcols","Value":{"Float":12.933292388916016},"Init":{"Float":16.0},"Domain":{"Float":{"Min":1.0,"Max":32.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"gridRows","Exposed":"gridrows","Value":{"Float":8.092413902282715},"Init":{"Float":9.0},"Domain":{"Float":{"Min":1.0,"Max":32.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"colorShift","Exposed":"colorshift","Value":{"Float":0.8143776655197144},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"colorRange","Exposed":"colorrange","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":22,"Metadata":{"ScriptingName":"Text Box.23","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-360.2649999999999,-81.27390734375001],"Size":[303.0,23.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Here, we extract the position buffer of the goblet.</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":23,"Metadata":{"ScriptingName":"Text Box.24","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-609.0346512609326,244.71740873728623],"Size":[423.0,143.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Then, we take a random texture and turn it into a buffer: <br />each rgba quadruplet (one byte per component, so 4 byte for <br />a color) will map to a point when Model Display is in &quot;Color&quot; mode<br />(what you usually want for a point cloud).<br />Some math is needed when computing the exture size: <br />we have 3000 vertices so we want at least 3000 points: <br />it could be a 300x10 texture but the aspect will be very wide; <br />a 55*55 texture gives 3025 points and is closer to a square aspect ratio<br />for the purpose of rendering the shader.</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"f1a3d6c8-2b4e-4c5d-8a9f-1e2d3c4b5a60","ObjectName":"buffer_info","id":15,"Metadata":{"ScriptingName":"Buffer Info","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[52.53173228606232,428.91199253226034],"Size":[117.0,100.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Buffer","Exposed":"buffer","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Byte size","Exposed":"byte size"},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Byte offset","Exposed":"byte offset"},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":2,"Hidden":false,"Custom":"Handle","Exposed":"handle"},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":3,"Hidden":false,"Custom":"Changed","Exposed":"changed"},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":4,"Hidden":false,"Custom":"Readable","Exposed":"readable"}]},{"uuid":"3f4a41f2-fa39-420f-ab0f-0af6b8409edb","ObjectName":"Display","id":16,"Metadata":{"ScriptingName":"Value display.16","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[209.53173228606232,428.91199253226034],"Size":[200.0,20.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Input","Exposed":"input","Description":"Values to display, including every event in a tick."},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Log","Exposed":"log","Description":"Number of recent values to retain, newest first.","Value":{"Int":1},"Init":{"Int":1},"Domain":{"Int":{"Min":1,"Max":100}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Format","Exposed":"format","Description":"Ordinary text, indented Pretty text, or Hex bytes. Hex shows raw string bytes, including UTF-8 bytes, NUL and high-bit bytes. Numbers must be exact integers from 0 to 255; booleans are 00 or 01. Flat numeric lists and vectors use one byte per element. Empty strings and lists show [empty]. Other values show [n