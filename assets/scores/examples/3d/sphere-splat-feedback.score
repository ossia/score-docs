Float":0.6914843916893005},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":12,"Hidden":true,"Custom":"cameraPos","Exposed":"camerapos","Value":{"Vec3f":[2.4375,-2.0,-2.0]},"Init":{"Vec3f":[2.0,2.0,2.0]},"Domain":{"Vec3f":{"Min":[-2.0,-2.0,-2.0],"Max":[4.0,4.0,4.0],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":13,"Hidden":true,"Custom":"fov","Exposed":"fov","Value":{"Float":120.0},"Init":{"Float":45.0},"Domain":{"Float":{"Min":5.0,"Max":120.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":14,"Hidden":true,"Custom":"nearPlane","Exposed":"nearplane","Value":{"Float":0.0010000000474974513},"Init":{"Float":0.009999999776482582},"Domain":{"Float":{"Min":0.0010000000474974513,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":15,"Hidden":true,"Custom":"farPlane","Exposed":"farplane","Value":{"Float":662.7464599609375},"Init":{"Float":100.0},"Domain":{"Float":{"Min":1.0,"Max":1000.0}}},{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":1001,"Hidden":false,"Custom":"Camera","Exposed":"camera"}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1000,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":4,"Metadata":{"ScriptingName":"01_SphereSplat_Generator","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-864.86,-244.38599999999997],"Size":[236.0,102.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"SPHERESPLAT TEST GENERATOR — creates N particles arranged in a ring, each with position, color, and sprite_size. Connect output directly to SphereSplat to verify the renderer works with generated geometry. All attributes are per-instance: SphereSplat expects 6 vertices per particle (computed via gl_VertexIndex%6) with position/color/sprite_size varying per-instance.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Test\", \"Feedback\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"TOPOLOGY\": \"triangles\",\n      \"VERTEX_COUNT\": 6,\n      \"INSTANCE_COUNT\": \"$numParticles\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\",    \"SEMANTIC\": \"position\",    \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"instance\" },\n        { \"NAME\": \"color\",       \"SEMANTIC\": \"color\",       \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"instance\" },\n        { \"NAME\": \"sprite_size\", \"SEMANTIC\": \"sprite_size\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"instance\" }\n      ]\n    },\n    { \"NAME\": \"numParticles\", \"TYPE\": \"long\",  \"DEFAULT\": 64,   \"MIN\": 1,    \"MAX\": 10000 },\n    { \"NAME\": \"ringRadius\",   \"TYPE\": \"float\", \"DEFAULT\": 2.0,  \"MIN\": 0.1,  \"MAX\": 10.0  },\n    { \"NAME\": \"spriteSize\",   \"TYPE\": \"float\", \"DEFAULT\": 0.15, \"MIN\": 0.01, \"MAX\": 2.0   }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_INSTANCE\" } }\n  ]\n}*/\n\nvec3 hsv2rgb(float h, float s, float v)\n{\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(vec3(h) + K.xyz) * 6.0 - K.www);\n    return v * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), s);\n}\n\nvoid main()\n{\n    uint idx = gl_GlobalInvocationID.x;\n    uint count = uint(numParticles);\n    if(idx >= count)\n        return;\n\n    // Ring in XZ plane (so SphereSplat's default cameraPos above looks down on it)\n    float t = float(idx) / float(count);\n    float angle = t * 6.28318530718 + TIME * 0.3;\n\n    vec3 pos = vec3(\n        cos(angle) * ringRadius,\n        sin(TIME + angle * 3.0) * 0.3, // gentle vertical wave\n        sin(angle) * ringRadius\n    );\n\n    vec3 col = hsv2rgb(t, 0.9, 1.0);\n\n    ISF_WRITE(geo, position)[idx]    = vec4(pos, 1.0);\n    ISF_WRITE(geo, color)[idx]       = vec4(col, 1.0);\n    ISF_WRITE(geo, sprite_size)[idx] = vec4(spriteSize, spriteSize, 0.0, 0.0);\n}\n","Inlets":[{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"numParticles","Exposed":"numparticles","Value":{"Int":298},"Init":{"Int":64},"Domain":{"Int":{"Min":1,"Max":10000}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"ringRadius","Exposed":"ringradius","Value":{"Float":2.8497250080108643},"Init":{"Float":2.0},"Domain":{"Float":{"Min":0.10000000149011612,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"spriteSize","Exposed":"spritesize","Value":{"Float":0.16751402616500854},"Init":{"Float":0.15000000596046448},"Domain":{"Float":{"Min":0.009999999776482582,"Max":2.0}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geo_out","Exposed":"geo_out"}]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":10,"Metadata":{"ScriptingName":"Text Box","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-592.1108333333332,-310.21933333333334],"Size":[574.0,23.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">This example feeds back a rendered geometry back inside the compute shader that generated it.</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]}],"SmallViewRack":[{"Processes":[2,4,5,7,8,9,10],"Process":null,"Height":200.0,"Nodal":true}],"FullViewRack":[{"Process":0,"Nodal":true}],"DefaultDuration":10584000000,"MinDuration":10584000000,"MaxDuration":11113200000,"GuiDuration":11642400000,"Speed":1.0,"Rigidity":false,"MinNull":false,"MaxInf":true,"Signatures":[[0,[4,4]]],"StartState":0,"EndState":1,"StartDate":0,"HeightPercentage":0.0,"NodalSlotHeight":531.0,"QuantizationRate":-1.0,"Zoom":7482201.439937091,"Center":4683896143,"NodalCenter":[-341.1108333333332,-446.71933333333334],"ViewMode":1,"SmallViewShown":true,"HasSignature":true},"StartTimeNode":{"ObjectName":"Scenario::TimeSyncModel","id":0,"Metadata":{"ScriptingName":"Sync.start","Comment":"","Color":"Gray","Label":"","Touched":true},"Date":0,"Events":[0],"MusicalSync":-1.0,"AutoTrigger":false,"Start":true,"Active":false,"Expression":" { true == false } "},"EndTimeNode":{"ObjectName":"Scenario::TimeSyncModel","id":1,"Metadata":{"ScriptingName":"Sync.end","Comment":"","Color":"Gray","Label":"","Touched":true},"Date":10584000000,"Events":[1],"MusicalSync":-1.0,"AutoTrigger":false,"Start":false,"Active":true,"Expression":" { true == false } "},"StartEvent":{"ObjectName":"Scenario::EventModel","id":0,"Metadata":{"ScriptingName":"Event.start","Co