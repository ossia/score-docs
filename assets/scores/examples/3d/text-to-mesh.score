r",{"Int":5}],["SrcAlpha",{"Int":6}],["OneMinusSrcAlpha",{"Int":7}],["DstAlpha",{"Int":8}],["OneMinusDstAlpha",{"Int":9}],["ConstantColor",{"Int":10}],["OneMinusConstantColor",{"Int":11}],["ConstantAlpha",{"Int":12}],["OneMinusConstantAlpha",{"Int":13}],["SrcAlphaSaturate",{"Int":14}]],"FolderPort":"","FileExtensions":""},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"OpAlpha","Exposed":"opalpha","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4]}},"Values":[["Add",{"Int":0}],["Substract",{"Int":1}],["Reverse Substract",{"Int":2}],["Min",{"Int":3}],["Max",{"Int":4}]],"FolderPort":"","FileExtensions":""},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":8,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":9,"Hidden":false,"Custom":"scene_lights","Exposed":"scene_lights","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":10,"Hidden":false,"Custom":"scene_light_indices","Exposed":"scene_light_indices","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":11,"Hidden":false,"Custom":"world_transforms","Exposed":"world_transforms","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":12,"Hidden":false,"Custom":"scene_materials","Exposed":"scene_materials","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":13,"Hidden":false,"Custom":"scene_material_uv_xforms","Exposed":"scene_material_uv_xforms","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":14,"Hidden":false,"Custom":"per_draws","Exposed":"per_draws","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":15,"Hidden":false,"Custom":"indirect_draw_cmds","Exposed":"indirect_draw_cmds","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":16,"Hidden":false,"Custom":"scene_counts","Exposed":"scene_counts","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":17,"Hidden":false,"Custom":"env","Exposed":"env","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":18,"Hidden":true,"Custom":"alpha_a2c_enabled","Exposed":"alpha_a2c_enabled","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":1}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":19,"Hidden":true,"Custom":"volumetric_enabled","Exposed":"volumetric_enabled","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":1}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":20,"Hidden":true,"Custom":"volumetric_intensity","Exposed":"volumetric_intensity","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":4.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1000,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":14,"Metadata":{"ScriptingName":"AddColor","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[377.72719073659846,-151.5],"Size":[275.0,391.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Add or replace the color attribute on geometry. Solid: solidColor. By Index: a rainbow along the vertex order (saturation). Random: a random hue per vertex (seed, saturation). Axis Gradient: colorA at -1 to colorB at +1 along gradientAxis (clamped outside). alpha multiplies the result.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Geometry Modifier\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" },\n        { \"NAME\": \"color\",    \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\" }\n      ]\n    },\n    {\n      \"NAME\": \"colorMode\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 1,\n      \"VALUES\": [0, 1, 2, 3],\n      \"LABELS\": [\"Solid\", \"By Index\", \"Random\", \"Axis Gradient\"]\n    },\n    {\n      \"NAME\": \"solidColor\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [1.0, 1.0, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"colorA\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [0.2, 0.4, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"colorB\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [1.0, 0.3, 0.1, 1.0]\n    },\n    {\n      \"NAME\": \"seed\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 42.0,\n      \"MIN\": 0.0,\n      \"MAX\": 1000.0\n    },\n    {\n      \"NAME\": \"saturation\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.7,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"alpha\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.0,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"gradientAxis\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 1,\n      \"VALUES\": [0, 1, 2],\n      \"LABELS\": [\"X\", \"Y\", \"Z\"]\n    }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\nuint pcg(uint s)\n{\n  s ^= s >> 17u; s *= 0xed5ad4bbu;\n  s ^= s >> 11u; s *= 0xac4c1b51u;\n  s ^= s >> 15u; s *= 0x31848babu;\n  s ^= s >> 14u;\n  return s;\n}\n\nfloat rand01(uint s) { return float(pcg(s)) / 4294967296.0; }\n\n// HSV to RGB\nvec3 hsv2rgb(float h, float s, float v)\n{\n  vec3 c = vec3(h, s, v);\n  vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0);\n  return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);\n}\n\nvoid main()\n{\n  uint idx = gl_GlobalInvocationID.x;\n  uint count = uint(ISF_READ(geo, position).length());\n  if(idx >= count)\n    return;\n\n  vec4 col;\n\n  // Mode 0: Solid color\n  if(colorMode == 0)\n  {\n    col = solidColor;\n  }\n  // Mode 1: By index (HSV rainbow)\n  else if(colorMode == 1)\n  {\n    float t = float(idx) / max(float(count - 1u), 1.0);\n    col = vec4(hsv2rgb(t, saturation, 1.0), 1.0);\n  }\n  // Mode 2: Random per-vertex\n  else if(colorMode == 2)\n  {\n    uint s = idx * 7919u + uint(seed * 65537.0);\n    float hue = rand01(s);\n    col = vec4(hsv2rgb(hue, saturation, 0.8 + 0.2 * rand01(s + 1u)), 1.0);\n  }\n  // Mode 3: Axis gradient (colorA -> colorB)\n  else\n  {\n    vec3 pos = ISF_READ(geo, position)[idx].xyz;\n    float v = pos[gradientAxis];\n\n    // Auto-normalize: scan is too expensive, use a reasonable range\n    // Map [-1, 1] to [0, 1] — works for most generators\n    float t = clamp(v * 0.5 + 0.5, 0.0, 1.0);\n    col = mix(colorA, colorB, t);\n  }\n\n  col.a *= alpha;\n  ISF_WRITE(geo, color)[idx] = col;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/modifiers/AddColor.cs","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geo","Exposed":"geo"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"colorMode","Exposed":"colormode","Value":{"Int":2},"Init":{"Int":1},"Domain":{"Int":{"Values":[0,1,2,3]}},"Values":[["Solid",{"Int":0}],["By Index",{"Int":1}],["Random",{"Int":2}],["Axis Gradient",{"Int":3}]],"FolderPort":"","FileExtensions":""},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"solidColor","Exposed":"solidcolor","Value":{"Vec4f":[0.37309834361076355,0.9100022912025452,0.8704509139060974,1.0]},"Init":{"Vec4f":[1.0,1.0,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"colorA","Exposed":"colora","Value":{"Vec4f":[0.9507285952568054,1.0,0.800000011920929,1.0]},"Init":{"Vec4f":[0.20000000298023224,0.4000000059604645,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"colorB","Exposed":"colorb","Value":{"Vec4f":[0.60990309715271,0.3199969530105591,1.0,1.0]},"Init":{"Vec4f":[1.0,0.30000001192092896,0.10000000149011612,1.0]},"Domain":{}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"seed","Exposed":"seed","Value":{"Float":42.0},"Init":{"Float":42.0},"Domain":{"Float":{"Min":0.0,"Max":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"saturation","Exposed":"saturation","Value":{"Float":0.699999988079071},"Init":{"Float":0.699999988079071},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"alpha","Exposed":"alpha","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"gradientAxis","Exposed":"gradientaxis","Value":{"Int":1},"Init":{"Int":1},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["X",{"Int":0}],["Y",{"Int":1}],["Z",{"Int":2}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geo_out","Exposed":"geo_out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":15,"Metadata":{"ScriptingName":"Deform","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[83.72719073659846,-154.5],"Size":[285.0,161.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Procedural deformation around center, along axis. amount means: Twist = radians of rotation per unit along the axis; Bend = curvature (1 / bend radius) per unit along the axis, bending toward the first perpendicular axis; Taper = change of the cross-section scale per unit along the axis (1 + amount x distance); Spherize = blend from the shape (0) to a sphere of the given radius (1), negative values push away; Quantize = snap to a grid of gridSize (amount unused). radius is used by Spherize only, gridSize by Quantize only. Normals are re-derived from the deformation; a geometry without normals is deformed too.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Geometry Modifier\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\" },\n        { \"NAME\": \"normal\",   \"SEMANTIC\": \"normal\",   \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\", \"REQUIRED\": false }\n      ]\n    },\n    { \"NAME\": \"deformType\", \"TYPE\": \"long\", \"VALUES\": [0, 1, 2, 3, 4], \"LABELS\": [\"Twist\", \"Bend\", \"Taper\", \"Spherize\", \"Quantize\"], \"DEFAULT\": 0 },\n    { \"NAME\": \"amount\",     \"TYPE\": \"float\",   \"DEFAULT\": 1.0,  \"MIN\": -10.0, \"MAX\": 10.0 },\n    { \"NAME\": \"axis\",       \"TYPE\": \"long\",    \"VALUES\": [0, 1, 2], \"LABELS\": [\"X\", \"Y\", \"Z\"], \"DEFAULT\": 1 },\n    { \"NAME\": \"center\",     \"TYPE\": \"point3D\", \"DEFAULT\": [0, 0, 0], \"MIN\": [-100, -100, -100], \"MAX\": [100, 100, 100] },\n    { \"NAME\": \"radius\",     \"TYPE\": \"float\",   \"DEFAULT\": 1.0,  \"MIN\": 0.01,  \"MAX\": 100.0 },\n    { \"NAME\": \"gridSize\",   \"TYPE\": \"float\",   \"DEFAULT\": 0.1,  \"MIN\": 0.01,  \"MAX\": 10.0 }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\n// Extract the component along the chosen axis and the two perpendicular components.\n// Returns vec3(along_axis, perp1, perp2) and sets up indices for reassembly.\n// axis: 0=X, 1=Y, 2=Z\n\nfloat getAxisComponent(vec3 p, int ax)\n{\n    if(ax == 0) return p.x;\n    if(ax == 1) return p.y;\n    return p.z;\n}\n\nvec3 setAxisComponent(vec3 p, int ax, float v)\n{\n    if(ax == 0) p.x = v;\n    else if(ax == 1) p.y = v;\n    else p.z = v;\n    return p;\n}\n\n// Get the two perpendicular axis indices\nivec2 perpAxes(int ax)\n{\n    if(ax == 0) return ivec2(1, 2);\n    if(ax == 1) return ivec2(0, 2);\n    return ivec2(0, 1);\n}\n\nfloat getComp(vec3 p, int i)\n{\n    if(i == 0) return p.x;\n    if(i == 1) return p.y;\n    return p.z;\n}\n\nvec3 setComp(vec3 p, int i, float v)\n{\n    if(i == 0) p.x = v;\n    else if(i == 1) p.y = v;\n    else p.z = v;\n    return p;\n}\n\nvec3 doTwist(vec3 pos, vec3 ctr, int ax, float amt)\n{\n    vec3 p = pos - ctr;\n    float along = getAxisComponent(p, ax);\n    float angle = amt * along;\n    float c = cos(angle), s = sin(angle);\n\n    ivec2 perp = perpAxes(ax);\n    float u = getComp(p, perp.x);\n    float v = getComp(p, perp.y);\n\n    float nu = c * u - s * v;\n    float nv = s * u + c * v;\n\n    p = setComp(p, perp.x, nu);\n    p = setComp(p, perp.y, nv);\n    return p + ctr;\n}\n\nvec3 doBend(vec3 pos, vec3 ctr, int ax, float amt)\n{\n    vec3 p = pos - ctr;\n    float along = getAxisComponent(p, ax);\n    float angle = amt * along;\n\n    // Bend in the plane of (axis, first perpendicular axis)\n    ivec2 perp = perpAxes(ax);\n    float u = getComp(p, perp.x);\n\n    // If amount is near zero, skip to avoid division by zero\n    if(abs(amt) < 0.0001)\n        return pos;\n\n    float bendRadius = 1.0 / amt;\n    // Circular arc: the along-axis coordinate maps to an angle,\n    // and the perpendicular offset shifts the radius\n    float r = bendRadius + u;\n    float newAlong = r * sin(angle);\n    float newPerp  = r * cos(angle) - bendRadius;\n\n    p = setAxisComponent(p, ax, newAlong);\n    p = setComp(p, perp.x, newPerp);\n    return p + ctr;\n}\n\nvec3 doTaper(vec3 pos, vec3 ctr, int ax, float amt)\n{\n    vec3 p = pos - ctr;\n    float along = getAxisComponent(p, ax);\n    float taperScale = 1.0 + amt * along;\n    taperScale = max(taperScale, 0.0);\n\n    ivec2 perp = perpAxes(ax);\n    float u = getComp(p, perp.x) * taperScale;\n    float v = getComp(p, perp.y) * taperScale;\n\n    p = setComp(p, perp.x, u);\n    p = setComp(p, perp.y, v);\n    return p + ctr;\n}\n\nvec3 doSpherize(vec3 pos, vec3 ctr, float r, float amt)\n{\n    vec3 d = pos - ctr;\n    float len = length(d);\n    if(len < 0.0001)\n        return pos;\n\n    vec3 spherePos = normalize(d) * r + ctr;\n    return mix(pos, spherePos, clamp(amt, -1.0, 1.0));\n}\n\nvec3 doQuantize(vec3 pos, float grid)\n{\n    return round(pos / grid) * grid;\n}\n\n// Approximate normal after deformation by computing the Jacobian via finite differences.\nvec3 deformNormal(vec3 pos, vec3 nrm, vec3 ctr, int ax, int dtype, float amt, float r, float grid)\n{\n    float eps = 0.001;\n    vec3 tangentX, tangentY, tangentZ;\n\n    // Compute displaced neighbors along each axis\n    vec3 px, mx, py, my, pz, mz;\n\n    // We compute the deformed positions at small offsets to approximate partial derivatives\n    vec3 ppx = pos + vec3(eps, 0.0, 0.0);\n    vec3 pmx = pos - vec3(eps, 0.0, 0.0);\n    vec3 ppy = pos + vec3(0.0, eps, 0.0);\n    vec3 pmy = pos - vec3(0.0, eps, 0.0);\n    vec3 ppz = pos + vec3(0.0, 0.0, eps);\n    vec3 pmz = pos - vec3(0.0, 0.0, eps);\n\n    if(dtype == 0) // Twist\n    {\n        px = doTwist(ppx, ctr, ax, amt); mx = doTwist(pmx, ctr, ax, amt);\n        py = doTwist(ppy, ctr, ax, amt); my = doTwist(pmy, ctr, ax, amt);\n        pz = doTwist(ppz, ctr, ax, amt); mz = doTwist(pmz, ctr, ax, amt);\n    }\n    else if(dtype == 1) // Bend\n    {\n        px = doBend(ppx, ctr, ax, amt); mx = doBend(pmx, ctr, ax, amt);\n        py = doBend(ppy, ctr, ax, amt); my = doBend(pmy, ctr, ax, amt);\n        pz = doBend(ppz, ctr, ax, amt); mz = doBend(pmz, ctr, ax, amt);\n    }\n    else if(dtype == 2) // Taper\n    {\n        px = doTaper(ppx, ctr, ax, amt); mx = doTaper(pmx, ctr, ax, amt);\n        py = doTaper(ppy, ctr, ax, amt); my = doTaper(pmy, ctr, ax, amt);\n        pz = doTaper(ppz, ctr, ax, amt); mz = doTaper(pmz, ctr, ax, amt);\n    }\n    else if(dtype == 3) // Spherize\n    {\n        px = doSpherize(ppx, ctr, r, amt); mx = doSpherize(pmx, ctr, r, amt);\n        py = doSpherize(ppy, ctr, r, amt); my = doSpherize(pmy, ctr, r, amt);\n        pz = doSpherize(ppz, ctr, r, amt); mz = doSpherize(pmz, ctr, r, amt);\n    }\n    else // Quantize - normals are meaningless after quantize, keep original\n    {\n        return nrm;\n    }\n\n    // Jacobian columns (partial derivatives of deformation)\n    vec3 dFdx = (px - mx) / (2.0 * eps);\n    vec3 dFdy = (py - my) / (2.0 * eps);\n    vec3 dFdz = (pz - mz) / (2.0 * eps);\n\n    // Transform normal by inverse-transpose of Jacobian:\n    // n' = normalize( inv(J)^T * n )\n    // For a 3x3 matrix, inv(J)^T can be computed via cofactor matrix.\n    // cofactor(J) = transpose of adjugate\n    mat3 J = mat3(dFdx, dFdy, dFdz);\n\n    // Cofactor matrix (each element is the 2x2 minor determinant with sign)\n    mat3 cof;\n    cof[0][0] = J[1][1]*J[2][2] - J[1][2]*J[2][1];\n    cof[0][1] = J[1][2]*J[2][0] - J[1][0]*J[2][2];\n    cof[0][2] = J[1][0]*J[2][1] - J[1][1]*J[2][0];\n    cof[1][0] = J[0][2]*J[2][1] - J[0][1]*J[2][2];\n    cof[1][1] = J[0][0]*J[2][2] - J[0][2]*J[2][0];\n    cof[1][2] = J[0][1]*J[2][0] - J[0][0]*J[2][1];\n    cof[2][0] = J[0][1]*J[1][2] - J[0][2]*J[1][1];\n    cof[2][1] = J[0][2]*J[1][0] - J[0][0]*J[1][2];\n    cof[2][2] = J[0][0]*J[1][1] - J[0][1]*J[1][0];\n\n    // inv(J)^T * n = cofactor * n (unnormalized)\n    vec3 newNormal = cof * nrm;\n    float len = length(newNormal);\n    return len > 0.0001 ? newNormal / len : nrm;\n}\n\nvoid main()\n{\n    uint idx = gl_GlobalInvocationID.x;\n    uint count = uint(ISF_WRITE(geo, position).length());\n    if(idx >= count)\n        return;\n\n    vec3 pos = ISF_READ(geo, position)[idx].xyz;\n    vec3 nrm = ISF_READ(geo, normal)[idx].xyz;\n\n    int dtype = int(deformType);\n    int ax = int(axis);\n\n    // Compute deformed normal (uses original position for Jacobian)\n    nrm = deformNormal(pos, nrm, center, ax, dtype, amount, radius, gridSize);\n\n    // Deform position\n    vec3 newPos;\n    if(dtype == 0)\n        newPos = doTwist(pos, center, ax, amount);\n    else if(dtype == 1)\n        newPos = doBend(pos, center, ax, amount);\n    else if(dtype == 2)\n        newPos = doTaper(pos, center, ax, amount);\n    else if(dtype == 3)\n        newPos = doSpherize(pos, center, radius, amount);\n    else\n        newPos = doQuantize(pos, gridSize);\n\n    ISF_WRITE(geo, position)[idx] = vec4(newPos, ISF_READ(geo, position)[idx].w);\n    ISF_WRITE(geo, normal)[idx] = vec4(nrm, 0.0);\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/modifiers/Deform.cs","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geo","Exposed":"geo"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"deformType","Exposed":"deformtype","Value":{"Int":4},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4]}},"Values":[["Twist",{"Int":0}],["Bend",{"Int":1}],["Taper",{"Int":2}],["Spherize",{"Int":3}],["Quantize",{"Int":4}]],"FolderPort":"","FileExtensions":""},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"amount","Exposed":"amount","Value":{"Float":-1.563799262046814},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-10.0,"Max":10.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"axis","Exposed":"axis","Value":{"Int":0},"Init":{"Int":1},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["X",{"Int":0}],["Y",{"Int":1}],["Z",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"center","Exposed":"center","Value":{"Vec3f":[0.0,0.07422865182161331,0.0]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[-100.0,-100.0,-100.0],"Max":[100.0,100.0,100.0],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"radius","Exposed":"radius","Value":{"Float":6.297386646270752},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.009999999776482582,"Max":100.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"gridSize","Exposed":"gridsize","Value":{"Float":0.5875222682952881},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.009999999776482582,"Max":10.0}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geo_out","Exposed":"geo_out"}]},{"uuid":"d3f5a8c1-8b47-4e91-9c2d-6f1a9b5e3c82","ObjectName":"environment_loader","id":12,"Metadata":{"ScriptingName":"Environment.6","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[-474.27280926340154,-361.5],"Size":[352.0,176.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id