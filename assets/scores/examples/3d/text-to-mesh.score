ax":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Fog End","Exposed":"fog end","Value":{"Float":100.0},"Init":{"Float":100.0},"Domain":{"Float":{"Min":0.0,"Max":10000.0}}},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"Render target size","Exposed":"render target size","Value":{"Vec2f":[0.0,0.0]},"Init":{"Vec2f":[0.0,0.0]},"Domain":{"Vec2f":{"Min":[0.0,0.0],"Max":[16384.0,16384.0],"Values":[[],[]]}},"Integral":true}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Scene","Exposed":"scene"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":16,"Metadata":{"ScriptingName":"17-03_bit_glitch","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-614.804207027565,-576.6285953954568],"Size":[166.0,67.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Bit-plane glitch: per-voxel XOR of integer coordinates, shifted with time. Very 8-bit.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"EXOTIC\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"shift\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 4,\n      \"MIN\": 1,\n      \"MAX\": 8,\n      \"LABEL\": \"Bit shift\"\n    },\n    {\n      \"NAME\": \"speed\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.0,\n      \"MIN\": 0.0,\n      \"MAX\": 8.0,\n      \"LABEL\": \"Speed\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    uint x = uint(pos.x), y = uint(pos.y), z = uint(pos.z);\n    uint t = uint(TIME * speed * 8.0);\n    uint v = ((x ^ y) >> uint(shift)) ^ ((y ^ z) >> uint(shift)) ^ t;\n    float g = float(v & 7u) / 7.0;\n    float b = float((v >> 3u) & 7u) / 7.0;\n    float r = float((v >> 6u) & 7u) / 7.0;\n    imageStore(volume, pos, vec4(r, g, b, 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/17-exotic/17-03_bit_glitch.cs","Inlets":[{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"shift","Exposed":"shift","Value":{"Int":4},"Init":{"Int":4},"Domain":{"Int":{"Min":1,"Max":8}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"speed","Exposed":"speed","Value":{"Float":2.0},"Init":{"Float":2.0},"Domain":{"Float":{"Min":0.0,"Max":8.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":17,"Metadata":{"ScriptingName":"Text Box","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-106.48420702756496,-213.02859539545676],"Size":[454.0,23.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta