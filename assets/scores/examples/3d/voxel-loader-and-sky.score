-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1000,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":15,"Metadata":{"ScriptingName":"01-04_worley_f1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[42.46892379096914,-790.6848399600374],"Size":[165.0,70.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"3D Worley (cellular) noise, F1 distance \\u2014 distance to nearest feature point. Produces pebble / cell patterns. Small scale \\u2192 many cells, big scale \\u2192 few.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"NOISE\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"scale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 6.0,\n      \"MIN\": 1.0,\n      \"MAX\": 32.0,\n      \"LABEL\": \"Scale\"\n    },\n    {\n      \"NAME\": \"drift\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.15,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\n// --- Hashing & random ----------------------------------------------------\nfloat hash11(float n){ return fract(sin(n)*43758.5453123); }\nfloat hash13(vec3 p){\n    p = fract(p * 0.3183099 + 0.1);\n    p *= 17.0;\n    return fract(p.x*p.y*p.z*(p.x+p.y+p.z));\n}\nvec3 hash33(vec3 p){\n    p = vec3(dot(p,vec3(127.1,311.7, 74.7)),\n             dot(p,vec3(269.5,183.3,246.1)),\n             dot(p,vec3(113.5,271.9,124.6)));\n    return fract(sin(p) * 43758.5453123);\n}\n\n// Worley 3D: returns vec2(F1, F2) — distances to nearest / 2nd-nearest feature points.\nvec2 worley(vec3 x){\n    vec3 p = floor(x);\n    vec3 f = fract(x);\n    float F1 = 1e9, F2 = 1e9;\n    for(int k=-1;k<=1;k++)\n    for(int j=-1;j<=1;j++)\n    for(int i=-1;i<=1;i++){\n        vec3 b = vec3(i,j,k);\n        vec3 r = b + hash33(p+b) - f;\n        float d = dot(r,r);\n        if(d < F1){ F2 = F1; F1 = d; }\n        else if(d < F2){ F2 = d; }\n    }\n    return sqrt(vec2(F1, F2));\n}\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    vec2 w = worley(pc * scale + vec3(TIME*drift));\n    float v = clamp(w.x, 0.0, 1.0);\n    imageStore(volume, pos, vec4(vec3(v), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/archive/2026-09-25/volume/01-04_worley_f1.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"scale","Exposed":"scale","Value":{"Float":1.0},"Init":{"Float":6.0},"Domain":{"Float":{"Min":1.0,"Max":32.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"drift","Exposed":"drift","Value":{"Float":0.07999999821186066},"Init":{"Float":0.15000000596046448},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":17,"Metadata":{"ScriptingName":"Bloom","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[1967.8815642780999,-660.8273711160818],"Size":[292.0,160.0],"Loops":false,"FoldMode":2,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia score\",\n    \"ISFVSN\": \"2\",\n    \"DESCRIPTION\": \"Bloom / glow with iterative separable Gaussian blur. Extracts bright pixels with soft knee, blurs with 4 H/V iterations, composites onto original. HDR-aware. Smooth, wide, artifact-free.\",\n    \"CATEGORIES\": [ \"Filter\" ],\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\" },\n        { \"NAME\": \"threshold\",  \"LABEL\": \"Threshold\",  \"TYPE\": \"float\", \"DEFAULT\": 0.8, \"MIN\": 0.0, \"MAX\": 5.0 },\n        { \"NAME\": \"soft_knee\",  \"LABEL\": \"Soft Knee\",  \"TYPE\": \"float\", \"DEFAULT\": 0.5, \"MIN\": 0.0, \"MAX\": 1.0 },\n        { \"NAME\": \"intensity\",  \"LABEL\": \"Intensity\",  \"TYPE\": \"float\", \"DEFAULT\": 0.4, \"MIN\": 0.0, \"MAX\": 2.0 },\n        { \"NAME\": \"spread\",     \"LABEL\": \"Spread\",     \"TYPE\": \"float\", \"DEFAULT\": 3.0, \"MIN\": 0.5, \"MAX\": 10.0 },\n        { \"NAME\": \"tint\",       \"LABEL\": \"Bloom Tint\", \"TYPE\": \"color\", \"DEFAULT\": [ 1.0, 1.0, 1.0, 1.0 ] }\n    ],\n    \"PASSES\": [\n        { \"TARGET\": \"bright\" },\n        { \"TARGET\": \"h1\" },\n        { \"TARGET\": \"v1\" },\n        { \"TARGET\": \"h2\" },\n        { \"TARGET\": \"v2\" },\n        { \"TARGET\": \"h3\" },\n        { \"TARGET\": \"v3\" },\n        { \"TARGET\": \"h4\" },\n        { \"TARGET\": \"v4\" },\n        {}\n    ]\n}*/\n\nconst vec3 luma_coeff = vec3(0.2126, 0.7152, 0.0722);\nconst float offsets[3] = float[3](0.0, 1.3846153846, 3.2307692308);\nconst float weights[3] = float[3](0.2270270270, 0.3162162162, 0.0702702703);\n\nvec4 blur9(sampler2D tex, vec2 uv, vec2 direction, float s) {\n    vec2 px = direction * s / RENDERSIZE;\n    vec4 c = IMG_NORM_PIXEL(tex, uv) * weights[0];\n    for (int i = 1; i < 3; i++) {\n        vec2 off = px * offsets[i];\n        c += IMG_NORM_PIXEL(tex, uv + off) * weights[i];\n        c += IMG_NORM_PIXEL(tex, uv - off) * weights[i];\n    }\n    return c;\n}\n\nvoid main() {\n    vec2 uv = isf_FragNormCoord;\n    float s = spread * 0.5;\n\n    if (PASSINDEX == 0) {\n        vec4 c = IMG_NORM_PIXEL(inputImage, uv);\n        float L = dot(luma_coeff, c.rgb);\n        float knee = threshold * soft_knee;\n        float t = max(L - threshold + knee, 0.0);\n        float blend = min(t / (2.0 * knee + 0.0001), 1.0);\n        blend *= blend;\n        gl_FragColor = vec4(c.rgb * blend, c.a);\n    }\n    else if (PASSINDEX == 1) gl_FragColor = blur9(bright, uv, vec2(1,0), s);\n    else if (PASSINDEX == 2) gl_FragColor = blur9(h1, uv, vec2(0,1), s);\n    else if (PASSINDEX == 3) gl_FragColor = blur9(v1, uv, vec2(1,0), s);\n    else if (PASSINDEX == 4) gl_FragColor = blur9(h2, uv, vec2(0,1), s);\n    else if (PASSINDEX == 5) gl_FragColor = blur9(v2, uv, vec2(1,0), s);\n    else if (PASSINDEX == 6) gl_FragColor = blur9(h3, uv, vec2(0,1), s);\n    else if (PASSINDEX == 7) gl_FragColor = blur9(v3, uv, vec2(1,0), s);\n    else if (PASSINDEX == 8) gl_FragColor = blur9(h4, uv, vec2(0,1), s);\n    else {\n        vec4 original = IMG_NORM_PIXEL(inputImage, uv);\n        vec3 bloom = IMG_NORM_PIXEL(v4, uv).rgb * intensity * tint.rgb;\n        gl_FragColor = vec4(original.rgb + bloom, original.a);\n    }\n}\n","Root":"<LIBRARY>:packages/default/Presets/GLSL_shaders/linear/Bloom.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":8,"FormatSet":true,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"threshold","Exposed":"threshold","Value":{"Float":2.0833332538604736},"Init":{"Float":0.800000011920929},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"soft_knee","Exposed":"soft_knee","Value":{"Float":1.0},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"intensity","Exposed":"intensity","Value":{"Float":2.0},"Init":{"Float":0.4000000059604645},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"spread","Exposed":"spread","Value":{"Float":5.25},"Init":{"Float":3.0},"Domain":{"Float":{"Min":0.5,"Max":10.0}}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"tint","Exposed":"tint","Value":{"Vec4f":[1.0,1.0,1.0,1.0]},"Init":{"Vec4f":[1.0,1.0,1.0,1.0]},"Domain":{}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"6e74b962-b102-4d2d-b6f1-850917e8c747","ObjectName":"avnd_vec3f","id":18,"Metadata":{"ScriptingName":"Eye","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-681.3245046062985,-493.64557219743386],"Size":[94.0,96.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"X","Exposed":"x","Value":{"Float":-410.20068359375},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Y","Exposed":"y","Value":{"Float":6.885758876800537},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Z","Exposed":"z","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Pair","Exposed":"pair"}]},{"uuid":"6e74b962-b102-4d2d-b6f1-850917e8c747","ObjectName":"avnd_vec3f","id":19,"Metadata":{"ScriptingName":"Target","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-682.3245046062984,-367.5802668977838],"Size":[94.0,96.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"X","Exposed":"x","Value":{"Float":-571.6649780273438},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Y","Exposed":"y","Value":{"Float":5.16037130355835},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Z","Exposed":"z","Value":{"Float":-483.14739990234375},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Pair","Exposed":"pair"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":20,"Metadata":{"ScriptingName":"Film Grain","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[2278.8815642781,-658.8273711160818],"Size":[157.0,160.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia score\",\n    \"ISFVSN\": \"2\",\n    \"DESCRIPTION\": \"Photographic film grain. Organic noise weighted by luminance (more visible in midtones, less in deep shadows and bright highlights, like real film). Configurable size, intensity, and color/mono balance.\",\n    \"CATEGORIES\": [ \"Filter\" ],\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\" },\n        {\n            \"NAME\": \"intensity\",\n            \"LABEL\": \"Intensity\",\n            \"TYPE\": \"float\",\n            \"DEFAULT\": 0.05,\n            \"MIN\": 0.0,\n            \"MAX\": 0.3\n        },\n        {\n            \"NAME\": \"size\",\n            \"LABEL\": \"Grain Size\",\n            \"TYPE\": \"float\",\n            \"DEFAULT\": 1.5,\n            \"MIN\": 0.5,\n            \"MAX\": 4.0\n        },\n        {\n            \"NAME\": \"color_amount\",\n            \"LABEL\": \"Color Grain\",\n            \"TYPE\": \"float\",\n            \"DEFAULT\": 0.3,\n            \"MIN\": 0.0,\n            \"MAX\": 1.0\n        },\n        {\n            \"NAME\": \"midtone_bias\",\n            \"LABEL\": \"Midtone Bias\",\n            \"TYPE\": \"float\",\n            \"DEFAULT\": 0.5,\n            \"MIN\": 0.0,\n            \"MAX\": 1.0\n        }\n    ]\n}*/\n\nconst vec3 luma = vec3(0.2126, 0.7152, 0.0722);\n\n// Hash-based pseudo-random (repeatable per pixel per frame)\nfloat hash12(vec2 p) {\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p) {\n    p = fract(p * 0.1031);\n    p += dot(p, p.zyx + 31.32);\n    return fract((p.x + p.y) * p.z);\n}\n\n// Approximate Gaussian from uniform hash (Box-Muller simplified)\nfloat gaussianNoise(vec2 uv, float seed) {\n    float u1 = max(hash13(vec3(uv, seed)), 1e-6);\n    float u2 = hash13(vec3(uv, seed + 17.37));\n    return sqrt(-2.0 * log(u1)) * cos(6.2831853 * u2);\n}\n\nvoid main() {\n    vec2 uv = isf_FragNormCoord;\n    vec4 orig = IMG_NORM_PIXEL(inputImage, uv);\n    vec3 c = orig.rgb;\n\n    // Grain coordinate (quantized for size control)\n    vec2 grainUV = floor(gl_FragCoord.xy / size) * size;\n    float t = TIME * 60.0; // animate grain per frame\n\n    // Luminance noise (monochrome grain)\n    float monoGrain = gaussianNoise(grainUV, t);\n\n    // Color noise (per-channel, shifted seeds)\n    vec3 colorGrain = vec3(\n        gaussianNoise(grainUV, t + 1.0),\n        gaussianNoise(grainUV, t + 2.0),\n        gaussianNoise(grainUV, t + 3.0)\n    );\n\n    // Blend mono and color grain\n    vec3 grain = mix(vec3(monoGrain), colorGrain, color_amount);\n\n    // Luminance-weighted response: more grain in midtones\n    // f(L) = L * (1-L) * 4 peaks at L=0.5\n    float L = dot(luma, c);\n    float weight = mix(1.0, 4.0 * L * (1.0 - clamp(L, 0.0, 1.0)), midtone_bias);\n\n    c += grain * intensity * weight;\n\n    gl_FragColor = vec4(c, orig.a);\n}\n","Root":"<LIBRARY>:packages/default/Presets/GLSL_shaders/linear/Film Grain.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":8,"FormatSet":true,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"intensity","Exposed":"intensity","Value":{"Float":0.019999999552965164},"Init":{"Float":0.05000000074505806},"Domain":{"Float":{"Min":0.0,"Max":0.30000001192092896}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"size","Exposed":"size","Value":{"Float":1.5},"Init":{"Float":1.5},"Domain":{"Float":{"Min":0.5,"Max":4.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"color_amount","Exposed":"color_amount","Value":{"Float":0.30000001192092896},"Init":{"Float":0.30000001192092896},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"midtone_bias","Exposed":"midtone_bias","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":21,"Metadata":{"ScriptingName":"Chromatic Aberration","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[2451.8815642781,-657.8273711160818],"Size":[208.0,161.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia score\",\n    \"ISFVSN\": \"2\",\n    \"DESCRIPTION\": \"Chromatic aberration / RGB split. Separates color channels with spatial offset. Radial mode simulates lens fringing; directional mode is a VJ staple. Works on any value range.\",\n    \"CATEGORIES\": [ \"Filter\" ],\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\" },\n        {\n            \"NAME\": \"mode\",\n            \"LABEL\": \"Mode\",\n            \"TYPE\": \"long\",\n            \"DEFAULT\": 0,\n            \"VALUES\": [ 0, 1 ],\n            \"LABELS\": [ \"Radial (lens-like)\", \"Directional\" ]\n        },\n        {\n            \"NAME\": \"amount\",\n            \"LABEL\": \"Amount\",\n            \"TYPE\": \"float\",\n            \"DEFAULT\": 0.005,\n            \"MIN\": 0.0,\n            \"MAX\": 0.05\n        },\n        {\n            \"NAME\": \"angle\",\n            \"LABEL\": \"Direction Angle\",\n            \"TYPE\": \"float\",\n            \"DEFAULT\": 0.0,\n            \"MIN\": 0.0,\n            \"MAX\": 6.283\n        },\n        {\n            \"NAME\": \"center\",\n            \"LABEL\": \"Radial Center\",\n            \"TYPE\": \"point2D\",\n            \"DEFAULT\": [ 0.5, 0.5 ]\n        }\n    ]\n}*/\n\nvoid main() {\n    vec2 uv = isf_FragNormCoord;\n\n    vec2 offset;\n    if (mode == 0) {\n        // Radial: offset direction is away from center\n        offset = (uv - center) * amount;\n    } else {\n        // Directional: fixed angle\n        offset = vec2(cos(angle), sin(angle)) * amount;\n    }\n\n    // Red shifts outward, blue shifts inward, green stays\n    float r = IMG_NORM_PIXEL(inputImage, uv + offset).r;\n    float g = IMG_NORM_PIXEL(inputImage, uv).g;\n    float b = IMG_NORM_PIXEL(inputImage, uv - offset).b;\n    float a = IMG_NORM_PIXEL(inputImage, uv).a;\n\n    gl_FragColor = vec4(r, g, b, a);\n}\n","Root":"<LIBRARY>:packages/default/Presets/GLSL_shaders/linear/Chromatic Aberration.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":8,"FormatSet":true,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"mode","Exposed":"mode","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1]}},"Values":[["Radial (lens-like)",{"Int":0}],["Directional",{"Int":1}]],"FolderPort":"","FileExtensions":""},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"amount","Exposed":"amount","Value":{"Float":0.00361846387386322},"Init":{"Float":0.004999999888241291},"Domain":{"Float":{"Min":0.0,"Max":0.05000000074505806}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"angle","Exposed":"angle","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":6.2829999923706055}}},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"center","Exposed":"center","Value":{"Vec2f":[0.5,0.5]},"Init":{"Vec2f":[0.5,0.5]},"Domain":{"Vec2f":{"Min":[-0.5,-0.5],"Max":[1.0,1.0],"Values":[[],[]]}},"Integral":false}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"3c9d6c2b-1f04-4f7d-9bc2-a4b1d7c8e5f0","ObjectName":"extract_buffer_by_name","id":23,"Metadata":{"ScriptingName":"Extract buffer (by name)","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[14.354593788567527,-480.7225091480393],"Size":[234.0,110.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Geometry","Exposed":"geometry"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Mode","Exposed":"mode","Value":{"Int":1},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1]}},"Values":[["Attribute",{"Int":0}],["Buffer",{"Int":1}]],"FolderPort":"","FileExtensions":""},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Name / index","Exposed":"name _ index","Value":{"String":"camera"},"Init":{"String":"position"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Pad vec3 to vec4","Exposed":"pad vec3 to vec4","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Buffer","Exposed":"buffer"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":27,"Metadata":{"ScriptingName":"Depth Dither","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[1649.2058456619525,-222.39568868890157],"Size":[226.0,145.0],"Loops":false,"FoldMode":2,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia team\",\n    \"ISFVSN\": \"2\",\n    \"MODE\": \"ISF\",\n    \"DESCRIPTION\": \"Bayer 4x4 ordered dither with depth-scaled strength. Near pixels remain smooth; far pixels are quantised to `levels` values per channel (black and white included) with classic Gameboy / early-PC dither stipple. A nostalgic lo-fi haze for backgrounds. Depth weight 0 applies the full effect everywhere.\",\n    \"CATEGORIES\": [\"Post-process\", \"Stylise\"],\n\n    \"PIPELINE_STATE\": {\n        \"DEPTH_TEST\": true,\n        \"DEPTH_COMPARE\": \"always\",\n        \"DEPTH_WRITE\": true\n    },\n\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\", \"DEPTH\": true, \"LABEL\": \"Scene color + depth\" },\n        { \"NAME\": \"camera\", \"TYPE\": \"uniform\", \"LABEL\": \"Camera matrices\",\n            \"LAYOUT\": [\n                { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n                { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n                { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n                { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n                { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n                { \"NAME\": \"params\",         \"TYPE\": \"vec4\" } ] },\n        { \"NAME\": \"dither\", \"TYPE\": \"float\", \"LABEL\": \"Dither amount (1 / (levels - 1) = one full level)\",\n          \"DEFAULT\": 0.2, \"MIN\": 0.0, \"MAX\": 0.5 },\n        { \"NAME\": \"depthWeight\", \"TYPE\": \"float\", \"LABEL\": \"Depth weight (1 = full depth-scaled, 0 = uniform)\",\n          \"DEFAULT\": 1.0, \"MIN\": 0.0, \"MAX\": 1.0 },\n        { \"NAME\": \"depthScale\", \"TYPE\": \"float\", \"LABEL\": \"Depth scale (world units)\",\n          \"DEFAULT\": 30.0, \"MIN\": 0.1, \"MAX\": 1000.0 },\n        { \"NAME\": \"levels\", \"TYPE\": \"float\", \"LABEL\": \"Colour levels per channel (far)\",\n          \"DEFAULT\": 6.0, \"MIN\": 2.0, \"MAX\": 256.0 }\n    ]\n}*/\n\n#include \"depth_helpers.glsl\"\n\n// Standard Bayer 4x4 — values in [0, 15] / 16.\nfloat bayer4x4(ivec2 p)\n{\n    int x = p.x & 3;\n    int y = p.y & 3;\n    int i = x + y * 4;\n    // Hard-coded matrix:  0  8  2 10 / 12 4 14 6 / 3 11 1 9 / 15 7 13 5.\n    if (i ==  0) return  0.0/16.0;\n    if (i ==  1) return  8.0/16.0;\n    if (i ==  2) return  2.0/16.0;\n    if (i ==  3) return 10.0/16.0;\n    if (i ==  4) return 12.0/16.0;\n    if (i ==  5) return  4.0/16.0;\n    if (i ==  6) return 14.0/16.0;\n    if (i ==  7) return  6.0/16.0;\n    if (i ==  8) return  3.0/16.0;\n    if (i ==  9) return 11.0/16.0;\n    if (i == 10) return  1.0/16.0;\n    if (i == 11) return  9.0/16.0;\n    if (i == 12) return 15.0/16.0;\n    if (i == 13) return  7.0/16.0;\n    if (i == 14) return 13.0/16.0;\n    return 5.0/16.0;\n}\n\nvoid main()\n{\n    vec2  uv    = isf_FragNormCoord;\n    vec4  color = IMG_NORM_PIXEL(inputImage, uv);\n    float rawD  = IMG_DEPTH_NORM_PIXEL(inputImage, uv);\n    float eye   = dh_linearizeDepth(rawD, camera.projection);\n    float t     = clamp(eye / depthScale, 0.0, 1.0);\n    // Effect weight: 1 far (or everywhere with depthWeight 0), 0 at the camera.\n    float w     = mix(1.0, t, depthWeight);\n\n    ivec2 ip = ivec2(isf_FragCoord.xy);\n    float b = bayer4x4(ip) - 0.5;\n\n    // `levels` values per channel from 0 to 1, rounded to the nearest, so\n    // the image keeps its brightness (floor() lost half a level and crushed\n    // dark scenes to black). The level count rises to 256 (smooth) near.\n    float steps = max(mix(256.0, levels, w) - 1.0, 1.0);\n    vec3 dithered = color.rgb + b * dither * w;\n    vec3 q = floor(clamp(dithered, 0.0, 1.0) * steps + 0.5) / steps;\n\n    isf_FragColor = vec4(q, color.a);\n    gl_FragDepth = rawD;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/depth/Depth Dither.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":8,"FormatSet":true,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"dither","Exposed":"dither","Value":{"Float":0.5},"Init":{"Float":0.20000000298023224},"Domain":{"Float":{"Min":0.0,"Max":0.5}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"depthWeight","Exposed":"depthweight","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"depthScale","Exposed":"depthscale","Value":{"Float":37.607139587402344},"Init":{"Float":30.0},"Domain":{"Float":{"Min":0.10000000149011612,"Max":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"levels","Exposed":"levels","Value":{"Float":5.110602855682373},"Init":{"Float":6.0},"Domain":{"Float":{"Min":2.0,"Max":256.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":28,"Metadata":{"ScriptingName":"Text Box","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[150.53225454293027,-966.376970653349],"Size":[642.0,113.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">This example shows multiple things:<br />1. Support for the voxel formats (MagicaVoxel, etc.)</p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">2. Layering: the cloud renders at maximum distance (remember that score uses a reverse-Z pipeline though!) <br />and our voxels at their normal distance. The Bloom input allocates a matching z-buffer to ensure everything<br />renders in order.<br />3. Our sky shader needs a camera buffer, like the depth postprocessors.<br />The voxel mesh renderer shader in this exampl uses the direct cameraPos and lookAt controls.</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"a8f2c6d0-1b4e-4c7a-9d3f-5e8b2c1a7f0d","ObjectName":"gfxProcess","id":14,"Metadata":{"ScriptingName":"Scene Preprocessor","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-176.2256368389709,-476.5],"Size":[171.0,22.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Scene In","Exposed":"scene in"}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Geometry Out","Exposed":"geometry out"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":29,"Metadata":{"ScriptingName":"Depth Micro AO","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[1441.7981438697793,-221.69865157199024],"Size":[166.0,145.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia team\",\n    \"ISFVSN\": \"2\",\n    \"MODE\": \"ISF\",\n    \"DESCRIPTION\": \"Fast single-pass ambient occlusion. Samples eight neighbours at a user radius, counts how many rise more than `bias` above the tangent plane of the current pixel (normal-oriented hemisphere, with a range check), and darkens proportionally. Not as clean as GTAO (see the Multi-pass wave) but cheap, punchy, and single-pass.\",\n    \"CATEGORIES\": [\"Post-process\", \"Lighting\"],\n\n    \"PIPELINE_STATE\": {\n        \"DEPTH_TEST\": true,\n        \"DEPTH_COMPARE\": \"always\",\n        \"DEPTH_WRITE\": true\n    },\n\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\", \"DEPTH\": true, \"LABEL\": \"Scene color + depth\" },\n        { \"NAME\": \"camera\", \"TYPE\": \"uniform\", \"LABEL\": \"Camera matrices\",\n            \"LAYOUT\": [\n                { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n                { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n                { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n                { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n                { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n                { \"NAME\": \"params\",         \"TYPE\": \"vec4\" } ] },\n        { \"NAME\": \"radius\", \"TYPE\": \"float\", \"LABEL\": \"AO radius (pixels)\",\n          \"DEFAULT\": 8.0, \"MIN\": 1.0, \"MAX\": 40.0 },\n        { \"NAME\": \"bias\", \"TYPE\": \"float\", \"LABEL\": \"Height above the tangent plane (world units)\",\n          \"DEFAULT\": 0.01, \"MIN\": 0.0, \"MAX\": 5.0 },\n        { \"NAME\": \"intensity\", \"TYPE\": \"float\", \"LABEL\": \"Occlusion strength\",\n          \"DEFAULT\": 1.2, \"MIN\": 0.0, \"MAX\": 4.0 }\n    ]\n}*/\n\n#include \"depth_helpers.glsl\"\n\nvoid main()\n{\n    vec2  uv    = isf_FragNormCoord;\n    vec4  color = IMG_NORM_PIXEL(inputImage, uv);\n    float rawD  = IMG_DEPTH_NORM_PIXEL(inputImage, uv);\n\n    if (dh_isSky(rawD)) {\n        isf_FragColor = color; gl_FragDepth = rawD; return;\n    }\n\n    float eye0 = dh_linearizeDepth(rawD, camera.projection);\n    vec2 texel = 1.0 / RENDERSIZE;\n    mat4 invP = inverse(camera.projection);\n    vec3 P0 = dh_viewPosFromDepth(uv, rawD, invP);\n\n    // Tangent plane at this pixel. Counting \"nearer\" samples in a flat 2D\n    // disc (the first Crytek SSAO) makes every slanted plane occlude itself:\n    // a floor seen at an angle has its lower taps nearer than the centre, so\n    // the whole floor went grey. A sample only occludes if it rises above\n    // the tangent plane by more than `bias` -- the normal-oriented hemisphere\n    // test of later SSAO (e.g. McGuire et al., \"The Alchemy screen-space\n    // ambient obscurance algorithm\", HPG 2011).\n    vec3 N = dh_reconstructViewNormalImproved(uv, texel, rawD,\n        IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2( texel.x, 0.0)),\n        IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(-texel.x, 0.0)),\n        IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(0.0,  texel.y)),\n        IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(0.0, -texel.y)),\n        camera.projection);\n\n    // The sampling radius in world units at this depth: `radius` pixels\n    // times the size of one pixel at eye0 (2 * eye * tan(fov/2) / height,\n    // and projection[1][1] = 1 / tan(fov/2)).\n    float radiusWorld = radius * 2.0 * eye0 / (camera.projection[1][1] * RENDERSIZE.y);\n    float occ = 0.0;\n    const int NS = 8;\n    // Jittered sample angles per fragment so the 8 taps don't line up in\n    // screen space.\n    float rot = dh_ign(isf_FragCoord.xy) * DH_TWO_PI;\n    for (int i = 0; i < NS; ++i) {\n        float a = rot + DH_TWO_PI * float(i) / float(NS);\n        vec2 sUV = uv + vec2(cos(a), sin(a)) * radius * texel;\n        float dS = IMG_DEPTH_NORM_PIXEL(inputImage, sUV);\n        if (dS < DH_EPSILON) continue;  // skip sky\n        vec3 v = dh_viewPosFromDepth(sUV, dS, invP) - P0;\n        float dist = length(v);\n        // Range check (J. Chapman, \"SSAO tutorial\", 2013; LearnOpenGL\n        // \"SSAO\"): an occluder much farther away than the sampling radius\n        // is a different object in front, not something that occludes this\n        // point. Without it every pixel next to a silhouette got a halo.\n        if (dot(v, N) > bias) occ += smoothstep(0.0, 1.0, 2.0 * radiusWorld / max(dist, DH_EPSILON));\n    }\n    float ao = 1.0 - (occ / float(NS)) * intensity;\n    ao = clamp(ao, 0.0, 1.0);\n\n    isf_FragColor = vec4(color.rgb * ao, color.a);\n    gl_FragDepth = rawD;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/depth/Depth Micro AO.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"radius","Exposed":"radius","Value":{"Float":3.1351068019866943},"Init":{"Float":8.0},"Domain":{"Float":{"Min":1.0,"Max":40.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"bias","Exposed":"bias","Value":{"Float":0.47256818413734436},"Init":{"Float":0.009999999776482582},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"intensity","Exposed":"intensity","Value":{"Float":4.0},"Init":{"Float":1.2000000476837158},"Domain":{"Float":{"Min":0.0,"Max":4.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":30,"Metadata":{"ScriptingName":"Depth Contact Shadow","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[754.045575217417,-211.95623396765728],"Size":[302.0,146.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia team\",\n    \"ISFVSN\": \"2\",\n    \"MODE\": \"ISF\",\n    \"DESCRIPTION\": \"Contact shadow: raymarches the scene depth along a light direction for a few steps and shadows fragments whose ray hits closer geometry. Adds the tight contact darkening that regular shadow maps miss. Purely depth-based — no shadow map needed.\",\n    \"CATEGORIES\": [\"Post-process\", \"Lighting\"],\n\n    \"PIPELINE_STATE\": {\n        \"DEPTH_TEST\": true,\n        \"DEPTH_COMPARE\": \"always\",\n        \"DEPTH_WRITE\": true\n    },\n\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\", \"DEPTH\": true, \"LABEL\": \"Scene color + depth\" },\n        { \"NAME\": \"camera\", \"TYPE\": \"uniform\", \"LABEL\": \"Camera matrices\",\n            \"LAYOUT\": [\n                { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n                { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n                { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n                { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n                { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n                { \"NAME\": \"params\",         \"TYPE\": \"vec4\" } ] },\n        { \"NAME\": \"lightDir\", \"TYPE\": \"point3D\", \"LABEL\": \"Light direction (world, pointing FROM light TO scene)\",\n          \"DEFAULT\": [-0.5, -1.0, -0.3] },\n        { \"NAME\": \"rayLength\", \"TYPE\": \"float\", \"LABEL\": \"Ray length (world units)\",\n          \"DEFAULT\": 0.5, \"MIN\": 0.01, \"MAX\": 10.0 },\n        { \"NAME\": \"stepCount\", \"TYPE\": \"long\", \"LABEL\": \"Steps per ray\",\n          \"VALUES\": [4, 8, 16, 32], \"LABELS\": [\"4\", \"8\", \"16\", \"32\"], \"DEFAULT\": 8 },\n        { \"NAME\": \"thickness\", \"TYPE\": \"float\", \"LABEL\": \"Occluder thickness (world units)\",\n          \"DEFAULT\": 0.2, \"MIN\": 0.01, \"MAX\": 5.0 },\n        { \"NAME\": \"strength\", \"TYPE\": \"float\", \"LABEL\": \"Shadow strength\",\n          \"DEFAULT\": 0.7, \"MIN\": 0.0, \"MAX\": 1.0 }\n    ]\n}*/\n\n#include \"depth_helpers.glsl\"\n\nvoid main()\n{\n    vec2  uv    = isf_FragNormCoord;\n    vec4  color = IMG_NORM_PIXEL(inputImage, uv);\n    float rawD  = IMG_DEPTH_NORM_PIXEL(inputImage, uv);\n\n    if (dh_isSky(rawD)) {\n        isf_FragColor = color; gl_FragDepth = rawD; return;\n    }\n\n    // Reconstruct world position of this fragment.\n    mat4 invVP = inverse(camera.viewProjection);\n    vec3 worldPos = dh_worldPosFromDepth(uv, rawD, invVP);\n\n    // March TOWARD the light (opposite of lightDir).\n    vec3 L = normalize(-lightDir);\n    float stepLen = rayLength / float(stepCount);\n    float jitter = dh_ign(isf_FragCoord.xy) * stepLen;\n\n    float occluded = 0.0;\n    for (int i = 1; i <= stepCount; ++i) {\n        vec3 samplePos = worldPos + L * (jitter + float(i) * stepLen);\n        vec4 clip = camera.viewProjection * vec4(samplePos, 1.0);\n        if (clip.w <= 0.0) continue;\n        vec3 ndc = clip.xyz / clip.w;\n        vec2 sampleUV = ndc.xy * 0.5 + 0.5;\n        if (any(lessThan(sampleUV, vec2(0.0))) || any(greaterThan(sampleUV, vec2(1.0)))) continue;\n\n        float rayRawD  = ndc.z * 0.5 + 0.5;\n        float sceneRawD = IMG_DEPTH_NORM_PIXEL(inputImage, sampleUV);\n        // Reverse-Z: closer fragments have LARGER rawD. The scene occludes\n        // the ray if the scene's depth is > the ray's depth (closer) AND\n        // not TOO much closer (thickness gate).\n        float rayEye   = dh_linearizeDepth(rayRawD,   camera.projection);\n        float sceneEye = dh_linearizeDepth(sceneRawD, camera.projection);\n        if (sceneEye < rayEye && (rayEye - sceneEye) < thickness) {\n            occluded = 1.0;\n            break;\n        }\n    }\n\n    float ao = 1.0 - occluded * strength;\n    isf_FragColor = vec4(color.rgb * ao, color.a);\n    gl_FragDepth = rawD;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/depth/Depth Contact Shadow.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"lightDir","Exposed":"lightdir","Value":{"Vec3f":[-0.5,-1.0,-0.30000001192092896]},"Init":{"Vec3f":[-0.5,-1.0,-0.30000001192092896]},"Domain":{"Vec3f":{"Min":[-0.5,-1.0,-0.30000001192092896],"Max":[1.0,2.0,0.6000000238418579],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"rayLength","Exposed":"raylength","Value":{"Float":1.1370466947555542},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.009999999776482582,"Max":10.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"stepCount","Exposed":"stepcount","Value":{"Int":8},"Init":{"Int":8},"Domain":{"Int":{"Values":[4,8,16,32]}},"Values":[["4",{"Int":4}],["8",{"Int":8}],["16",{"Int":16}],["32",{"Int":32}]],"FolderPort":"","FileExtensions":""},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"thickness","Exposed":"thickness","Value":{"Float":2.3725578784942627},"Init":{"Float":0.20000000298023224},"Domain":{"Float":{"Min":0.009999999776482582,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"strength","Exposed":"strength","Value":{"Float":0.4356526732444763},"Init":{"Float":0.699999988079071},"Domain":{"Float":{"Min":0.0,"Max":1.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out"}]},{"uuid":"6e74b962-b102-4d2d-b6f1-850917e8c747","ObjectName":"avnd_vec3f","id":31,"Metadata":{"ScriptingName":"Vec3f","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[19.899300357816784,-31.483756868572378],"Size":[94.0,96.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"X","Exposed":"x","Value":{"Float":2.1537585258483887},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Y","Exposed":"y","Value":{"Float":-1.7951385974884033},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Z","Exposed":"z","Value":{"Float":1.2022823095321655},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Pair","Exposed":"pair"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":32,"Metadata":{"ScriptingName":"Depth Fake Point Light","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[1096.045575217417,-211.95623396765728],"Size":[302.0,223.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia team\",\n    \"ISFVSN\": \"2\",\n    \"MODE\": \"ISF\",\n    \"DESCRIPTION\": \"Fake point light: reconstructs world-space position from depth and adds a distance-attenuated light from a user-placed 3D position. Lambertian shading against the reconstructed normal. Move the light around with the `lightPos` control for a noir flashlight / torch effect.\",\n    \"CATEGORIES\": [\"Post-process\", \"Lighting\"],\n\n    \"PIPELINE_STATE\": {\n        \"DEPTH_TEST\": true,\n        \"DEPTH_COMPARE\": \"always\",\n        \"DEPTH_WRITE\": true\n    },\n\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\", \"DEPTH\": true, \"LABEL\": \"Scene color + depth\" },\n        { \"NAME\": \"camera\", \"TYPE\": \"uniform\", \"LABEL\": \"Camera matrices\",\n            \"LAYOUT\": [\n                { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n                { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n                { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n                { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n                { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n                { \"NAME\": \"params\",         \"TYPE\": \"vec4\" } ] },\n        { \"NAME\": \"lightPos\", \"TYPE\": \"point3D\", \"LABEL\": \"Light position (world units)\",\n          \"DEFAULT\": [0.0, 3.0, 0.0] },\n        { \"NAME\": \"lightColor\", \"TYPE\": \"color\", \"LABEL\": \"Light colour\",\n          \"DEFAULT\": [1.0, 0.95, 0.8, 1.0] },\n        { \"NAME\": \"lightIntensity\", \"TYPE\": \"float\", \"LABEL\": \"Light intensity\",\n          \"DEFAULT\": 8.0, \"MIN\": 0.0, \"MAX\": 100.0 },\n        { \"NAME\": \"falloff\", \"TYPE\": \"float\", \"LABEL\": \"Falloff exponent (2 = physical, lower = softer)\",\n          \"DEFAULT\": 2.0, \"MIN\": 0.1, \"MAX\": 5.0 }\n    ]\n}*/\n\n#include \"depth_helpers.glsl\"\n\nvoid main()\n{\n    vec2  uv    = isf_FragNormCoord;\n    vec4  color = IMG_NORM_PIXEL(inputImage, uv);\n    float rawD  = IMG_DEPTH_NORM_PIXEL(inputImage, uv);\n\n    if (dh_isSky(rawD)) {\n        isf_FragColor = color; gl_FragDepth = rawD; return;\n    }\n\n    // Reconstruct world position via inverse view-projection.\n    mat4 invVP = inverse(camera.viewProjection);\n    vec3 worldPos = dh_worldPosFromDepth(uv, rawD, invVP);\n\n    // Reconstruct normal in view space, then transform to world.\n    vec2 texel = 1.0 / RENDERSIZE;\n    float d0 = rawD;\n    float dR = IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2( texel.x, 0.0));\n    float dL = IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(-texel.x, 0.0));\n    float dU = IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(0.0,  texel.y));\n    float dD = IMG_DEPTH_NORM_PIXEL(inputImage, uv + vec2(0.0, -texel.y));\n    vec3 Nview = dh_reconstructViewNormalImproved(uv, texel, d0, dR, dL, dU, dD, camera.projection);\n\n    mat4 invView = inverse(camera.view);\n    vec3 Nworld = normalize((invView * vec4(Nview, 0.0)).xyz);\n\n    vec3 L = lightPos - worldPos;\n    float dist = length(L);\n    vec3 Lhat = L / max(dist, 0.0001);\n    float lambert = max(dot(Nworld, Lhat), 0.0);\n    float atten = lightIntensity / (1.0 + pow(dist, falloff));\n\n    vec3 lit = color.rgb + lightColor.rgb * lambert * atten;\n\n    isf_FragColor = vec4(lit, color.a);\n    gl_FragDepth = rawD;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/depth/Depth Fake Point Light.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"lightPos","Exposed":"lightpos","Value":{"Vec3f":[-0.3063909709453583,3.0,0.0]},"Init":{"Vec3f":[0.0,3.0,0.0]},"Domain":{"Ve