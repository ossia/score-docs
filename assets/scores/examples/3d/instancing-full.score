{"Document":{"ObjectName":"Scenario::ScenarioDocumentModel","id":1,"BaseScenario":{"ObjectName":"Scenario::BaseScenario","id":0,"Constraint":{"ObjectName":"Scenario::IntervalModel","id":0,"Metadata":{"ScriptingName":"instancing-full","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Inlet":{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Audio In","Exposed":"audio in"},"Outlet":{"uuid":"a1d97535-18ac-444a-8417-0cbc1692d897","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Audio Out","Exposed":"audio out","Address":"audio:/out/main","GainInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10000,"Hidden":false,"Custom":"Gain","Exposed":"gain","Value":{},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},"PanInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":2,"Metadata":{"ScriptingName":"Compute Shader.2","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[291.0,663.0],"Size":[226.0,175.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Simple orbital particle emitter — every slot is always alive and traces a deterministic orbit on a sphere whose radius breathes with TIME. No dead/alive bookkeeping, no auxiliary buffers. Drop-in source for Instancer.points: position drives per-instance translation, color drives per-instance color0.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"PARTICLES\"],\n  \"RESOURCES\": [\n    { \"NAME\": \"radius\",      \"TYPE\": \"float\", \"DEFAULT\": 1.0,  \"MIN\": 0.01, \"MAX\": 10.0 },\n    { \"NAME\": \"breathDepth\", \"TYPE\": \"float\", \"DEFAULT\": 0.3,  \"MIN\": 0.0,  \"MAX\": 1.0 },\n    { \"NAME\": \"breathSpeed\", \"TYPE\": \"float\", \"DEFAULT\": 1.0,  \"MIN\": 0.0,  \"MAX\": 10.0 },\n    { \"NAME\": \"orbitSpeed\",  \"TYPE\": \"float\", \"DEFAULT\": 0.5,  \"MIN\": 0.0,  \"MAX\": 5.0 },\n    { \"NAME\": \"spread\",      \"TYPE\": \"float\", \"DEFAULT\": 1.0,  \"MIN\": 0.0,  \"MAX\": 1.0 },\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"VERTEX_COUNT\": \"$USER\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\" },\n        { \"NAME\": \"color\",    \"SEMANTIC\": \"color0\",   \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\" }\n      ]\n    }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\n// PCG-flavoured 32-bit hash → [0,1). Deterministic per-particle so\n// the orbit parameters stay stable across frames; only TIME advances.\nfloat hash11(uint n)\n{\n  n = (n << 13u) ^ n;\n  n = n * (n * n * 15731u + 789221u) + 1376312589u;\n  return float(n & 0x7fffffffu) / float(0x7fffffff);\n}\n\nconst float TWO_PI = 6.28318530718;\nconst float PI     = 3.14159265359;\n\nvoid main()\n{\n  uint idx = gl_GlobalInvocationID.x;\n  uint count = uint(ISF_WRITE(geo, position).length());\n  if(idx >= count)\n    return;\n\n  // Five independent hashes per particle index. Each samples a\n  // different orbit parameter so neighbouring slots don't trace\n  // visually correlated paths.\n  float h0 = hash11(idx * 17u + 0u);   // azimuth phase at TIME=0\n  float h1 = hash11(idx * 17u + 1u);   // polar angle (clustered by `spread`)\n  float h2 = hash11(idx * 17u + 2u);   // angular velocity sign + magnitude\n  float h3 = hash11(idx * 17u + 3u);   // breath phase offset\n  float h4 = hash11(idx * 17u + 4u);   // hue offset\n\n  // Angular velocity: signed, scaled by orbitSpeed. Half the particles\n  // orbit clockwise and half counter-clockwise, which prevents the\n  // cloud from drifting in any one direction.\n  float omega = (h2 - 0.5) * 2.0 * orbitSpeed;\n\n  // Polar angle: `spread` controls how clustered around the equator\n  // the orbits are. spread=0 puts every particle on a single equatorial\n  // ring; spread=1 distributes them uniformly over the sphere.\n  float phi = acos(mix(0.0, 2.0 * h1 - 1.0, spread));\n\n  // Azimuth: deterministic phase plus TIME-driven sweep.\n  float theta = h0 * TWO_PI + omega * TIME;\n\n  // Radial breath. Each particle has its own phase offset h3 so the\n  // sphere doesn't pulse rigidly as a whole — particles flow in and\n  // out at different times, producing a swirling layered effect.\n  float radial = radius * (1.0 + breathDepth * sin(breathSpeed * TIME + h3 * TWO_PI));\n\n  vec3 pos = radial * vec3(\n      sin(phi) * cos(theta),\n      sin(phi) * sin(theta),\n      cos(phi));\n\n  ISF_WRITE(geo, position)[idx] = vec4(pos, 1.0);\n\n  // Color: HSV-ish hue from polar angle + per-particle offset.\n  // Cosine-palette gives a smooth continuous spectrum without abrupt\n  // colour cuts.\n  float hue = fract(phi / PI + h4);\n  vec3 col = 0.5 + 0.5 * cos(TWO_PI * (hue + vec3(0.0, 0.33, 0.67)));\n  ISF_WRITE(geo, color)[idx] = vec4(col, 1.0);\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/csf-last/OrbitParticles.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"radius","Exposed":"radius","Value":{"Float":10.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.009999999776482582,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"breathDepth","Exposed":"breathdepth","Value":{"Float":0.0},"Init":{"Float":0.30000001192092896},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"breathSpeed","Exposed":"breathspeed","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"orbitSpeed","Exposed":"orbitspeed","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"spread","Exposed":"spread","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"geo vertex count","Exposed":"geo vertex count","Value":{"Int":400},"Init":{"Int":1024},"Domain":{"Int":{"Min":1,"Max":536870911}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geo_out","Exposed":"geo_out"}]},{"uuid":"2f6a8c41-7d93-4e5b-b1c8-4e3f9a7d2c5b","ObjectName":"asset_loader","id":3,"Metadata":{"ScriptingName":"Asset Loader.3","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[286.0,451.0],"Size":[232.0,173.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"40833147-4c42-4b8b-bb80-0b1d15dae129","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Asset file","Exposed":"asset file","Value":{"String":"<PROJECT>:Models/DamagedHelmet.glb"},"Init":{"String":""},"Domain":{},"Filters":"3D assets (*.fbx *.gltf *.glb *.obj *.ply *.stl *.off *.splat *.spz *.usd *.usda *.usdc *.usdz)"},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Position","Exposed":"position","Value":{"Vec3f":[0.0,0.0,0.0]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[-8388608.0,-8388608.0,-8388608.0],"Max":[8388608.0,8388608.0,8388608.0],"Values":[[],[],[]]}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Rotation","Exposed":"rotation","Value"