0,-8388608.0],"Max":[8388608.0,8388608.0,8388608.0],"Values":[[],[],[]]}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":14,"Hidden":true,"Custom":"Rotation","Exposed":"rotation","Value":{"Vec3f":[0.0,0.0,0.0]},"Init":{"Vec3f":[0.0,0.0,0.0]},"Domain":{"Vec3f":{"Min":[0.0,0.0,0.0],"Max":[360.0,360.0,360.0],"Values":[[],[],[]]}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Scene","Exposed":"scene"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":17,"Metadata":{"ScriptingName":"Depth Neon Outlines","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[1335.685127842358,-219.03002418354927],"Size":[296.0,299.0],"Loops":false,"FoldMode":2,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia team\",\n    \"ISFVSN\": \"2\",\n    \"MODE\": \"ISF\",\n    \"DESCRIPTION\": \"Neon/Tron-style glowing outlines. Runs Sobel on depth, then convolves the edge mask with a small radial kernel to produce a soft glow bleed, then composites glow + hard edge back over the scene. Single-pass, but expensive (8 extra 3x3 depth gathers per pixel). Glow and edges are painted over the input, so they also show over a transparent sky.\",\n    \"CATEGORIES\": [\"Post-process\", \"Outlines\"],\n\n    \"PIPELINE_STATE\": {\n        \"DEPTH_TEST\": true,\n        \"DEPTH_COMPARE\": \"always\",\n        \"DEPTH_WRITE\": true\n    },\n\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\", \"DEPTH\": true,\n          \"LABEL\": \"Scene color + depth\" },\n\n        {\n            \"NAME\": \"camera\", \"TYPE\": \"uniform\",\n            \"LABEL\": \"Camera matrices\",\n            \"LAYOUT\": [\n                { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n                { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n                { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n                { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n                { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n                { \"NAME\": \"params\",         \"TYPE\": \"vec4\" }\n            ]\n        },\n\n        { \"NAME\": \"edgeColor\", \"TYPE\": \"color\",\n          \"LABEL\": \"Edge core colour\",\n          \"DEFAULT\": [1.0, 0.9, 0.95, 1.0] },\n        { \"NAME\": \"glowColor\", \"TYPE\": \"color\",\n          \"LABEL\": \"Glow halo colour\",\n          \"DEFAULT\": [1.0, 0.1, 0.6, 1.0] },\n\n        { \"NAME\": \"edgeThreshold\", \"TYPE\": \"float\",\n          \"LABEL\": \"Edge threshold (relative depth jump, 0.1 = 10%)\",\n          \"DEFAULT\": 0.08, \"MIN\": 0.0, \"MAX\": 5.0 },\n        { \"NAME\": \"edgeSoftness\", \"TYPE\": \"float\",\n          \"LABEL\": \"Edge softness (relative depth jump)\",\n          \"DEFAULT\": 0.04, \"MIN\": 0.0, \"MAX\": 2.0 },\n\n        { \"NAME\": \"glowRadius\", \"TYPE\": \"long\",\n          \"LABEL\": \"Glow radius (pixels)\",\n          \"VALUES\": [2, 3, 4, 6, 8, 12],\n          \"LABELS\": [\"2\", \"3\", \"4\", \"6\", \"8\", \"12\"],\n          \"DEFAULT\": 2 },\n\n        { \"NAME\": \"glowIntensity\", \"TYPE\": \"float\",\n          \"LABEL\": \"Glow intensity\",\n          \"DEFAULT\": 1.5, \"MIN\": 0.0, \"MAX\": 5.0 },\n\n        { \"NAME\": \"dimScene\", \"TYPE\": \"float\",\n          \"LABEL\": \"Scene dim\",\n          \"DEFAULT\": 0.5, \"MIN\": 0.0, \"MAX\": 1.0 }\n    ]\n}*/\n\n#include \"depth_helpers.glsl\"\n\nvoid main()\n{\n    vec2  uv    = isf_FragNormCoord;\n    vec4  color = IMG_NORM_PIXEL(inputImage, uv);\n    float rawD  = IMG_DEPTH_NORM_PIXEL(inputImage, uv);\n\n    vec2 texel = 1.0 / RENDERSIZE;\n\n    // Core edge at this pixel.\n    float nD[9];\n    DH_GATHER_DEPTH_3X3(inputImage, uv, texel, nD);\n    float coreEdge = dh_depthEdgeSobel(nD, camera.projection);\n    float coreMask = dh_smoothstep(edgeThreshold, edgeThreshold + edgeSoftness, coreEdge);\n\n    // Glow mask: sample the same edge test at 8 angular offsets around the\n    // pixel and take the max, producing a cheap dilation. Weight by a cosine\n    // falloff vs radius for a soft halo.\n    float glowMask = coreMask;\n    float radius = float(glowRadius);\n    const int STEPS = 8;\n    for (int i = 0; i < STEPS; ++i) {\n        float ang = 6.28318 * float(i) / float(STEPS);\n        vec2 off = vec2(cos(ang), sin(ang)) * radius * texel;\n        // Re-gather 3x3 around the offset sample. Yes this is a lot of taps;\n        // it's the price of staying single-pass.\n        DH_GATHER_DEPTH_3X3(inputImage, uv + off, texel, nD);\n        float e = dh_depthEdgeSobel(nD, camera.projection);\n        float m = dh_smoothstep(edgeThreshold, edgeThreshold + edgeSoftness, e);\n        glowMask = max(glowMask, m * 0.65);  // attenuated contribution\n    }\n\n    // Glow is added light: premultiplied, it adds to the dimmed scene and\n    // covers a transparent sky with its own strength.\n    vec3  glow = glowColor.rgb * glowMask * glowIntensity;\n    vec3  pm   = color.rgb * (1.0 - dimScene) * color.a + glow;\n    float a    = max(color.a, clamp(glowMask * glowIntensity, 0.0, 1.0));\n    vec4  withGlow = vec4(pm / max(a, DH_EPSILON), a);\n\n    isf_FragColor = dh_paintOver(withGlow, edgeColor.rgb, coreMask);\n    gl_FragDepth = rawD;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/depth/Depth Neon Outlines.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"edgeColor","Exposed":"edgecolor","Value":{"Vec4f":[1.0,0.8999999761581421,0.949999988079071,1.0]},"Init":{"Vec4f":[1.0,0.8999999761581421,0.949999988079071,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"glowColor","Exposed":"glowcolor","Value":{"Vec4f":[1.0,0.10000000149011612,0.6000000238418579,1.0]},"Init":{"Vec4f":[1.0,0.10000000149011612,0.6000000238418579,1.0]},"Domain":{}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"edgeThreshold","Exposed":"edgethreshold","Value":{"Float":0.07999999821186066},"Init":{"Float":0.07999999821186066},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"edgeSoftness","Exposed":"edgesoftness","Value":{"Float":0.39106056094169617},"Init":{"Float":0.03999999910593033},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"glowRadius","Exposed":"glowradius","Value":{"Int":12},"Init":{"Int":2},"Domain":{"Int":{"Values":[2,3,4,6,8,12]}},"Values":[["2",{"Int":2}],["3",{"Int":3}],["4",{"Int":4}],["6",{"Int":6}],["8",{"Int":8}],["12",{"Int":12}]],"FolderPort":"","FileExtensions":""},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"glowIntensity","Exposed":"glowintensity","Value":{"Float":4.115561008453369},"Init":{"Float":1.5},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"dimScene","Exposed":"dimscene","Value":{"Float":0.2765085995197296},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":18,"Metadata":{"ScriptingName":"Depth Halftone","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[912.513422936269,-211.74197581645075],"Size":[292.0,279.5],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n    \"CREDIT\": \"ossia team\",\n    \"ISFVSN\": \"2\",\n    \"MODE\": \"ISF\",\n    \"DESCRIPTION\": \"Newspaper-halftone dots whose dot frequency scales with depth: near = fine print, far = big coarse dots. Dot radius within each cell is driven by local luminance so the image still reads. Classic print-shop feel. By default the output is an opaque print: transparent areas of the input print as bare paper. With Transparent paper on, only the ink is drawn (in the ink colour) and the paper is transparent: alpha = ink coverage x input alpha, for layering the print over something else.\",\n    \"CATEGORIES\": [\"Post-process\", \"Stylise\"],\n\n    \"PIPELINE_STATE\": {\n        \"DEPTH_TEST\": true,\n        \"DEPTH_COMPARE\": \"always\",\n        \"DEPTH_WRITE\": true\n    },\n\n    \"INPUTS\": [\n        { \"NAME\": \"inputImage\", \"TYPE\": \"image\", \"DEPTH\": true, \"LABEL\": \"Scene color + depth\" },\n        { \"NAME\": \"camera\", \"TYPE\": \"uniform\", \"LABEL\": \"Camera matrices\",\n            \"LAYOUT\": [\n                { \"NAME\": \"view\",           \"TYPE\": \"mat4\" },\n                { \"NAME\": \"projection\",     \"TYPE\": \"mat4\" },\n                { \"NAME\": \"viewProjection\", \"TYPE\": \"mat4\" },\n                { \"NAME\": \"cameraPosition\", \"TYPE\": \"vec4\" },\n                { \"NAME\": \"renderSize\",     \"TYPE\": \"vec4\" },\n                { \"NAME\": \"params\",         \"TYPE\": \"vec4\" } ] },\n        { \"NAME\": \"dotsNear\", \"TYPE\": \"float\", \"LABEL\": \"Dots across screen (near)\",\n          \"DEFAULT\": 200.0, \"MIN\": 10.0, \"MAX\": 1000.0 },\n        { \"NAME\": \"dotsFar\", \"TYPE\": \"float\", \"LABEL\": \"Dots across screen (far)\",\n          \"DEFAULT\": 40.0, \"MIN\": 5.0, \"MAX\": 500.0 },\n        { \"NAME\": \"depthScale\", \"TYPE\": \"float\", \"LABEL\": \"Depth scale (world units)\",\n          \"DEFAULT\": 30.0, \"MIN\": 0.1, \"MAX\": 1000.0 },\n        { \"NAME\": \"dotAngle\", \"TYPE\": \"float\", \"LABEL\": \"Screen angle (degrees)\",\n          \"DEFAULT\": 45.0, \"MIN\": 0.0, \"MAX\": 180.0 },\n        { \"NAME\": \"inkColor\", \"TYPE\": \"color\", \"LABEL\": \"Ink colour\",\n          \"DEFAULT\": [0.0, 0.0, 0.0, 1.0] },\n        { \"NAME\": \"paperColor\", \"TYPE\": \"color\", \"LABEL\": \"Paper colour\",\n          \"DEFAULT\": [1.0, 1.0, 1.0, 1.0] },\n        { \"NAME\": \"transparentPaper\", \"TYPE\": \"bool\", \"LABEL\": \"Transparent paper\",\n          \"DEFAULT\": false }\n    ]\n}*/\n\n#include \"depth_helpers.glsl\"\n\nvoid main()\n{\n    vec2  uv    = isf_FragNormCoord;\n    vec4  color = IMG_NORM_PIXEL(inputImage, uv);\n    float rawD  = IMG_DEPTH_NORM_PIXEL(inputImage, uv);\n    float eye   = dh_linearizeDepth(rawD, camera.projection);\n    float t     = clamp(eye / depthScale, 0.0, 1.0);\n    float dots  = mix(dotsNear, dotsFar, t);\n\n    float ang = radians(dotAngle);\n    float c = cos(ang), s = sin(ang);\n    // Aspect-corrected so the cells (and dots) are round: `dots` counts\n    // them across the screen width.\n    vec2 p = (uv - 0.5) * vec2(1.0, RENDERSIZE.y / RENDERSIZE.x);\n    p = mat2(c, -s, s, c) * p;\n    vec2 cellP = p * dots;\n    vec2 cellF = fract(cellP) - 0.5;\n    float cellR = length(cellF);\n\n    // Opaque print: the input is laid on the paper first, so a transparent\n    // area prints as bare paper.\n    float luma = transparentPaper ? dh_luma(color.rgb)\n                                  : dh_luma(mix(paperColor.rgb, color.rgb, color.a));\n    // Dot fills more as luma goes down (ink). 0.5 is the cell corner.\n    float dotRadius = (1.0 - luma) * 0.55;\n    float dot_ = smoothstep(dotRadius + 0.05, dotRadius - 0.05, cellR)\n               * clamp(dotRadius / 0.05, 0.0, 1.0);  // white stays bare paper\n\n    if(transparentPaper)\n    {\n        isf_FragColor = vec4(inkColor.rgb, dot_ * color.a);\n    }\n    else\n    {\n        vec3 outRgb = mix(paperColor.rgb, inkColor.rgb, dot_);\n        isf_FragColor = vec4(outRgb, 1.0);\n    }\n    gl_FragDepth = rawD;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/depth/Depth Halftone.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"inputImage","Exposed":"inputimage","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"camera","Exposed":"camera","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"dotsNear","Exposed":"dotsnear","Value":{"Float":109.10559844970703},"Init":{"Float":200.0},"Domain":{"Float":{"Min":10.0,"Max":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"dotsFar","Exposed":"dotsfar","Value":{"Float":5.0},"Init":{"Float":40.0},"Domain":{"Float":{"Min":5.0,"Max":500.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"depthScale","Exposed":"depthscale","Value":{"Float":46.62409973144531},"Init":{"Float":30.0},"Domain":{"Float":{"Min":0.10000000149011612,"Max":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"dotAngle","Exposed":"dotangle","Value":{"Float":45.0},"Init":{"Float":45.0},"Domain":{"Float":{"Min":0.0,"Max":180.0}}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"inkColor","Exposed":"inkcolor","Value":{"Vec4f":[0.0,0.0,0.0