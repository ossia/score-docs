0]},"Domain":{"Float":{"Min":1.0,"Max":127.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Length","Exposed":"length","Description":"Bipolar random scaling of the note durations. Lengthening is always possible; shortening is bounded by the lookahead, since a note's duration is only known once its note-off arrives -- raise Early to shorten long notes.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Chance","Exposed":"chance","Description":"Probability that a note is played at all","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Chord","Exposed":"chord","Description":"Notes arriving within this window share a single timing deviation, so that chords are displaced as a whole instead of being smeared","Value":{"Vec2f":[0.0,0.0]},"Init":{"Vec2f":[0.019999999552965164,0.0]},"Domain":{"Vec2f":{"Min":[0.0,0.0],"Max":[0.10000000149011612,1.0],"Values":[[],[]]}}},{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"Spread","Exposed":"spread","Description":"Strum: delay between successive notes of a chord","Value":{"Vec2f":[0.000001937477009050781,0.0]},"Init":{"Vec2f":[0.0,0.0]},"Domain":{"Vec2f":{"Min":[0.0,0.0],"Max":[0.20000000298023224,1.0],"Values":[[],[]]}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"Channel","Exposed":"channel","Description":"MIDI channel (0 = all)","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":16}}},{"uuid":"73ae3e85-0c91-497e-b612-b1391f87ac72","ObjectName":"Inlet","id":11,"Hidden":true,"Custom":"Key range","Exposed":"key range","Description":"Only notes in this range are humanized","Value":{"Vec2f":[0.0,127