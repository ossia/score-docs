\tif (brightLevel < thresh)\n\t\t\tbrightLevel = 1.0;\n\t\telse\n\t\t\tbrightLevel = 0.0;\n\t}\n\tgl_FragColor = mix(freshPixel,stalePixel, brightLevel);\n}\n","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"thresh","Exposed":"thresh","Value":{"Float":0.42087262868881226},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"gain","Exposed":"gain","Value":{"Float":1.5084118843078613},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"hardCutoff","Exposed":"hardcutoff","Value":{"Bool":true},"Init":{},"Domain":{"Bool":null}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"invert","Exposed":"invert","Value":{"Bool":false},"Init":{},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false}]},{"uuid":"32dc5341-7748-4c31-a226-82e6bd685744","ObjectName":"VideoProcess","id":1,"Metadata":{"ScriptingName":"cat","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":27730080000,"Height":300.0,"StartOffset":0,"LoopDuration":3531528000,"Pos":[56.0,-22.0],"Size":[201.0,63.0],"Loops":true,"FoldMode":0,"Inlets":[],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false}],"FilePath":"<PROJECT>:cat.mov","Scale":0,"Playback":0,"Tempo":120.0,"IgnoreTempo":false,"OutputFormat":0,"Tonemap":8},{"uuid":"49047204-5c1e-4b54-9f43-2b583f664b2e","ObjectName":"Pattern","id":8,"Metadata":{"ScriptingName":"Bass","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":27730080000,"Heigh