ched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[29.068229496398377,-327.78007197936],"Size":[126.0,110.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"In","Exposed":"in","Address":"Camera:/","RenderSize":[128,128],"Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Threshold","Exposed":"threshold","Value":{"Float":150.0},"Init":{"Float":150.0},"Domain":{"Float":{"Min":0.0,"Max":255.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Range","Exposed":"range","Value":{"Float":10.0},"Init":{"Float":10.0},"Domain":{"Float":{"Min":0.0,"Max":255.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Pre-smooth","Exposed":"pre-smooth","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]},{"uuid":"898078f0-b825-4c29-a997-dc856e351a97","ObjectName":"point2d_view","id":14,"Metadata":{"ScriptingName":"Point2D View.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[409.68190947240385,76.02225282778352],"Size":[200.5368687559258,168.3554902157398],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"XY","Exposed":"xy","Value":{},"Init":{},"Domain":{}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Min X","Exposed":"min x","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Min Y","Exposed":"min y","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Max X","Exposed":"max x","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Max Y","Exposed":"max y","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-8388608.0,"Max":8388608.0}}}],"Outlets":[]},{"uuid":"4cf2f89f-45b6-4878-92ff-23d3cee1c67e","ObjectName":"object_filter","id":18,"Metadata":{"ScriptingName":"Object filter.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[172.3106334877101,-122.13663294366958],"Size":[227.0,55.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Input","Exposed":"input"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Filter","Exposed":"filter","Value":{"String":"[.[].centroid]"},"Init":{"String":""},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"bang","Exposed":"bang"}]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":19,"Metadata":{"ScriptingName":"Text Box","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[-99.74925567517502,-780.2718346322545],"Size":[441.0,113.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">ossia score supports traditional computer vision algorithms<br />and utilities, ported from the open-source cv.jit library.<br />Note that they are CPU-based thus you need to be mindful <br />of the texture resolution: 4K is a no-go ; use the controls in the inlet to <br />set lower input resolution to the CV objects. <br />Here they are all set to 128x128 which is usually enough for primitive blob<br />tracking.</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"2ef5f23f-2d22-4163-b299-976c9d9bd1c8","ObjectName":"avnd_point_tracker_2d","id":20,"Metadata":{"ScriptingName":"Point Tracker 2D","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[425.6136555498142,-124.97018855950834],"Size":[431.0,183.5],"Loops":false,"FoldMode":2,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Points","Exposed":"points","Description":"Detections for this frame. Accepts a list of vec2f, a list of vec3f read as (x, y, confidence), sub-lists [x, y] or [x, y, confidence], {position, confidence} maps as emitted by Blob stats, or one flat list of numbers [x, y, x, y, ...]."},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Max Speed","Exposed":"max speed","Description":"Fastest plausible object speed, in coordinate units per second - the primary association gate. 2 m/s suits human-scale motion in metric spaces; in [0,1] camera space 2.0 means crossing the frame in 0.5 s.","Value":{"Float":2.0},"Init":{"Float":2.0},"Domain":{"Float":{"Min":0.009999999776482582,"Max":100.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Motion Gate","Exposed":"motion gate","Description":"How to reject implausible jumps: Max Speed (analytic budget max_speed*dt*(1 + lost/coast)), Mahalanobis (chi-square on the Kalman innovation), or Off.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Max speed",{"Int":0}],["Mahalanobis",{"Int":1}],["Off",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Two-Stage Association","Exposed":"two-stage association","Description":"ByteTrack: after matching high-confidence detections, let low-confidence ones sustain still-unmatched recent tracks (they never birth or revive). Worth 1-10 IDF1 points on crowded scenes.","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"High Confidence","Exposed":"high confidence","Description":"Detections at or above this confidence are matched first and can sustain any track. Set it around the confidence your detector gives clearly-visible objects.","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Low Confidence","Exposed":"low confidence","Description":"Detections between this and High Confidence only run in the second-stage recovery: they can sustain an existing track through an occlusion dip but never start or revive one. Below this they are dropped.","Value":{"Float":0.10000000149011612},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"New Track Confidence","Exposed":"new track confidence","Description":"Minimum confidence for a detection to start a new track.","Value":{"Float":0.6000000238418579},"Init":{"Float":0.6000000238418579},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Direction Consistency","Exposed":"direction consistency","Description":"OC-SORT: penalize associations that reverse the track's direction of motion, averaged over 1-3 frame baselines so one noisy frame does not fake a turn. Helps crossings; 0 = off.","Value":{"Float":0.20000000298023224},"Init":{"Float":0.20000000298023224},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Confidence Modeling","Exposed":"confidence modeling","Description":"Hybrid-SORT: prefer the detection whose confidence continues the track's confidence trend (an occluded object's confidence sinks smoothly, so the trend tells crossing objects apart when position cannot). Needs a detector with meaningful per-detection confidence; 0 = off.","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.5}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"Motion Noise","Exposed":"motion noise","Description":"Kalman process noise: expected acceleration (units/s^2). Human motion peaks near 2 m/s^2; 0.67 fits that as 3 sigma. Raise for erratic motion, lower for very smooth coasting.","Value":{"Float":0.6700000166893005},"Init":{"Float":0.6700000166893005},"Domain":{"Float":{"Min":0.0010000000474974513,"Max":50.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"Position Noise","Exposed":"position noise","Description":"Detector jitter (standard deviation, coordinate units). Match it to your detector's actual noise: the association gates widen by this amount. Understating it makes a track reject its own noisy detections and be reborn under a new id; overstating it widens the gates until neighbouring entities compete for the same detection and swap.","Value":{"Float":0.012000000104308128},"Init":{"Float":0.004999999888241291},"Domain":{"Float":{"Min":0.00009999999747378752,"Max":1.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":11,"Hidden":true,"Custom":"Confirm Time","Exposed":"confirm time","Description":"Minimum age (milliseconds, not frames) before a track can be confirmed - stable across frame rates.","Value":{"Float":100.0},"Init":{"Float":100.0},"Domain":{"Float":{"Min":0.0,"Max":2000.0}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":12,"Hidden":true,"Custom":"Confirm Hits","Exposed":"confirm hits","Description":"A track is confirmed once it was detected in this many of the last Confirm Window detection frames (and is older than Confirm Time). Raise to demand more evidence before a track joins the stable set.","Value":{"Int":3},"Init":{"Int":3},"Domain":{"Int":{"Min":1,"Max":31}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":13,"Hidden":true,"Custom":"Confirm Window","Exposed":"confirm window","Description":"Size of the recent-frames window that Confirm Hits is counted over. A wider window tolerates more dropped frames on the way to confirmation.","Value":{"Int":5},"Init":{"Int":5},"Domain":{"Int":{"Min":1,"Max":31}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":14,"Hidden":true,"Custom":"Instant Confirm Above","Exposed":"instant confirm above","Description":"A detection at or above this confidence confirms its track immediately, skipping M-of-N. Set above 1 to disable.","Value":{"Float":0.8999999761581421},"Init":{"Float":0.8999999761581421},"Domain":{"Float":{"Min":0.0,"Max":1.0010000467300415}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":15,"Hidden":true,"Custom":"Emit Unconfirmed","Exposed":"emit unconfirmed","Description":"Emit provisional tracks immediately (flagged) instead of sitting out the ~100 ms confirmation latency. For musical onsets, keep this on and filter on the `provisional` field where it matters.","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":16,"Hidden":true,"Custom":"Coast Time","Exposed":"coast time","Description":"After a miss, keep emitting the Kalman-predicted position for this long (ms) before the track goes lost.","Value":{"Float":500.0},"Init":{"Float":500.0},"Domain":{"Float":{"Min":0.0,"Max":5000.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":17,"Hidden":true,"Custom":"Revive","Exposed":"revive","Description":"Keep lost tracks in memory after coasting ends, so an object that reappears nearby gets its old id back instead of a new one.","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":18,"Hidden":true,"Custom":"Revive Time","Exposed":"revive time","Description":"After coasting ends, keep the lost track (unemitted) for this long (ms); a matching detection revives it with its id intact.","Value":{"Float":2000.0},"Init":{"Float":2000.0},"Domain":{"Float":{"Min":0.0,"Max":10000.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":19,"Hidden":true,"Custom":"Re-update on Revive","Exposed":"re-update on revive","Description":"OC-SORT ORU: on revival, re-run the filter along a virtual trajectory across the gap, killing the post-occlusion lurch.","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":20,"Hidden":true,"Custom":"Smooth","Exposed":"smooth","Description":"One-Euro filter on the output positions (per track, per axis): removes detector jitter at rest with minimal lag during motion. Tune with Min Cutoff and Beta.","Value":{"Bool":false},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"5554eb67-bcc8-45ab-8ec2-37a3f191aa64","ObjectName":"Inlet","id":21,"Hidden":true,"Custom":"Min Cutoff","Exposed":"min cutoff","Description":"One-Euro cutoff at rest, Hz. Lower = smoother = laggier.","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.004999999888241291,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":22,"Hidden":true,"Custom":"Beta","Exposed":"beta","Description":"One-Euro speed coefficient: how much motion raises the cutoff. MediaPipe ships 10-80 on landmarks; raise it if fast motion lags.","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":100.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":23,"Hidden":true,"Custom":"Prediction Lead","Exposed":"prediction lead","Description":"Output position = estimate + velocity * lead (ms): compensates downstream latency at the price of overshoot.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":100.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":24,"Hidden":true,"Custom":"Output Deadband","Exposed":"output deadband","Description":"Suppress output changes smaller than this distance (coordinate units; ~half a pixel in normalized camera space). 0 = off.","Value":{"Float":0.0005000000237487257},"Init":{"Float":0.0005000000237487257},"Domain":{"Float":{"Min":0.0,"Max":0.10000000149011612}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":25,"Hidden":true,"Custom":"Slot Count","Exposed":"slot count","Description":"Size of the dense reusable slot bank (for mapping to a fixed set of voices/parameters). 0 disables slots.","Value":{"Int":8},"Init":{"Int":8},"Domain":{"Int":{"Min":0,"Max":64}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":26,"Hidden":true,"Custom":"Allocation","Exposed":"allocation","Description":"How a newly confirmed track picks a slot: Lowest Free (deterministic, cv.jit-style), Round Robin (spread reuse over the bank, so a dead voice gets time to fade), or Nearest Vacated (an object re-entering where one just left inherits that slot).","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Lowest free",{"Int":0}],["Round robin",{"Int":1}],["Nearest vacated",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":27,"Hidden":true,"Custom":"Steal Policy","Exposed":"steal policy","Description":"When every slot is taken and a new track confirms: Never (it stays unslotted until one frees up), or steal from the Stalest (unseen the longest) or Lowest Confidence track.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Never",{"Int":0}],["Stalest",{"Int":1}],["Lowest confidence",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":28,"Hidden":true,"Custom":"Hold Time","Exposed":"hold time","Description":"Quarantine (ms): a vacated slot is not handed to a new track for this long, so a brief dropout does not shuffle the whole bank.","Value":{"Float":250.0},"Init":{"Float":250.0},"Domain":{"Float":{"Min":0.0,"Max":5000.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":29,"Hidden":true,"Custom":"Order By","Exposed":"order by","Description":"Ordering of the compact outputs.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4]}},"Values":[["Id",{"Int":0}],["Slot",{"Int":1}],["Age",{"Int":2}],["Confidence",{"Int":3}],["Distance to anchor",{"Int":4}]],"FolderPort":"","FileExtensions":""},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":30,"Hidden":true,"Custom":"Anchor","Exposed":"anchor","Description":"Reference point for the Distance To Anchor ordering.","Value":{"Vec2f":[0.0,0.0]},"Init":{"Vec2f":[0.0,0.0]},"Domain":{"Vec2f":{"Min":[-1000.0,-1000.0],"Max":[1000.0,1000.0],"Values":[[],[]]}},"Integral":false},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":31,"Hidden":true,"Custom":"Data Format","Exposed":"data format","Description":"Positions/Ids layout: Compact = live tracks back-to-back in Order By order; Slots = Slot Count fixed positions indexed by slot, zero-padded (GPU/voice-bank friendly).","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1]}},"Values":[["Compact",{"Int":0}],["Slots",{"Int":1}]],"FolderPort":"","FileExtensions":""},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":32,"Hidden":true,"Custom":"Reset IDs","Exposed":"reset ids","Description":"Forget every track and restart ids from 1.","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Tracks","Exposed":"tracks","Description":"Every emitted track as a record: id, slot, state, creation_time, age, time_since_seen, position, position_raw, velocity, confidence, provisional, reacquired."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Count","Exposed":"count","Description":"Number of currently emitted tracks (confirmed + coasting + revived, plus provisional ones when Emit Unconfirmed is on)."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":2,"Hidden":false,"Custom":"Positions","Exposed":"positions","Description":"Flat [x,y,...] float list of the smoothed track positions, in the chosen Data Format. Cables directly into Point2D View, Array to Mesh, and other renderers."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":3,"Hidden":false,"Custom":"Ids","Exposed":"ids","Description":"Track id per entry of Positions (-1 for an empty slot in Slots format)."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":4,"Hidden":false,"Custom":"Entered","Exposed":"entered","Description":"Fires with the track id the instant a detection births a new track (before confirmation) - the lowest-latency onset signal."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":5,"Hidden":false,"Custom":"Confirmed","Exposed":"confirmed","Description":"Fires with the track id when a track passes confirmation and joins the stable set."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":6,"Hidden":false,"Custom":"Exited","Exposed":"exited","Description":"Fires with the track id when a track is removed for good (coast and revival windows exhausted). Use it to release voices/mappings."},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":7,"Hidden":false,"Custom":"Revived","Exposed":"revived","Description":"Fires with the track id when a lost track is re-acquired with its identity intact."}]},{"uuid":"7be51631-fb4b-4152-9ca7-86fdafa8a989","ObjectName":"Display","id":21,"Metadata":{"ScriptingName":"Text Box.22","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[416.85608013507215,-208.0644859392191],"Size":[335.0,53.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"in","Exposed":"in","Value":{"String":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Point Tracker objects try to give a fixed id </p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">to a given input point, to enable tracking.<br />The [x,y,... ] outlet outputs the positions with a stable id.</p></body></html>"},"Init":{"String":"(Double-click to edit)"},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Auto-reflow","Exposed":"auto-reflow","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}}],"Outlets":[]},{"uuid":"3127c11b-61d3-4d5e-a896-8b56e628dfbc","ObjectName":"avnd_arraytobuffer","id":22,"Metadata":{"ScriptingName":"Array to buffer","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[891.2623415670738,-126.89653272433353],"Size":[198.0,80.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Input","Exposed":"input"},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Type","Exposed":"type","Value":{"String":"Float32"},"Init":{"String":"Float32"},"Domain":{"String":{"Values":["Float32","Float64","SInt32","UInt32","SInt16","UInt16","SInt8","UInt8"]}},"Values":["Float32","Float64","SInt32","UInt32","SInt16","UInt16","SInt8","UInt8"],"Pixmaps":[]}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Output","Exposed":"output"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":23,"Metadata":{"ScriptingName":"Compute Shader","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":11289600000,"Height":300.0,"StartOffset":0,"LoopDuration":11289600000,"Pos":[1112.7561547491678,-124.48958001179162],"Size":[325.0,252.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"2D plot of moving points with their velocity. xyBuffer holds a flat [x, y, x, y, ...] array (e.g. Arraygen -> Array to buffer, Float32); the index of each pair is the point's id, and each id gets its own colour (golden-ratio hue). Every point is drawn as a disc, and an arrow leaving it shows the velocity: direction = direction of motion, length = speed * velocityScale. Velocity is measured only when a point's position actually changes: displacement / TIME elapsed since that id's previous sample, then low-pass filtered by 'smoothing' (per sample, not per frame), so an input slower than the frame rate does not flicker. If an id stops changing for longer than 'staleTime' its arrow decays to zero. Coordinates: inputMin..inputMax is stretched over the whole image; by default [0,1] with y = 0 at the top (image / blob-tracker convention), tick yUp for y = 0 at the bottom. Up to 256 ids.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Generator\", \"Visualization\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"xyBuffer\",\n      \"TYPE\": \"storage\",\n      \"ACCESS\": \"read_only\",\n      \"LAYOUT\": [\n        { \"NAME\": \"points\", \"TYPE\": \"vec2[]\" }\n      ],\n      \"DESCRIPTION\": \"Flat [x,y,x,y...] positions for this frame; pair index = id.\"\n    },\n    {\n      \"NAME\": \"state\",\n      \"TYPE\": \"storage\",\n      \"ACCESS\": \"read_write\",\n      \"LAYOUT\": [\n        { \"NAME\": \"prevPos\",  \"TYPE\": \"vec4[256]\" },\n        { \"NAME\": \"velocity\", \"TYPE\": \"vec4[256]\" }\n      ]\n    },\n    { \"NAME\": \"outputImage\", \"TYPE\": \"image\", \"ACCESS\": \"write_only\", \"WIDTH\": \"$WIDTH\", \"HEIGHT\": \"$HEIGHT\" },\n    { \"NAME\": \"inputMin\",      \"TYPE\": \"point2D\", \"DEFAULT\": [0.0, 0.0], \"MIN\": [-10000.0, -10000.0], \"MAX\": [10000.0, 10000.0] },\n    { \"NAME\": \"inputMax\",      \"TYPE\": \"point2D\", \"DEFAULT\": [1.0, 1.0], \"MIN\": [-10000.0, -10000.0], \"MAX\": [10000.0, 10000.0] },\n    { \"NAME\": \"yUp\",           \"TYPE\": \"bool\",  \"DEFAULT\": false },\n    { \"NAME\": \"pointRadius\",   \"TYPE\": \"float\", \"DEFAULT\": 6.0,  \"MIN\": 1.0,  \"MAX\": 50.0 },\n    { \"NAME\": \"lineWidth\",     \"TYPE\": \"float\", \"DEFAULT\": 1.5,  \"MIN\": 0.5,  \"MAX\": 10.0 },\n    { \"NAME\": \"velocityScale\", \"TYPE\": \"float\", \"DEFAULT\": 0.25, \"MIN\": 0.0,  \"MAX\": 5.0 },\n    { \"NAME\": \"smoothing\",     \"TYPE\": \"float\", \"DEFAULT\": 0.6,  \"MIN\": 0.0,  \"MAX\": 0.99 },\n    { \"NAME\": \"staleTime\",     \"TYPE\": \"float\", \"DEFAULT\": 0.25, \"MIN\": 0.0,  \"MAX\": 5.0 },\n    { \"NAME\": \"background\",    \"TYPE\": \"color\", \"DEFAULT\": [0.05, 0.05, 0.07, 1.0] }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [16, 16, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"2D_IMAGE\", \"TARGET\": \"outputImage\" } },\n    { \"LOCAL_SIZE\": [64, 1, 1],  \"EXECUTION_MODEL\": { \"TYPE\": \"MANUAL\", \"WORKGROUPS\": [4, 1, 1] } }\n  ]\n}*/\n\n// Pass 0 draws the plot: each pixel loops over the points (no write races).\n// Pass 1 stores this frame's positions / velocities for the next frame.\n\nconst uint MAX_POINTS = 256u;\n\nuint pointCount() { return min(uint(xyBuffer.points.length()), MAX_POINTS); }\n\n// Smoothed velocity (input units / second) of point i at position p, from\n// last frame's state. prevPos: xy = last *distinct* sample, z = 1 once the id\n// exists, w = TIME of that sample. TIMEDELTA is not used: it is the gap\n// between the last two scheduler ticks, not between rendered frames, so\n// dividing a frame's displacement by it gives huge, erratic speeds.\nvec2 currentVelocity(uint i, vec2 p)\n{\n  vec4 prev = state.prevPos[i];\n  vec2 oldVel = state.velocity[i].xy;\n  if(prev.z < 0.5)\n    return vec2(0.0);                // new id: no history yet\n\n  float dt = TIME - prev.w;\n  if(p == prev.xy)                   // no new sample this frame\n    return dt > staleTime ? oldVel * smoothing : oldVel;\n  if(dt < 1e-3)                      // paused, seek, or duplicate tick\n    return oldVel;\n\n  vec2 measured = (p - prev.xy) / dt;\n  return mix(measured, oldVel, smoothing);\n}\n\nvec3 idColor(uint i)\n{\n  float h = fract(float(i) * 0.61803398875);\n  vec3 k = clamp(abs(fract(h + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);\n  return mix(vec3(1.0), k, 0.75);\n}\n\nfloat sdSegment(vec2 p, vec2 a, vec2 b)\n{\n  vec2 pa = p - a, ba = b - a;\n  float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-8), 0.0, 1.0);\n  return length(pa - ba * h);\n}\n\n// Anti-aliased coverage of a shape at signed distance d with half-width w.\nfloat cover(float d, float w) { return clamp(w + 0.5 - d, 0.0, 1.0); }\n\nvoid drawPlot()\n{\n  ivec2 pix = ivec2(gl_GlobalInvocationID.xy);\n  ivec2 size = imageSize(outputImage);\n  if(pix.x >= size.x || pix.y >= size.y)\n    return;\n\n  // Input space -> pixels: inputMin..inputMax stretched over the image.\n  vec2 range = inputMax - inputMin;\n  range = vec2(abs(range.x) < 1e-6 ? 1.0 : range.x, abs(range.y) < 1e-6 ? 1.0 : range.y);\n  vec2 pxPerUnit = vec2(size) / range;\n  if(yUp)\n    pxPerUnit.y = -pxPerUnit.y;\n  vec2 origin = yUp ? vec2(0.0, float(size.y)) : vec2(0.0);\n  vec2 fragPx = vec2(pix) + 0.5;\n\n  vec3 col = background.rgb;\n\n  uint n = pointCount();\n  for(uint i = 0u; i < n; i++)\n  {\n    vec2 p = xyBuffer.points[i];\n    vec2 v = currentVelocity(i, p);\n    vec3 c = idColor(i);\n\n    vec2 pPx = origin + (p - inputMin) * pxPerUnit;\n    vec2 vPx = v * pxPerUnit * velocityScale;\n\n    // Cheap reject: skip points whose disc + arrow cannot reach this pixel.\n    float reach = pointRadius + length(vPx) + lineWidth + 2.0;\n    if(distance(fragPx, pPx) > reach)\n      continue;\n\n    float a = 0.0;\n    float len = length(vPx);\n    if(len > 1.0)\n    {\n      // Shaft, then a head of two 25-degree barbs.\n      vec2 tip = pPx + vPx;\n      vec2 dir = vPx / len;\n      float headLen = min(3.0 * pointRadius, 0.4 * len);\n      vec2 back = -dir * headLen;\n      const float cs = 0.9063, sn = 0.4226; // cos/sin 25 deg\n      vec2 b1 = vec2(cs * back.x - sn * back.y, sn * back.x + cs * back.y);\n      vec2 b2 = vec2(cs * back.x + sn * back.y, -sn * back.x + cs * back.y);\n\n      float d = sdSegment(fragPx, pPx, tip);\n      d = min(d, sdSegment(fragPx, tip, tip + b1));\n      d = min(d, sdSegment(fragPx, tip, tip + b2));\n      a = cover(d, lineWidth * 0.5);\n    }\n\n    // Disc with a dark outline so overlapping ids stay readable.\n    float dc = distance(fragPx, pPx);\n    col = mix(col, c, a);\n    col = mix(col, vec3(0.0), cover(dc, pointRadius + 1.0));\n    col = mix(col, c, cover(dc, pointRadius));\n  }\n\n  imageStore(outputImage, pix, vec4(col, 1.0));\n}\n\nvoid updateState()\n{\n  uint i = gl_GlobalInvocationID.x;\n  if(i >= MAX_POINTS)\n    return;\n\n  if(i >= pointCount())\n  {\n    // Id no longer present: forget it so it restarts cleanly if it comes back.\n    state.prevPos[i] = vec4(0.0);\n    state.velocity[i] = vec4(0.0);\n    return;\n  }\n\n  vec2 p = xyBuffer.points[i];\n  vec4 prev = state.prevPos[i];\n  state.velocity[i] = vec4(currentVelocity(i, p), 0.0, 0.0);\n  // Only a new sample moves the reference, so dt spans the real interval\n  // between input updates rather than one render frame.\n  if(prev.z < 0.5 || p != prev.xy)\n    state.prevPos[i] = vec4(p, 1.0, TIME);\n}\n\nvoid main()\n{\n  if(PASSINDEX == 0)\n    drawPlot();\n  else\n    updateState();\n}","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"xyBuffer","Exposed":"xybuffer","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"inputMin","Exposed":"inputmin","Value":{"Vec2f":[0.0,0.0]},"Init":{"Vec2f":[0.0,0.0]},"Domain":{"Vec2f":{"Min":[-10000.0,-10000.0],"Max":[10000.0,10000.0],"Values":[[],[]]}},"Integral":false},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"inputMax","Exposed":"inputmax","Value":{"Vec2f":[1.0,1.0]},"Init":{"Vec2f":[1.0,1.0]},"Domain":{"Vec2f":{"Min":[-10000.0,-10000.0],"Max":[10000.0,10000.0],"Values":[[],[]]}},"Integral":false},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"yUp","Exposed":"yup","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"pointRadius","Exposed":"pointradius","Value":{"Float":6.0},"Init":{"Float":6.0},"Domain":{"Float":{"Min":1.0,"Max":50.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"lineWidth","Exposed":"linewidth","Value":{"Float":1.5},"Init":{"Float":1.5},"Domain":{"Float":{"Min":0.5,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"velocityScale","Exposed":"velocityscale","Value":{"Float":0.25},"Init":{"Float":0.25},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"smoothing","Exposed":"smoothing","Value":{"Float":0.6000000238418579},"Init":{"Float":0.6000000238418579},"Domain":{"Float":{"Min":0.0,"Max":0.9900000095367432}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"In