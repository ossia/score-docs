every event in a tick."},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Log","Exposed":"log","Description":"Number of recent values to retain, newest first.","Value":{"Int":1},"Init":{"Int":1},"Domain":{"Int":{"Min":1,"Max":100}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Format","Exposed":"format","Description":"Ordinary text, indented Pretty text, or Hex bytes. Hex shows raw string bytes, including UTF-8 bytes, NUL and high-bit bytes. Numbers must be exact integers from 0 to 255; booleans are 00 or 01. Flat numeric lists and vectors use one byte per element. Empty strings and lists show [empty]. Other values show [not byte data] followed by ordinary text; no wrapping, truncation or memory reinterpretation.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Ordinary",{"Int":0}],["Pretty",{"Int":1}],["Hex",{"Int":2}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"3620ea94-5991-41cf-89b3-11f842cc39d0","ObjectName":"Outlet","id":0,"Hidden":true,"Custom":"values","Exposed":"values","Description":"Recent values and their sequence number for the display.","Value":{"Tuple":[{"Int":20502},{"Tuple":[{"Float":-1.0},{"Float":-1.0}]}]},"Domain":{}}]},{"uuid":"3f4a41f2-fa39-420f-ab0f-0af6b8409edb","ObjectName":"Display","id":20,"Metadata":{"ScriptingName":"Value display.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[525.6582975318512,542.9156718197457],"Size":[181.519643673283,23.668093433125364],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Input","Exposed":"input","Description":"Values to display, including every event in a tick."},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Lo