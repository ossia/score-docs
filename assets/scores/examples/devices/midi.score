0188c1f19c","ObjectName":"Inlet","id":10000,"Hidden":false,"Custom":"Gain","Exposed":"gain","Value":{},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},"PanInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true}]},{"uuid":"25c64b87-a44a-4fed-9f60-0a48906fd3ec","ObjectName":"MicroMapping","id":5,"Metadata":{"ScriptingName":"Micromap","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":7648319230,"Height":300.0,"StartOffset":0,"LoopDuration":7648319230,"Pos":[81.0,205.0],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in","Address":"MIDI In:/1/control/1"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"1- x / 127"},"Init":{"String":"x / 127"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]}],"SmallViewRack":[{"Processes":[1,2,3,4,5],"Process":null,"Height":306.0,"Nodal":true}],"FullViewRack":[{"Process":0,"Nodal":true}],"DefaultDuration":7648319230,"MinDuration":4073128340,"MaxDuration":4611686018427387903,"GuiDuration":7777782967,"Speed":1.0,"Rigidity":false,"MinNull":true,"MaxInf":true,"Signatures":[],"StartState":16,"EndState":17,"StartDate":916204907,"HeightPercentage":0.8072129222908183,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":-1.0,"Center":0,"NodalCenter":[156.0,110.0],"ViewMode":0,"SmallViewShown":true,"HasSignature":false}],"Comments":[{"ObjectName":"CommentBlockModel","id":1,"Date":1244843624,"HeightPercentage":0.013222067686601764,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">This example explains how to use MIDI devices in ossia score.<br /><br />First, look in the device explorer: if you see MIDI In (Disconnected)<br />in italic font, it means that no MIDI device was discovered.<br />You can right-click and pick the MIDI device you want, or pick the <br />computer keyboard.<br /></span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":2,"Date":7389391756,"HeightPercentage":0.006382939267501159,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">If you use the computer keyboard, the bindings are:<br /><br />- White keys are on the middle letter row of the keyboard <br />(qwerty: asdfghjkl / azerty: qsdfghjkl)<br />-  Black keys are on the row above<br />(qwerty: we tyu / azerty: ze tyu)<br /><br />The bottom row is: <br />qwerty: z: octave down, x: octave up, c: velocity down, v: velocity up<br />azerty: w: octave down, x: octave up, c: velocity down, v: velocity up<br /><br />Thus the complete (qwerty) keyboard looks like:<br /> _w_e __t__y__u__<br />a__s__d__f__g__h__j__k_...ssss<br /><br />or, with notes<br />__#__#____#__#__#_____<br />C__D__E__F__G__A__B__C<br /></span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":3,"Date":1244843624,"HeightPercentage":0.07617096183077317,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">By default, a MIDI device will have no child nodes.<br />If you just want to play with a synth, you can <br />directly drag the root node in the inlet of the synth, like below,<br />or select the MIDI In as input.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":4,"Date":1284678620,"HeightPercentage":0.23410566851459128,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">You can also do a MIDI learn to get access to the individual controls as nodes:<br />right-click on the MIDI In device while playback is stopped, and press &quot;Learn&quot;.<br />In this case, a few controls and notes were already learned.<br /><br />Note that there are two kinds of MIDI devices:<br />- Some MIDI devices use the &quot;Note Off&quot; MIDI message to signal, well, that a note is off.<br />- Some MIDI devices use the &quot;Note On&quot; message with a velocity value of zero, to signal note off.<br /><br />The MIDI In and MIDI Out devices have a setting to control this.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":5,"Date":1284678620,"HeightPercentage":0.3146215126419601,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">If your device sends normal note on and note off:<br />the trigger below will start the interval when the key is pressed.<br /><br />First, here are how react triggers in normal mode (e.g. not auto-trigger).<br />The triggers will go back in &quot;disabled&quot; mode after their execution<br />and thus need to be re-armed.<br /><br />This is usually what you'd want for starting / stopping clips as it allows you<br />to start / stop from the same key. Although you can directly use the Kabang <br />sampler for this if you simply want to play some samples on MIDI notes.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":6,"Date":1284678620,"HeightPercentage":0.4603910612756964,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">Then the same thing in auto-trigger mode: they re-arm automatically.<br />This is usually what you'd want when triggering short samples, etc.<br />to create a custom drum machine for instance.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":7,"Date":1175132381,"HeightPercentage":0.5706353415181624,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">You can use CCs to drive conditions: in this example, CC1 (modulation wheel)<br />will decide whether branch 1 or 2 is taken. The choice is made at the instant<br />the timeline reaches the point of the conditions.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":8,"Date":1165173632,"HeightPercentage":0.7427208719811356,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">Every MIDI parameter can of course also be used to drive <br />the controls of audio, video plug-ins, etc.<br />Range is automatically mapped from [0 -&gt; 127] to the range<br />of the control. For manual mapping, use one of the many <br />mapping objects available in score.<br /></span></p></body></html>"}]}],"SmallViewRack":[],"FullViewRack":[{"Process":1,"Nodal":false}],"DefaultDuration":12614113616,"MinDuration":12614113616,"MaxDuration":11854080000,"GuiDuration":13875524977,"Speed":1.0,"Rigidity":false,"MinNull":false,"MaxInf":true,"Signatures":[[0,[4,4]]],"StartState":0,"EndState":1,"StartDate":0,"HeightPercentage":0.0,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":16128000.0,"Center":4681620056,"ViewMode":0,"SmallViewShown":false,"HasSignature":true},"StartTimeNode":{"ObjectName":"Scenario::TimeSyncModel","id":0,"Metadata":{"ScriptingName":"Sync.start","Comment":"","Color":"Gray","Label":"","Touched":true},"Date":0,"Events":[0],"MusicalSync":-1.0,"AutoTrigger":false,"Start":true,"Active":false,"Expression":" { true == false } "},"EndTimeNode":{"ObjectName":"Scenario::TimeSyncModel","id":1,"Metadata":{"ScriptingName":"Sync.end","Comment":"","Color":"Gray","Label":"","Touched":true},"Date":12614113616,"Events":[1],"MusicalSync":-1.0,"AutoTrigger":false,"Start":false,"Active":true,"Expression":" { t