ntModel","id":327081301,"Previous":null,"Following":1,"Start":[0.0,0.6775252693577817],"End":[0.5202821869488536,0.9433333333333334],"Power":1.0},{"uuid":"1e7cb83f-4e47-4b14-814d-2242a9c75991","ObjectName":"CurveSegmentModel","id":1,"Previous":327081301,"Following":null,"Start":[0.5202821869488536,0.9433333333333334],"End":[1.0,0.06085858846965589],"Power":1.0}]},"Tween":true}],"SmallViewRack":[{"Processes":[1,2],"Process":2,"Height":44.0,"Nodal":false}],"FullViewRack":[{"Process":1,"Nodal":false},{"Process":2,"Nodal":false}],"DefaultDuration":1979301363,"MinDuration":1979301363,"MaxDuration":1979301363,"GuiDuration":2177231499,"Speed":1.0,"Rigidity":true,"MinNull":false,"MaxInf":false,"Signatures":[],"StartState":10,"EndState":11,"StartDate":7814505854,"HeightPercentage":0.33456561922365996,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":2827573.3757142858,"Center":0,"ViewMode":0,"SmallViewShown":true,"HasSignature":false}],"Comments":[{"ObjectName":"CommentBlockModel","id":1,"Date":457480032,"HeightPercentage":0.016255083179297608,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Once you've got a hold of the various processes available<br />in score, it's time to learn to actually score them over time.<br /><br />There are a few ways:<br />1) To automate a port directly, you can right-click on it and press &quot;Create automation&quot;: <br />this will create an automation on the same interval.<br /><br />You can loop an automation from the inspector.<br /><br />You can also drag&amp;drop the port into a separate interval or in the background of<br />the Scenario to create an automation there instead.</p></body></html>"},{"ObjectName":"CommentBlockModel","id":2,"Date":644206575,"HeightPercentage":0.27800369685767096,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">It's also possible to save the state of a given process in cues: <br />to do this, drag the small folder icon (the preset list, at the left <br />of the name of each process) in a cue, to save its current state there.<br />Note that this will save the entire state, including for instance the shader.<br />You can opt to save only the controls by holding Ctrl / Cmd while dropping,<br />which will allow you to choose.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":3,"Date":5209670569,"HeightPercentage":0.289463955637708,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">Just like any OSC address <br />in the device explorer, you can create sequences<br />(see Auto-sequence in the settings), update them<br />through the snapshot button, etc.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":4,"Date":457480032,"HeightPercentage":0.4646950092421442,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">For instance, to easily recall some cues, you can double-click in the background to create a new <br />unconnected cue, and then drag your set of parameters: </span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":5,"Date":485489013,"HeightPercentage":0.5297597042513863,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">Finally, every parameter is also accessible over OSC &amp; OSCQuery for remote control.<br />You can copy the address of a port by right-clicking on it and pressing &quot;Copy address&quot;, <br />as well as looking it up in the &quot;score&quot; (Local) device in the device explorer to the left.</span></p></body></html>"}]}],"SmallViewRack":[],"FullViewRack":[{"Process":1,"Nodal":false}],"DefaultDuration":10584000000,"MinDuration":10584000000,"MaxDuration":11113200000,"GuiDuration":11642400000,"Speed":1.0,"Rigidity":false,"MinNull":false,"MaxInf":true,"Signatures":[[0,[4,4]]],"StartState":0,"EndState":1,"StartDate":0,"HeightPercentage":0.0,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":15120000.0,"Center":0,"ViewMode":0,"SmallViewShown":false,"HasSignature":true},"StartTimeNode":{"ObjectName":"Scenario::TimeSyncModel","id":0,"Metadata":{"ScriptingName":"Sync.start","Comment":"","Color":"Gray","Label":"","Touched":true},"Date":0,"Events":[0],"MusicalSync":-1.0,"AutoTrigger":false,"Start":true,"Active":false,"Expression":" { true == false } "},"EndTimeNode":{"ObjectName":"Scenario::TimeSyncModel","id":1,"Metadata":{"ScriptingName":"Sync.end","Comment":"","Color":"Gray","Label":"","Touched":true},"Date":10584000000,"Events":[1],"MusicalSync":-1.0,"AutoTrigger":false,"Start":false,"Active":true,"Expression":" { true == false } "},"StartEvent":{"ObjectName":"Scenario::EventModel","id":0,"Metadata":{"ScriptingName":"Event.start","Comment":"","Color":"Emphasis4","Label":"","Touched":true},"TimeNode":0,"States":[0],"Condition":"","Date":0,"Offset":0},"EndEvent":{"ObjectName":"Scenario::EventModel","id":1,"Metadata":{"ScriptingName":"Event.end","Comment":"","Color":"Emphasis4","Label":"","Touched":true},"TimeNode":1,"States":[1],"Condition":"","Date":10584000000,"Offset":0},"StartState":{"ObjectName":"Scenario::StateModel","id":0,"Metadata":{"ScriptingName":"State.start","Comment":"","Color":"Base1","Label":"","Touched":true},"Event":0,"