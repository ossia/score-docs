2-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":1,"Metadata":{"ScriptingName":"03-01_mandelbulb","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":8820000000,"Height":300.0,"StartOffset":0,"LoopDuration":8820000000,"Pos":[-273.0,27.0],"Size":[178.0,137.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Mandelbulb (White / Nylander, power-n spherical formula) as a density: each voxel stores its escape iteration divided by Iterations (1 = never escaped, i.e. inside the set), so the field is stepped in 1/Iterations levels. An iso just below 1 shows the bulb. Zoom is the half-width of the sampled region (larger = more of the fractal, smaller on screen). Power drift oscillates the power over time and morphs the fractal.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"FRACTAL\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"power\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 8.0,\n      \"MIN\": 2.0,\n      \"MAX\": 16.0,\n      \"LABEL\": \"Power\"\n    },\n    {\n      \"NAME\": \"zoom\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.3,\n      \"MIN\": 0.5,\n      \"MAX\": 4.0,\n      \"LABEL\": \"Extent (zoom out)\"\n    },\n    {\n      \"NAME\": \"iters\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 8,\n      \"MIN\": 4,\n      \"MAX\": 16,\n      \"LABEL\": \"Iterations\"\n    },\n    {\n      \"NAME\": \"animate\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.0,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Power drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    float Power = power + animate*sin(TIME);\n    vec3 z = pc * zoom;\n    vec3 c = z;\n    float r = 0.0;\n    int It = int(iters);\n    int esc = It;\n    for(int i=0; i<It; i++){\n        r = length(z);\n        if(r > 2.0){ esc = i; break; }\n        float theta = acos(z.z/r);\n        float phi = atan(z.y, z.x);\n        float zr = pow(r, Power);\n        theta *= Power; phi *= Power;\n        z = zr*vec3(sin(theta)*cos(phi), sin(phi)*sin(theta), cos(theta));\n        z += c;\n    }\n    float v = float(esc)/float(It);\n    imageStore(volume, pos, vec4(vec3(v), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/03-fractals/03-01_mandelbulb.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"power","Exposed":"power","Value":{"Float":6.585353374481201},"Init":{"Float":8.0},"Domain":{"Float":{"Min":2.0,"Max":16.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"zoom","Exposed":"zoom","Value":{"Float":1.5880050659179688},"Init":{"Float":1.2999999523162842},"Domain":{"Float":{"Min":0.5,"Max":4.0}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"iters","Exposed":"iters","Value":{"Int":8},"Init":{"Int":8},"Domain":{"Int":{"Min":4,"Max":16}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"animate","Exposed":"animate","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":2,"Metadata":{"ScriptingName":"VolumeRaymarcher","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":8820000000,"Height":300.0,"StartOffset":0,"LoopDuration":8820000000,"Pos":[-55.0,29.0],"Size":[403.0,176.0],"Loops":false,"FoldMode":0,"Vertex":"","Fragment":"/*{\n  \"DESCRIPTION\": \"Volumetric raymarcher for 3D textures: renders the volume (the unit cube) as a translucent cloud, coloured by its rgb, with density taken from alpha (or from rgb brightness when alpha is 1 everywhere). densityScale x absorption sets how opaque it gets, threshold hides faint density, steps trades quality for speed. Optional gradient lighting (lightDir, lightStrength, ambientLight). Orbit camera: cameraAngle and cameraPitch in radians, cameraDistance from the centre, autoRotate in radians per second. Outside the cloud the output is transparent, so it composites over whatever is below. Connect any 3D texture producer to the 'volume' input.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"ALPHA\": \"premultiplied\",\n  \"CATEGORIES\": [\"Renderer\", \"3D\", \"Volume\"],\n  \"INPUTS\": [\n    { \"NAME\": \"volume\", \"TYPE\": \"image\", \"DIMENSIONS\": 3 },\n    {\n      \"NAME\": \"steps\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 128,\n      \"MIN\": 16,\n      \"MAX\": 512\n    },\n    {\n      \"NAME\": \"densityScale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 10.0,\n      \"MIN\": 0.1,\n      \"MAX\": 50.0\n    },\n    {\n      \"NAME\": \"threshold\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.02,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"absorption\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.5,\n      \"MIN\": 0.0,\n      \"MAX\": 10.0\n    },\n    {\n      \"NAME\": \"cameraAngle\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.0,\n      \"MIN\": -3.14159,\n      \"MAX\": 3.14159\n    },\n    {\n      \"NAME\": \"cameraPitch\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.3,\n      \"MIN\": -1.5,\n      \"MAX\": 1.5\n    },\n    {\n      \"NAME\": \"cameraDistance\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.5,\n      \"MIN\": 0.5,\n      \"MAX\": 10.0\n    },\n    {\n      \"NAME\": \"autoRotate\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.3,\n      \"MIN\": 0.0,\n      \"MAX\": 3.0\n    },\n    {\n      \"NAME\": \"lightDir\",\n      \"TYPE\": \"point3D\",\n      \"DEFAULT\": [0.5, 0.8, 0.3],\n      \"MIN\": [-1.0, -1.0, -1.0],\n      \"MAX\": [1.0, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"lightStrength\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.2,\n      \"MIN\": 0.0,\n      \"MAX\": 5.0\n    },\n    {\n      \"NAME\": \"ambientLight\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.25,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"enableLighting\",\n      \"TYPE\": \"bool\",\n      \"DEFAULT\": true\n    }\n  ]\n}*/\n\n// Ray-AABB intersection for unit cube [0,1]³\nvec2 intersectBox(vec3 ro, vec3 rd)\n{\n  vec3 invRd = 1.0 / rd;\n  vec3 t0 = -ro * invRd;\n  vec3 t1 = (1.0 - ro) * invRd;\n  vec3 tmin = min(t0, t1);\n  vec3 tmax = max(t0, t1);\n  float tNear = max(max(tmin.x, tmin.y), tmin.z);\n  float tFar  = min(min(tmax.x, tmax.y), tmax.z);\n  return vec2(tNear, tFar);\n}\n\n// Estimate gradient normal via central differences\nvec3 gradientNormal(vec3 pos, float eps)\n{\n  float dx = texture(volume, pos + vec3(eps, 0, 0)).a\n           - texture(volume, pos - vec3(eps, 0, 0)).a;\n  float dy = texture(volume, pos + vec3(0, eps, 0)).a\n           - texture(volume, pos - vec3(0, eps, 0)).a;\n  float dz = texture(volume, pos + vec3(0, 0, eps)).a\n           - texture(volume, pos - vec3(0, 0, eps)).a;\n  vec3 g = vec3(dx, dy, dz);\n  float len = length(g);\n  return len > 0.0001 ? g / len : vec3(0.0, 1.0, 0.0);\n}\n\nvoid main()\n{\n  vec2 uv = isf_FragNormCoord * 2.0 - 1.0;\n  uv.x *= RENDERSIZE.x / RENDERSIZE.y;\n\n  // Orbit camera around volume center\n  vec3 center = vec3(0.5);\n  float angle = cameraAngle + TIME * autoRotate;\n  float cp = cos(cameraPitch);\n  vec3 eye = center + cameraDistance * vec3(cos(angle) * cp, sin(cameraPitch), sin(angle) * cp);\n\n  vec3 forward = normalize(center - eye);\n  vec3 right   = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));\n  vec3 up      = cross(right, forward);\n  vec3 rd      = normalize(forward * 1.5 + uv.x * right + uv.y * up);\n\n  // Intersect ray with volume bounding box\n  vec2 tHit = intersectBox(eye, rd);\n  if(tHit.x > tHit.y || tHit.y < 0.0)\n  {\n    isf_FragColor = vec4(0.0);\n    return;\n  }\n  tHit.x = max(tHit.x, 0.0);\n\n  // Raymarching setup\n  int numSteps = int(steps);\n  float stepSize = (tHit.y - tHit.x) / float(numSteps);\n\n  // Jitter start to reduce banding\n  float jitter = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);\n  float t = tHit.x + stepSize * jitter;\n\n  vec3 L = normalize(lightDir);\n  float gradEps = 1.5 / 128.0; // ~1 texel for gradient estimation\n\n  vec4 accum = vec4(0.0);\n\n  for(int i = 0; i < numSteps; i++)\n  {\n    if(accum.a > 0.99)\n      break;\n\n    vec3 pos = eye + rd * t;\n    vec4 samp = texture(volume, pos);\n\n    // Density: alpha when the producer uses it (alpha < 1 somewhere), else the\n    // luminance of rgb. Most shaderlib/volume generators store density in rgb\n    // with alpha fixed at 1; the old \"fall back only when alpha == 0\" test\n    // read those as a uniformly opaque cube and rendered it black.\n    float density = samp.a < 0.999 ? samp.a : dot(samp.rgb, vec3(0.299, 0.587, 0.114));\n\n    if(density > threshold)\n    {\n      vec3 color = samp.rgb;\n\n      // Gradient-based lighting\n      if(enableLighting)\n      {\n        // Density grows inward, so its gradient points into the blob; the\n        // outward surface normal is -grad (Levoy, \"Display of Surfaces from\n        // Volume Data\", IEEE CG&A 1988). Using +grad lit the far side.\n        vec3 N = -gradientNormal(pos, gradEps);\n        float NdotL = max(dot(N, L), 0.0);\n        float lighting = ambientLight + (1.0 - ambientLight) * NdotL * lightStrength;\n        color *= lighting;\n      }\n\n      // Beer-Lambert absorption\n      float alpha = 1.0 - exp(-density * densityScale * stepSize * absorption);\n\n      // Front-to-back compositing\n      accum.rgb += (1.0 - accum.a) * color * alpha;\n      accum.a   += (1.0 - accum.a) * alpha;\n    }\n\n    t += stepSize;\n  }\n\n  isf_FragColor = accum;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/renderers/VolumeRaymarcher.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"steps","Exposed":"steps","Value":{"Float":54.4525260925293},"Init":{"Float":128.0},"Domain":{"Float":{"Min":16.0,"Max":512.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"densityScale","Exposed":"densityscale","Value":{"Float":2.3051767349243164},"Init":{"Float":10.0},"Domain":{"Float":{"Min":0.10000000149011612,"Max":50.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"threshold","Exposed":"threshold","Value":{"Float":0.7775252461433411},"Init":{"Float":0.019999999552965164},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"absorption","Exposed":"absorption","Value":{"Float":1.6085858345031738},"Init":{"Float":1.5},"Domain":{"Float":{"Min":0.0,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"cameraAngle","Exposed":"cameraangle","Value":{"Float":-2.759204626083374},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-3.141590118408203,"Max":3.141590118408203}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"cameraPitch","Exposed":"camerapitch","Value":{"Float":0.532575786113739},"Init":{"Float":0.30000001192092896},"Domain":{"Float":{"Min":-1.5,"Max":1.5}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"cameraDistance","Exposed":"cameradistance","Value":{"Float":0.9198232293128967},"Init":{"Float":2.5},"Domain":{"Float":{"Min":0.5,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"autoRotate","Exposed":"autorotate","Value":{"Float":0.0},"Init":{"Float":0.30000001192092896},"Domain":{"Float":{"Min":0.0,"Max":3.0}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"lightDir","Exposed":"lightdir","Value":{"Vec3f":[0.5,0.800000011920929,0.30000001192092896]},"Init":{"Vec3f":[0.5,0.800000011920929,0.30000001192092896]},"Domain":{"Vec3f":{"Min":[-1.0,-1.0,-1.0],"Max":[1.0,1.0,1.0],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"lightStrength","Exposed":"lightstrength","Value":{"Float":3.6376261711120605},"Init":{"Float":1.2000000476837158},"Domain":{"Float":{"Min":0.0,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":11,"Hidden":true,"Custom":"ambientLight","Exposed":"ambientlight","Value":{"Float":0.4941919147968292},"Init":{"Float":0.25},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":12,"Hidden":true,"Custom":"enableLighting","Exposed":"enablelighting","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"d2a67bd8-5d3f-404e-b6e9-e350cf2a833f","ObjectName":"Automation","id":3,"Metadata":{"ScriptingName":"Automation (float).3","Comment":"","Color":"Transparent1","Label":"","Touched":false},"Duration":8820000000,"Height":300.0,"StartOffset":0,"LoopDuration":8820000000,"Pos":[392.0,392.0],"Size":[200.0,100.0],"Loops":true,"FoldMode":0,"Outlet":{"uuid":"047e4cc2-4d99-4e8b-bf98-206018d02274","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out","MinInlet":{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Min","Exposed":"min","Value":{"Float":2.0},"Init":{},"Domain":{}},"MaxInlet":{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"Max","Exposed":"max","Value":{"Float":16.0},"Init":{},"Domain":{}}},"Curve":{"ObjectName":"CurveModel","id":45345,"Segments":[{"uuid":"1e7cb83f-4e47-4b14-814d-2242a9c75991","ObjectName":"CurveSegmentModel","id":1267626728,"Previous":null,"Following":-38688215,"Start":[0.0,0.32752524103437153],"End":[0.2243386243386243,1.0],"Power":6.964404506368992},{"uuid":"1e7cb83f-4e47-4b14-814d-2242a9c75991","ObjectName":"CurveSegmentModel","id":-38688215,"Previous":1267626728,"Following":-390999866,"Start":[0.2243386243386243,1.0],"End":[0.2634920634920635,0.125],"Power":9.713559075160376},{"uuid":"1e7cb83f-4e47-4b14-814d-2242a9c75991","ObjectName":"CurveSegmentModel","id":-390999866,"Previous":-38688215,"Following":0,"Start":[0.2634920634920635,0.125],"End":[0.6232804232804233,1.0],"Power":6.773962498900221},{"uuid":"1e7cb83f-4e47-4b14-814d-2242a9c75991","ObjectName":"CurveSegmentModel","id":0,"Previous":-390999866,"Following":null,"Start":[0.6232804232804233,1.0],"End":[1.0,0.32752524103437153],"Power":6.062866266041591}]},"Tween":false}],"SmallViewRack":[{"Processes":[1,2],"Process":null,"Height":220.0,"Nodal":true},{"Processes":[3],"Process":3,"Height":72.0,"Nodal":false}],"FullViewRack":[{"Process":0,"Nodal":true},{"Process":3,"Nodal":false}],"DefaultDuration":8820000000,"MinDuration":8820000000,"MaxDuration":4611686018427387903,"GuiDuration":9702000000,"Speed":1.0,"Rigidity":false,"MinNull":true,"MaxInf":true,"Signatures":[],"StartState":1,"EndState":2,"StartDate":513497995,"HeightPercentage":0.11185089340727042,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":-1.0,"Center":0,"NodalCenter":[129.0,98.5],"ViewMode":0,"SmallViewShown":true,"HasSignature":false},{"ObjectName":"Scenario::IntervalModel","id":2,"Metadata":{"ScriptingName":"Raymarch.1","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Inlet":{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Audio In","Exposed":"audio in"},"Outlet":{"uuid":"a1d97535-18ac-444a-8417-0cbc1692d897","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Audio Out","Exposed":"audio out","GainInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10000,"Hidden":false,"Custom":"Gain","Exposed":"gain","Value":{},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},"PanInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":1,"Metadata":{"ScriptingName":"mandelbulb2","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":8820000000,"Height":300.0,"StartOffset":0,"LoopDuration":8820000000,"Pos":[-273.0,24.0],"Size":[146.0,137.0],"Loops":false,"Scriptable":true,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Mandelbulb (White / Nylander, power-n spherical formula) as a density: each voxel stores its escape iteration divided by Iterations (1 = never escaped, i.e. inside the set), so the field is stepped in 1/Iterations levels. An iso just below 1 shows the bulb. Zoom is the half-width of the sampled region (larger = more of the fractal, smaller on screen). Power drift oscillates the power over time and morphs the fractal.\",\n  \"CREDIT\": \"ossia 3D catalog\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\n    \"3D-GENERATOR\",\n    \"FRACTAL\"\n  ],\n  \"INPUTS\": [\n    {\n      \"NAME\": \"power\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 8.0,\n      \"MIN\": 2.0,\n      \"MAX\": 16.0,\n      \"LABEL\": \"Power\"\n    },\n    {\n      \"NAME\": \"zoom\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.3,\n      \"MIN\": 0.5,\n      \"MAX\": 4.0,\n      \"LABEL\": \"Extent (zoom out)\"\n    },\n    {\n      \"NAME\": \"iters\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 8,\n      \"MIN\": 4,\n      \"MAX\": 16,\n      \"LABEL\": \"Iterations\"\n    },\n    {\n      \"NAME\": \"animate\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.0,\n      \"MIN\": 0.0,\n      \"MAX\": 2.0,\n      \"LABEL\": \"Power drift\"\n    }\n  ],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"volume\",\n      \"TYPE\": \"image\",\n      \"ACCESS\": \"write_only\",\n      \"WIDTH\": \"64\",\n      \"HEIGHT\": \"64\",\n      \"DEPTH\": \"64\"\n    }\n  ],\n  \"PASSES\": [\n    {\n      \"LOCAL_SIZE\": [\n        4,\n        4,\n        4\n      ],\n      \"EXECUTION_MODEL\": {\n        \"TYPE\": \"3D_IMAGE\",\n        \"TARGET\": \"volume\"\n      }\n    }\n  ]\n}*/\n\nvoid main()\n{\n    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);\n    ivec3 size = imageSize(volume);\n    if(any(greaterThanEqual(pos, size))) return;\n    vec3 p  = (vec3(pos) + 0.5) / vec3(size);   // [0,1]^3\n    vec3 pc = p * 2.0 - 1.0;                     // [-1,1]^3\n\n    float Power = power + animate*sin(TIME);\n    vec3 z = pc * zoom;\n    vec3 c = z;\n    float r = 0.0;\n    int It = int(iters);\n    int esc = It;\n    for(int i=0; i<It; i++){\n        r = length(z);\n        if(r > 2.0){ esc = i; break; }\n        float theta = acos(z.z/r);\n        float phi = atan(z.y, z.x);\n        float zr = pow(r, Power);\n        theta *= Power; phi *= Power;\n        z = zr*vec3(sin(theta)*cos(phi), sin(phi)*sin(theta), cos(theta));\n        z += c;\n    }\n    float v = float(esc)/float(It);\n    imageStore(volume, pos, vec4(vec3(v), 1.0));\n\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/volume/03-fractals/03-01_mandelbulb.cs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"power","Exposed":"power","Value":{"Float":9.852020263671875},"Init":{"Float":8.0},"Domain":{"Float":{"Min":2.0,"Max":16.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"zoom","Exposed":"zoom","Value":{"Float":2.2296717166900635},"Init":{"Float":1.2999999523162842},"Domain":{"Float":{"Min":0.5,"Max":4.0}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"iters","Exposed":"iters","Value":{"Int":8},"Init":{"Int":8},"Domain":{"Int":{"Min":4,"Max":16}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"animate","Exposed":"animate","Value":{"Float":0.7550504803657532},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":2.0}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume"}]},{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":2,"Metadata":{"ScriptingName":"raymarch2","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":8820000000,"Height":300.0,"StartOffset":0,"LoopDuration":8820000000,"Pos":[-55.0,29.0],"Size":[403.0,176.0],"Loops":false,"Scriptable":true,"FoldMode":0,"Vertex":"","Fragment":"/*{\n  \"DESCRIPTION\": \"Volumetric raymarcher for 3D textures: renders the volume (the unit cube) as a translucent cloud, coloured by its rgb, with density taken from alpha (or from rgb brightness when alpha is 1 everywhere). densityScale x absorption sets how opaque it gets, threshold hides faint density, steps trades quality for speed. Optional gradient lighting (lightDir, lightStrength, ambientLight). Orbit camera: cameraAngle and cameraPitch in radians, cameraDistance from the centre, autoRotate in radians per second. Outside the cloud the output is transparent, so it composites over whatever is below. Connect any 3D texture producer to the 'volume' input.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"ALPHA\": \"premultiplied\",\n  \"CATEGORIES\": [\"Renderer\", \"3D\", \"Volume\"],\n  \"INPUTS\": [\n    { \"NAME\": \"volume\", \"TYPE\": \"image\", \"DIMENSIONS\": 3 },\n    {\n      \"NAME\": \"steps\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 128,\n      \"MIN\": 16,\n      \"MAX\": 512\n    },\n    {\n      \"NAME\": \"densityScale\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 10.0,\n      \"MIN\": 0.1,\n      \"MAX\": 50.0\n    },\n    {\n      \"NAME\": \"threshold\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.02,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"absorption\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.5,\n      \"MIN\": 0.0,\n      \"MAX\": 10.0\n    },\n    {\n      \"NAME\": \"cameraAngle\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.0,\n      \"MIN\": -3.14159,\n      \"MAX\": 3.14159\n    },\n    {\n      \"NAME\": \"cameraPitch\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.3,\n      \"MIN\": -1.5,\n      \"MAX\": 1.5\n    },\n    {\n      \"NAME\": \"cameraDistance\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 2.5,\n      \"MIN\": 0.5,\n      \"MAX\": 10.0\n    },\n    {\n      \"NAME\": \"autoRotate\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.3,\n      \"MIN\": 0.0,\n      \"MAX\": 3.0\n    },\n    {\n      \"NAME\": \"lightDir\",\n      \"TYPE\": \"point3D\",\n      \"DEFAULT\": [0.5, 0.8, 0.3],\n      \"MIN\": [-1.0, -1.0, -1.0],\n      \"MAX\": [1.0, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"lightStrength\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.2,\n      \"MIN\": 0.0,\n      \"MAX\": 5.0\n    },\n    {\n      \"NAME\": \"ambientLight\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.25,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"enableLighting\",\n      \"TYPE\": \"bool\",\n      \"DEFAULT\": true\n    }\n  ]\n}*/\n\n// Ray-AABB intersection for unit cube [0,1]³\nvec2 intersectBox(vec3 ro, vec3 rd)\n{\n  vec3 invRd = 1.0 / rd;\n  vec3 t0 = -ro * invRd;\n  vec3 t1 = (1.0 - ro) * invRd;\n  vec3 tmin = min(t0, t1);\n  vec3 tmax = max(t0, t1);\n  float tNear = max(max(tmin.x, tmin.y), tmin.z);\n  float tFar  = min(min(tmax.x, tmax.y), tmax.z);\n  return vec2(tNear, tFar);\n}\n\n// Estimate gradient normal via central differences\nvec3 gradientNormal(vec3 pos, float eps)\n{\n  float dx = texture(volume, pos + vec3(eps, 0, 0)).a\n           - texture(volume, pos - vec3(eps, 0, 0)).a;\n  float dy = texture(volume, pos + vec3(0, eps, 0)).a\n           - texture(volume, pos - vec3(0, eps, 0)).a;\n  float dz = texture(volume, pos + vec3(0, 0, eps)).a\n           - texture(volume, pos - vec3(0, 0, eps)).a;\n  vec3 g = vec3(dx, dy, dz);\n  float len = length(g);\n  return len > 0.0001 ? g / len : vec3(0.0, 1.0, 0.0);\n}\n\nvoid main()\n{\n  vec2 uv = isf_FragNormCoord * 2.0 - 1.0;\n  uv.x *= RENDERSIZE.x / RENDERSIZE.y;\n\n  // Orbit camera around volume center\n  vec3 center = vec3(0.5);\n  float angle = cameraAngle + TIME * autoRotate;\n  float cp = cos(cameraPitch);\n  vec3 eye = center + cameraDistance * vec3(cos(angle) * cp, sin(cameraPitch), sin(angle) * cp);\n\n  vec3 forward = normalize(center - eye);\n  vec3 right   = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));\n  vec3 up      = cross(right, forward);\n  vec3 rd      = normalize(forward * 1.5 + uv.x * right + uv.y * up);\n\n  // Intersect ray with volume bounding box\n  vec2 tHit = intersectBox(eye, rd);\n  if(tHit.x > tHit.y || tHit.y < 0.0)\n  {\n    isf_FragColor = vec4(0.0);\n    return;\n  }\n  tHit.x = max(tHit.x, 0.0);\n\n  // Raymarching setup\n  int numSteps = int(steps);\n  float stepSize = (tHit.y - tHit.x) / float(numSteps);\n\n  // Jitter start to reduce banding\n  float jitter = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);\n  float t = tHit.x + stepSize * jitter;\n\n  vec3 L = normalize(lightDir);\n  float gradEps = 1.5 / 128.0; // ~1 texel for gradient estimation\n\n  vec4 accum = vec4(0.0);\n\n  for(int i = 0; i < numSteps; i++)\n  {\n    if(accum.a > 0.99)\n      break;\n\n    vec3 pos = eye + rd * t;\n    vec4 samp = texture(volume, pos);\n\n    // Density: alpha when the producer uses it (alpha < 1 somewhere), else the\n    // luminance of rgb. Most shaderlib/volume generators store density in rgb\n    // with alpha fixed at 1; the old \"fall back only when alpha == 0\" test\n    // read those as a uniformly opaque cube and rendered it black.\n    float density = samp.a < 0.999 ? samp.a : dot(samp.rgb, vec3(0.299, 0.587, 0.114));\n\n    if(density > threshold)\n    {\n      vec3 color = samp.rgb;\n\n      // Gradient-based lighting\n      if(enableLighting)\n      {\n        // Density grows inward, so its gradient points into the blob; the\n        // outward surface normal is -grad (Levoy, \"Display of Surfaces from\n        // Volume Data\", IEEE CG&A 1988). Using +grad lit the far side.\n        vec3 N = -gradientNormal(pos, gradEps);\n        float NdotL = max(dot(N, L), 0.0);\n        float lighting = ambientLight + (1.0 - ambientLight) * NdotL * lightStrength;\n        color *= lighting;\n      }\n\n      // Beer-Lambert absorption\n      float alpha = 1.0 - exp(-density * densityScale * stepSize * absorption);\n\n      // Front-to-back compositing\n      accum.rgb += (1.0 - accum.a) * color * alpha;\n      accum.a   += (1.0 - accum.a) * alpha;\n    }\n\n    t += stepSize;\n  }\n\n  isf_FragColor = accum;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/renderers/VolumeRaymarcher.fs","Inlets":[{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"volume","Exposed":"volume","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"steps","Exposed":"steps","Value":{"Float":409.919189453125},"Init":{"Float":128.0},"Domain":{"Float":{"Min":16.0,"Max":512.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"densityScale","Exposed":"densityscale","Value":{"Float":28.91851043701172},"Init":{"Float":10.0},"Domain":{"Float":{"Min":0.10000000149011612,"Max":50.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"threshold","Exposed":"threshold","Value":{"Float":0.7775252461433411},"Init":{"Float":0.019999999552965164},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"absorption","Exposed":"absorption","Value":{"Float":5.775252342224121},"Init":{"Float":1.5},"Domain":{"Float":{"Min":0.0,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"cameraAngle","Exposed":"cameraangle","Value":{"Float":1.8484607934951782},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-3.141590118408203,"Max":3.141590118408203}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"cameraPitch","Exposed":"camerapitch","Value":{"Float":0.1825757622718811