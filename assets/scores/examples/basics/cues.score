9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[],"SmallViewRack":[],"FullViewRack":[],"DefaultDuration":533773348,"MinDuration":533773348,"MaxDuration":2241848063,"GuiDuration":2394622650,"Speed":1.0,"Rigidity":false,"MinNull":true,"MaxInf":false,"Signatures":[],"StartState":21,"EndState":22,"StartDate":7775779325,"HeightPercentage":0.3914689688906301,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":-1.0,"Center":0,"ViewMode":0,"SmallViewShown":false,"HasSignature":false}],"Comments":[{"ObjectName":"CommentBlockModel","id":1,"Date":1137630506,"HeightPercentage":0.07100524683997138,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">These two states change the color <br />parameter in the OSC:/ tree </span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":2,"Date":5229536188,"HeightPercentage":0.05962119405358136,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">Three individual states, <br />can be triggered independently</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":3,"Date":5215109881,"HeightPercentage":0.22372008903728433,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">Cues connected by time intervals can only ever trigger <br />in order, starting from the first.<br /><br />It's possible to set a minimum allowed time to <br />go from one cue to another, as well as a maximum time after<br />which we will trigger or a fixed forced time between two cues.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":4,"Date":1139678231,"HeightPercentage":0.3091832938019633,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">If there is no end trigger, the processes will <br />stop at the end as the time interval finishes.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":5,"Date":1139678231,"HeightPercentage":0.6243796700722319,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">If there is an end trigger, everything keeps<br />processing. Both processes are set to loop <br />in their inspector, thus they keep repeating forever.<br />Open both intervals in full view to see the difference.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":6,"Date":5263409964,"HeightPercentage":0.4330175913396482,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">The tween parameter will interpolate the first segment of the automation<br />from the current value in the device explorer instead of the value drawn in<br />the curve, to ensure that there isn't any sudden jump of parameter.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":7,"Date":9162228685,"HeightPercentage":0.058333333333333334,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:12px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">Finally, take a look at the first and the last state, at the very top of the score.<br />You may have to de-zoom a bit.<br /><br />The first one is always triggered when starting<br />playback - useful to set an initial clear state.<br />It will also be triggered when pressing the &quot;Stop and reinitialize&quot; <br />button (the fourth one), which is useful for instance to automatically<br />turn on lights when stopping the score.<br /><br />The second (and last, there are only two at the top), is the stop cue,<br />which will be recalled when stop is pressed. They are also recalled <br />when sending the /play  /global_play or /stop messages over OSC to score.</span></p></body></html>"}]},{"uuid":"de035912-5b03-49a8-bc4d-b2cba68e21d9","ObjectName":"Scenario","id":4,"Metadata":{"ScriptingName":"Scenario-nonexclusive","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":13823654197,"Height":268.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[280.0,280.0],"Size":[200.0,100.0],"Loops":false