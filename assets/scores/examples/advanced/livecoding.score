:"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[{"uuid":"74ca45ff-92c9-44a0-8f1a-754dea05ee1b","ObjectName":"gfxProcess","id":1,"Metadata":{"ScriptingName":"SpaceSpore","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":8008305373,"Height":300.0,"StartOffset":0,"LoopDuration":8008305373,"Pos":[40.0,40.0],"Size":[252.0,177.0],"Loops":false,"FoldMode":0,"ScriptEditorPlacement":"Central","Vertex":"void main() {\n\tisf_vertShaderInit();\n}","Fragment":"/*{\n    \"CATEGORIES\": [\n        \"generator\",\n        \"sphere\"\n    ],\n    \"CREDIT\": \"by mojovideotech\",\n    \"DESCRIPTION\": \"\",\n    \"INPUTS\": [\n        {\n            \"DEFAULT\": [\n                0.5,\n                0.3\n            ],\n            \"MAX\": [\n                0.99,\n                0.99\n            ],\n            \"MIN\": [\n                0.01,\n                0.01\n            ],\n            \"NAME\": \"O\",\n            \"TYPE\": \"point2D\"\n        },\n        {\n            \"DEFAULT\": [\n                0.1,\n                0.5\n            ],\n            \"MAX\": [\n                1,\n                1\n            ],\n            \"MIN\": [\n                0,\n                0\n            ],\n            \"NAME\": \"C\",\n            \"TYPE\": \"point2D\"\n        },\n        {\n            \"DEFAULT\": 9,\n            \"MAX\": 36,\n            \"MIN\": 0,\n            \"NAME\": \"R1\",\n            \"TYPE\": \"float\"\n        },\n        {\n            \"DEFAULT\": 17,\n            \"MAX\": 54,\n            \"MIN\": 0,\n            \"NAME\": \"R2\",\n            \"TYPE\": \"float\"\n        },\n        {\n            \"DEFAULT\": 2.0,\n            \"MAX\": 5.0,\n            \"MIN\": 1.1,\n            \"NAME\": \"zoom\",\n            \"TYPE\": \"float\"\n        },\n        {\n            \"DEFAULT\": 1.5,\n            \"MAX\": 3,\n            \"MIN\": -3,\n            \"NAME\": \"rate\",\n            \"TYPE\": \"float\"\n        },\n        {\n            \"DEFAULT\": 64,\n            \"MAX\":\t72,\n            \"MIN\": 24,\n            \"NAME\": \"depth\",\n            \"TYPE\": \"float\"\n        },\n        {\n            \"DEFAULT\": 0.55,\n            \"MAX\": 1.25,\n            \"MIN\": 0.25,\n            \"NAME\": \"gamma\",\n            \"TYPE\": \"float\"\n        }\n    ],\n    \"ISFVSN\": \"2\",\n    \"VSN\": \"2\"\n}\n*/\n\n\n////////////////////////////////////////////////////////////////////\n// SpaceSpore  by mojovideotech\n// v2.0 5/2020 ; optimized code, added uniforms\n//\n// based on :\n// shadertoy.com/lslcWj   by LukeRissacher\n//\n// License Creative Commons Attribution-NonCommercial-ShareAlike 3.0\n////////////////////////////////////////////////////////////////////\n\n\n#define \ttwpi  \t6.283185307179586  \t\n#define \tR(p, a) p = p * cos(a) + vec2(-p.y, p.x) * sin(a)\n\nfloat Swave(float w) { return 0.5 + 0.5 * sin(twpi * w); }\n\nfloat Sdef(vec3 p) { return 1.0 - abs(sin(p.x) + sin(p.y) + sin(p.z)) * 0.333; }\n\nfloat Smap(vec3 p, float s) {\n    float dSphere = length(p) - 1.0;\n    return max(dSphere, (0.95 - Sdef(s * p)) / s);\n}\n\nvec3 Scol(vec3 p) {\n    float a = clamp((2.0 - length(p)) * 0.5, 0.0, 1.0);\n    vec3 c = 0.5 + 0.5 * cos(twpi * cross(vec3(1.0, C.x, C.y), vec3(Swave(-a) * vec3(0.5, 1.0, 1.0))));\n    return c * a;\n}\n\nvec3 rgb(vec3 c) { return c*c*c*(c*(c*6.0-15.0)+10.0); }\n\nvoid main() {\n\tfloat TT = TIME * rate; \n\tvec3 rd = normalize(vec3(2.0 * gl_FragCoord.xy - RENDERSIZE.xy, -min(RENDERSIZE.x,RENDERSIZE.y)));\n    vec3 ro = vec3(0.0, 0.0, zoom); \n    R(rd.xz, O.x * -TT);\n    R(ro.xz, O.x * -TT);\n    R(rd.yz, O.y * TT);\n    R(ro.yz, O.y * TT);\n    float t = 0.0;\n    vec3 col = vec3(0.0);\n    float S = mix(R1, R2, Swave(0.05 * TT));\n    for (int i = 0; i < 90; i++) {\n    \tif (float(i) >= floor(depth)) { break; }\n        vec3 p = ro + t * rd;\n        float d = Smap(p, S);\n        if (t > 5.0 || d < 0.001) {\n            break;\n        }\n        t += 1.8 * d;\n        col += 0.05 * Scol(p);\n    }\n    gl_FragColor = vec4(pow(rgb(col),vec3(gamma)),1.0);\n}\n","Root":"<LIBRARY>:packages/default/Presets/GLSL_shaders/gitizenme/SpaceSpore.fs","Inlets":[{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"O","Exposed":"o","Value":{"Vec2f":[0.5,0.30000001192092896]},"Init":{"Vec2f":[0.5,0.30000001192092896]},"Domain":{"Vec2f":{"Min":[0.009999999776482582,0.009999999776482582],"Max":[0.9900000095367432,0.9900000095367432],"Values":[[],[]]}},"Integral":false},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"C","Exposed":"c","Value":{"Vec2f":[0.10000000149011612,0.5]},"Init":{"Vec2f":[0.10000000149011612,0.5]},"Domain":{"Vec2f":{"Min":[0.0,0.0],"Max":[1.0,1.0],"Values":[[],[]]}},"Integral":false},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"R1","Exposed":"r1","Value":{"Float":8.861538887023926},"Init":{"Float":9.0},"Domain":{"Float":{"Min":0.0,"Max":36.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"R2","Exposed":"r2","Value":{"Float":36.5538444519043},"Init":{"Float":17.0},"Domain":{"Float":{"Min":0.0,"Max":54.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"zoom","Exposed":"zoom","Value":{"Float":1.7000000476837158},"Init":{"Float":2.0},"Domain":{"Float":{"Min":1.100000023841858,"Max":5.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"rate","Exposed":"rate","Value":{"Float":1.5},"Init":{"Float":1.5},"Domain":{"Float":{"Min":-3.0,"Max":3.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"depth","Exposed":"depth","Value":{"Float":64.0},"Init":{"Float":64.0},"Domain":{"Float":{"Min":24.0,"Max":72.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"gamma","Exposed":"gamma","Value":{"Float":0.7166666388511658},"Init":{"Float":0.550000011920929},"Domain":{"Float":{"Min":0.25,"Max":1.25}}}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]}],"SmallViewRack":[{"Processes":[1],"Process":null,"Height":221.0,"Nodal":true}],"FullViewRack":[{"Process":0,"Nodal":true}],"DefaultDuration":8008305373,"MinDuration":8008305373,"MaxDuration":4611686018427387903,"GuiDuration":8113268322,"Speed":1.0,"Rigidity":false,"MinNull":true,"MaxInf":true,"Signatures":[],"StartState":3,"EndState":4,"StartDate":672215558,"HeightPercentage":0.5071506849315067,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":-1.0,"Center":0,"NodalCenter":[163.0,118.5],"ViewMode":0,"SmallViewShown":true,"HasSignature":false},{"ObjectName":"Scenario::IntervalModel","id":3,"Metadata":{"ScriptingName":"JSui","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Inlet":{"uuid":"a1574bb0-cbd4-4c7d-9417-0c25cfd1187b","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Audio In","Exposed":"audio in"},"Outlet":{"uuid":"a1d97535-18ac-444a-8417-0cbc1692d897","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Audio Out","Exposed":"audio out","GainInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10000,"Hidden":false,"Custom":"Gain","Exposed":"gain","Value":{},"Init":{},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},"PanInlet":{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":10001,"Hidden":false,"Custom":"Pan","Exposed":"pan","Value":{},"Init":{},"Domain":{}},"Gain":1.0,"Pan":[1.0,1.0],"Propagate":true},"Processes":[{"uuid":"9906e563-ddeb-4ecd-908c-952baee2a0a5","ObjectName":"SignalDisplay","id":4,"Metadata":{"ScriptingName":"Signal display","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":8008305373,"Height":300.0,"StartOffset":0,"LoopDuration":8167022935,"Pos":[227.0,-10.0],"Size":[200.0,100.0],"Loops":true,"FoldMode":2,"Inlets":[{"uuid":"9a13fb32-269a-47bf-99a9-930188c1f19c","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in","Value":{},"Init":{},"Domain":{}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Fixed range","Exposed":"fixed range","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Min","Exposed":"min","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-1000000.0,"Max":1000000.0}}},{"uuid":"10d62b0d-5bc9-4ac9-9540-9e8ac0c24947","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Max","Exposed":"max","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":-1000000.0,"Max":1000000.0}}}],"Outlets":[{"uuid":"3620ea94-5991-41cf-89b3-11f842cc39d0","ObjectName":"Outlet","id":0,"Hidden":true,"Custom":"out","Exposed":"out","Value":{"Tuple":[{"Float":0.11124077439308167},{"Float":15015.0693359375}]},"Domain":{}}]},{"uuid":"846a5de5-47f9-46c5-a898-013cb20951d0","ObjectName":"Javascript","id":5,"Metadata":{"ScriptingName":"ui-example","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":8008305373,"Height":300.0,"StartOffset":0,"LoopDuration":8008305373,"Pos":[74.0,-18.0],"Size":[153.0,55.0],"Loops":false,"FoldMode":2,"Script":"import Score\nimport QtQuick\n// This is an example script that showcases the available API.\n// View the complete documentation at\n// https://ossia.io/score-docs/processes/javascript.html\nScript {\n  ValueInlet { id: in1; objectName: \"Value In\" }\n  ValueOutlet { id: out1; objectName: \"Value Out\" }\n  FloatSlider { id: sl; min: 10; max: 100; objectName: \"Control\" }\n\n  property real mx: 0\n  property real my: 0\n\n  // Called on every tick\n  tick: function(token, state) {\n    if (typeof in1.value !== 'undefined') {\n      console.log(in1.value);\n      out1.value = in1.value * mx + sl.value * my;\n\n      // Update the ui:\n      console.log(\"(exec): exec -> ui\", { foo: out1.value });\n      uiSend({ foo: out1.value });\n    }\n  }\n\n  // Use these to handle specific execution events if necessary:\n  // start: function() { }\n  // stop: function() { }\n  // pause: function() { }\n  // resume: function() { }\n\n  // Handling UI events (from UI to model)\n  uiEvent: function(message) {\n    mx = message.x;\n    my = message.y;\n    console.log(\"(exec): ui -> exec\", message);\n  }\n\n  property var modelState;\n  loadState: function(state) {\n    modelState = state;\n    // A list of key-value pairs saved along with the score and preserved\n    // across executions.\n    console.log(\"exec: loadState\", JSON.stringify(modelState));\n  }\n\n  stateUpdated: function(k, v) {\n    console.log(\"(exec): onStateElementChanged\", k, JSON.stringify(v));\n  }\n}\n","Ui":"import Score\nimport QtQuick\nimport QtQuick.Controls.Basic\n\nScriptUI {\n  id: root\n  anchors.fill: parent\n\n  property var modelState\n  property var executionState\n  property var slider: root.inlet(\"Control\")\n  Component.onCompleted: console.log(\"Slider: \", slider);\n\n  executionEvent: function(message) {\n    console.log(\"(ui): exec -> ui\", message);\n    executionState = message;\n  }\n\n  loadState: function(state) {\n    modelState = state;\n    console.log(\"ui: loadState\", JSON.stringify(modelState));\n  }\n\n  stateUpdated: function(k, v) {\n    console.log(\"(ui): onStateElementChanged\", k, JSON.stringify(v));\n  }\n\n  Column {\n    anchors.fill: parent\n    Text {\n      text: \"This example showcases the core API for communicating between JS UI and backend.\\nData flows in every direction.\\nClick on the ui window to send data to the execution engine,\\nwhich gets modified and sent back to the UI.\";\n      color: \"white\"\n      font.pointSize: 12\n    }\n    Item { width: 1; height: 15}\n    Text {\n      text: \"value of foo: \" + (executionState !== undefined ? executionState.foo : 0);\n      color: \"white\"\n      font.pointSize: 16\n    }\n    Text {\n      text:  \"value of slider: \" + slider.value\n      color: \"white\"\n    }\n  }\n  MouseArea {\n    anchors.fill: root\n    onClicked: {\n      console.log(\"(ui): ui -> exec\", {x: mouseX, y: mouseY});\n      root.executionSend({x: mouseX, y: mouseY});\n      slider.value = Math.random() * 100;\n    }\n\n    onPressed: { root.beginUpdateState(\"Edit\");  }\n    onPositionChanged: { root.updateState(\"Mouse\", {x: mouse.x, y: mouse.y}); }\n    onReleased: { root.endUpdateState();  }\n  }\n}\n","State":[["Mouse",{"Map":[["x",{"Float":163.0}],["y",{"Float":457.0}]]}]],"Root":"<LIBRARY>:packages/default/Presets/Javascript/ui-example/ui-example.qml","Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Value In","Exposed":"value in"},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Control","Exposed":"control","Value":{"Float":32.85167694091797},"Init":{"Float":0.5},"Domain":{"Float":{"Min":10.0,"Max":100.0}}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Value Out","Exposed":"value out"}]},{"uuid":"0b1b1816-c33e-4796-a16d-5aab27fe600f","ObjectName":"LFO","id":6,"Metadata":{"ScriptingName":"LFO","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":8008305373,"Height":300.0,"StartOffset":0,"LoopDuration":8008305373,"Pos":[-269.0,-23.0],"Size":[270.0,134.5],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"b631d9b7-cbe3-4d9c-b470-f139e348aecb","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"Period","Exposed":"period","Value":{"Vec2f":[0.5,1.0]},"Init":{"Vec2f":[0.5,1.0]},"Domain":{"Vec2f":{"Min":[0.009999999776482582,0.0],"Max":[60.0,1.0],"Values":[[],[]]}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Shape","Exposed":"shape","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Retrigger","Exposed":"retrigger","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Ampl.","Exposed":"ampl.","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Offset","Exposed":"offset","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":-1.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Jitter","Exposed":"jitter","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Phase","Exposed":"phase","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-1.0,"Max":1.0}}},{"uuid":"8b1d76c4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Waveform","Exposed":"waveform","Value":{"String":"Sin"},"Init":{"String":"Sin"},"Domain":{"String":{"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"]}},"Values":["Sin","Triangle","Saw","RampDown","Square","SquareOnChange","SampleAndHoldEveryTick","SampleAndHold","Noise1","Noise2","Noise3","Drift"],"Pixmaps":[":/icons/wave_sin_off.png",":/icons/wave_sin_on.png",":/icons/wave_triangle_off.png",":/icons/wave_triangle_on.png",":/icons/wave_saw_off.png",":/icons/wave_saw_on.png",":/icons/wave_ramp_down_off.png",":/icons/wave_ramp_down_on.png",":/icons/wave_square_ticks_off.png",":/icons/wave_square_ticks_on.png",":/icons/wave_square_changes_off.png",":/icons/wave_square_changes_on.png",":/icons/wave_sample_and_hold_ticks_off.png",":/icons/wave_sample_and_hold_ticks_on.png",":/icons/wave_sample_and_hold_changes_off.png",":/icons/wave_sample_and_hold_changes_on.png",":/icons/wave_noise1_off.png",":/icons/wave_noise1_on.png",":/icons/wave_noise2_off.png",":/icons/wave_noise2_on.png",":/icons/wave_noise3_off.png",":/icons/wave_noise3_on.png",":/icons/wave_drift_off.png",":/icons/wave_drift_on.png"]}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Out","Exposed":"out"}]}],"SmallViewRack":[{"Processes":[5,6],"Process":null,"Height":241.0,"Nodal":true},{"Processes":[4],"Process":4,"Height":54.0,"Nodal":false}],"FullViewRack":[{"Process":0,"Nodal":true},{"Process":4,"Nodal":false}],"DefaultDuration":8008305373,"MinDuration":8167022935,"MaxDuration":4611686018427387903,"GuiDuration":8552386912,"Speed":1.0,"Rigidity":false,"MinNull":true,"MaxInf":true,"Signatures":[],"StartState":5,"EndState":6,"StartDate":681551884,"HeightPercentage":0.7586666666666667,"NodalSlotHeight":100.0,"QuantizationRate":-1.0,"Zoom":-1.0,"Center":0,"NodalCenter":[111.5,57.50000000000001],"ViewMode":0,"SmallViewShown":true,"HasSignature":false}],"Comments":[{"ObjectName":"CommentBlockModel","id":1,"Date":662879230,"HeightPercentage":0.021333333333333333,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">score allows livecoding in many places.<br />Every process that has the little &quot;terminal&quot;  [&gt;_]  <br />icon can be edited. <br />The button is also accessible in the inspector.<br />For instance, the object below is written in QML, <br />a superset of Javascript.<br />You can either have the editor as a separate window, as a panel, <br />or as a tab instead of the central view.<br />Pressing ctrl / cmd + enter updates the code.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":2,"Date":5461751403,"HeightPercentage":0.021333333333333333,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">As of ossia score 3.9, the scriptable languages are: <br />- Javascript / QML<br />- Bytebeat<br />- GLSL (Vulkan-compatible GLSL 4.6) for vertex, fragment and compute shaders<br />- C++ with C++ JIT<br />- Faust and JSFX for digital signal processing<br />- Shell commands / shell script (bash, cmd, etc.)<br /><br />In addition, the console on the right panel allows to access the JS API directly.</span></p></body></html>"},{"ObjectName":"CommentBlockModel","id":3,"Date":653542902,"HeightPercentage":0.428,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; -qt-user-state:0;\"><span style=\" font-size:10pt;\">If editing a shader, you also have the option of keeping the window output as background render.<br />Right-click on the script editor button anywhere (in a process, on a tab, etc.) to see the options.<br /><br />For instance, in this shader, remplace the line 138 by: </span>        t += 1.8 * d;<br />for a different visual.</p></body></html>"},{"ObjectName":"CommentBlockModel","id":4,"Date":625533921,"HeightPercentage":0.7016919883769199,"HTMLContent":"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><meta charset=\"utf-8\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\nhr { height: 1px; border-width: 0; }\nli.unchecked::marker { content: \"\\2610\"; }\nli.checked::marker { content: \"\\2612\"; }\n</style></head><body style=\" font-family:'Ubuntu'; font-size:13px; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:10pt;\">JS scripts can also have custom user interfaces written in QtQuick.<br />Open them with the little &quot;external window&quot; icon. You can also embed them in the <br />main view.</span></p></body></html>"}]}],"SmallViewRack":[],"FullViewRack":[{"Process":1,"Nodal":false}],"DefaultDuration":10584000000,"MinDuration":10584000000,"MaxDuration":111132000