4-3838-4ac0-9b9c-c12bc5db8e8a","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Mode","Exposed":"mode","Value":{"String":"Clip"},"Init":{"String":"Clip"},"Domain":{"String":{"Values":["Free","Clip","Shape","Wrap","Fold"]}},"Values":["Free","Clip","Shape","Wrap","Fold"],"Pixmaps":[]},{"uuid":"348b80a4-45dc-4f70-8f5f-6546c85089a2","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Average over...","Exposed":"average over...","Value":{"Int":100},"Init":{"Int":100},"Domain":{"Int":{"Min":1,"Max":10000}}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Reset","Exposed":"reset","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"Scaled","Exposed":"scaled"},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":1,"Hidden":false,"Custom":"Mean","Exposed":"mean"},{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":2,"Hidden":false,"Custom":"Variance","Exposed":"variance"},{"uuid":"f6d740ce-acc0-44c0-932a-0a03345af84f","ObjectName":"Outlet","id":3,"Hidden":true,"Custom":"Cur min","Exposed":"cur min","Value":{"Float":-191109.46875},"Domain":{"Float":{"Min":-10.0,"Max":10.0}}},{"uuid":"f6d740ce-acc0-44c0-932a-0a03345af84f","ObjectName":"Outlet","id":4,"Hidden":true,"Custom":"Cur max","Exposed":"cur max","Value":{"Float":106346.8046875},"Domain":{"Float":{"Min":-10.0,"Max":10.0}}}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":53,"Metadata":{"ScriptingName":"AddColor","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[1397.9670408894613,-408.8379727402373],"Size":[275.0,391.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Add or replace the color attribute on geometry. Solid: solidColor. By Index: a rainbow along the vertex order (saturation). Random: a random hue per vertex (seed, saturation). Axis Gradient: colorA at -1 to colorB at +1 along gradientAxis (clamped outside). alpha multiplies the result.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Geometry Modifier\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" },\n        { \"NAME\": \"color\",    \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\" }\n      ]\n    },\n    {\n      \"NAME\": \"colorMode\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 1,\n      \"VALUES\": [0, 1, 2, 3],\n      \"LABELS\": [\"Solid\", \"By Index\", \"Random\", \"Axis Gradient\"]\n    },\n    {\n      \"NAME\": \"solidColor\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [1.0, 1.0, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"colorA\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [0.2, 0.4, 1.0, 1.0]\n    },\n    {\n      \"NAME\": \"colorB\",\n      \"TYPE\": \"color\",\n      \"DEFAULT\": [1.0, 0.3, 0.1, 1.0]\n    },\n    {\n      \"NAME\": \"seed\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 42.0,\n      \"MIN\": 0.0,\n      \"MAX\": 1000.0\n    },\n    {\n      \"NAME\": \"saturation\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 0.7,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"alpha\",\n      \"TYPE\": \"float\",\n      \"DEFAULT\": 1.0,\n      \"MIN\": 0.0,\n      \"MAX\": 1.0\n    },\n    {\n      \"NAME\": \"gradientAxis\",\n      \"TYPE\": \"long\",\n      \"DEFAULT\": 1,\n      \"VALUES\": [0, 1, 2],\n      \"LABELS\": [\"X\", \"Y\", \"Z\"]\n    }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\nuint pcg(uint s)\n{\n  s ^= s >> 17u; s *= 0xed5ad4bbu;\n  s ^= s >> 11u; s *= 0xac4c1b51u;\n  s ^= s >> 15u; s *= 0x31848babu;\n  s ^= s >> 14u;\n  return s;\n}\n\nfloat rand01(uint s) { return float(pcg(s)) / 4294967296.0; }\n\n// HSV to RGB\nvec3 hsv2rgb(float h, float s, float v)\n{\n  vec3 c = vec3(h, s, v);\n  vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0);\n  return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);\n}\n\nvoid main()\n{\n  uint idx = gl_GlobalInvocationID.x;\n  uint count = uint(ISF_READ(geo, position).length());\n  if(idx >= count)\n    return;\n\n  vec4 col;\n\n  // Mode 0: Solid color\n  if(colorMode == 0)\n  {\n    col = solidColor;\n  }\n  // Mode 1: By index (HSV rainbow)\n  else if(colorMode == 1)\n  {\n    float t = float(idx) / max(float(count - 1u), 1.0);\n    col = vec4(hsv2rgb(t, saturation, 1.0), 1.0);\n  }\n  // Mode 2: Random per-vertex\n  else if(colorMode == 2)\n  {\n    uint s = idx * 7919u + uint(seed * 65537.0);\n    float hue = rand01(s);\n    col = vec4(hsv2rgb(hue, saturation, 0.8 + 0.2 * rand01(s + 1u)), 1.0);\n  }\n  // Mode 3: Axis gradient (colorA -> colorB)\n  else\n  {\n    vec3 pos = ISF_READ(geo, position)[idx].xyz;\n    float v = pos[gradientAxis];\n\n    // Auto-normalize: scan is too expensive, use a reasonable range\n    // Map [-1, 1] to [0, 1] — works for most generators\n    float t = clamp(v * 0.5 + 0.5, 0.0, 1.0);\n    col = mix(colorA, colorB, t);\n  }\n\n  col.a *= alpha;\n  ISF_WRITE(geo, color)[idx] = col;\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/modifiers/AddColor.cs","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geo","Exposed":"geo"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"colorMode","Exposed":"colormode","Value":{"Int":1},"Init":{"Int":1},"Domain":{"Int":{"Values":[0,1,2,3]}},"Values":[["Solid",{"Int":0}],["By Index",{"Int":1}],["Random",{"Int":2}],["Axis Gradient",{"Int":3}]],"FolderPort":"","FileExtensions":""},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"solidColor","Exposed":"solidcolor","Value":{"Vec4f":[1.0,0.7680934071540833,0.12433051317930222,1.0]},"Init":{"Vec4f":[1.0,1.0,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"colorA","Exposed":"colora","Value":{"Vec4f":[0.20000000298023224,0.4000000059604645,1.0,1.0]},"Init":{"Vec4f":[0.20000000298023224,0.4000000059604645,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"colorB","Exposed":"colorb","Value":{"Vec4f":[1.0,0.30000001192092896,0.10000000149011612,1.0]},"Init":{"Vec4f":[1.0,0.30000001192092896,0.10000000149011612,1.0]},"Domain":{}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"seed","Exposed":"seed","Value":{"Float":1000.0},"Init":{"Float":42.0},"Domain":{"Float":{"Min":0.0,"Max":1000.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"saturation","Exposed":"saturation","Value":{"Float":1.0},"Init":{"Float":0.699999988079071},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"alpha","Exposed":"alpha","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"gradientAxis","Exposed":"gradientaxis","Value":{"Int":1},"Init":{"Int":1},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["X",{"Int":0}],["Y",{"Int":1}],["Z",{"Int":2}]],"FolderPort":"","FileExtensions":""}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geo_out","Exposed":"geo_out"}]},{"uuid":"c673eeab-fbee-4f2b-89f6-22e84fd5e709","ObjectName":"dspfilter