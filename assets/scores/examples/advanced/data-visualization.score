["One",{"Int":1}],["SrcColor",{"Int":2}],["OneMinusSrcColor",{"Int":3}],["DstColor",{"Int":4}],["OneMinusDstColor",{"Int":5}],["SrcAlpha",{"Int":6}],["OneMinusSrcAlpha",{"Int":7}],["DstAlpha",{"Int":8}],["OneMinusDstAlpha",{"Int":9}],["ConstantColor",{"Int":10}],["OneMinusConstantColor",{"Int":11}],["ConstantAlpha",{"Int":12}],["OneMinusConstantAlpha",{"Int":13}],["SrcAlphaSaturate",{"Int":14}]],"FolderPort":"","FileExtensions":""},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"OpAlpha","Exposed":"opalpha","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4]}},"Values":[["Add",{"Int":0}],["Substract",{"Int":1}],["Reverse Substract",{"Int":2}],["Min",{"Int":3}],["Max",{"Int":4}]],"FolderPort":"","FileExtensions":""},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"lightDir","Exposed":"lightdir","Value":{"Vec3f":[-0.12196067720651627,0.699999988079071,0.5]},"Init":{"Vec3f":[0.30000001192092896,0.699999988079071,0.5]},"Domain":{"Vec3f":{"Min":[-0.30000001192092896,-0.699999988079071,-0.5],"Max":[0.6000000238418579,1.399999976158142,1.0],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"ambient","Exposed":"ambient","Value":{"Float":0.0},"Init":{"Float":0.20000000298023224},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"shininess","Exposed":"shininess","Value":{"Float":124.89398193359375},"Init":{"Float":64.0},"Domain":{"Float":{"Min":1.0,"Max":256.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":11,"Hidden":true,"Custom":"specularStrength","Exposed":"specularstrength","Value":{"Float":0.0},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"377e8205-b442-4d54-8832-3761def522b2","ObjectName":"Inlet","id":12,"Hidden":true,"Custom":"cameraPos","Exposed":"camerapos","Value":{"Vec3f":[0.44192349910736084,0.8089478611946106,4.0]},"Init":{"Vec3f":[2.0,2.0,2.0]},"Domain":{"Vec3f":{"Min":[-2.0,-2.0,-2.0],"Max":[4.0,4.0,4.0],"Values":[[],[],[]]}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":13,"Hidden":true,"Custom":"fov","Exposed":"fov","Value":{"Float":120.0},"Init":{"Float":45.0},"Domain":{"Float":{"Min":5.0,"Max":120.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":14,"Hidden":true,"Custom":"nearPlane","Exposed":"nearplane","Value":{"Float":0.009999999776482582},"Init":{"Float":0.009999999776482582},"Domain":{"Float":{"Min":0.0010000000474974513,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":15,"Hidden":true,"Custom":"farPlane","Exposed":"farplane","Value":{"Float":690.0978393554688},"Init":{"Float":100.0},"Domain":{"Float":{"Min":1.0,"Max":1000.0}}},{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":1001,"Hidden":false,"Custom":"Camera","Exposed":"camera"}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outlet","id":1000,"Hidden":false,"Custom":"Texture Out","Exposed":"texture out","Address":"Window:/"}]},{"uuid":"1fe9c806-b601-4ee0-9fbb-0ab817c4dd87","ObjectName":"ArrayMapping","id":20,"Metadata":{"ScriptingName":"Arraymap","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[557.7021778976293,-444.1266481568693],"Size":[180.0,35.0],"Loops":false,"FoldMode":0,"Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"in","Exposed":"in"},{"uuid":"9ae797ea-d94c-4792-acec-9ec1932bae5d","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"Expression","Exposed":"expression","Value":{"String":"0.001x-10"},"Init":{"String":"x"},"Domain":{}}],"Outlets":[{"uuid":"cff96158-cc72-46d7-99dc-b6038171375b","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"out","Exposed":"out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":30,"Metadata":{"ScriptingName":"PointsToSprites","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[1682.0299429786216,-403.36445688615606],"Size":[165.0,55.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Adapter from a point cloud (N vertices, position+color per-vertex) to the instanced-sprite topology expected by SphereSplat / Billboard / StretchedBillboard (VERTEX_COUNT=6, INSTANCE_COUNT=N, all attributes per-instance). Adds a uniform sprite_size attribute that every sprite renderer needs, and forwards velocity (zero if the input has none) for StretchedBillboard. Place this between any point cloud generator/modifier and a sprite-based renderer.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Geometry Modifier\", \"Instancing\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geoOut\",\n      \"TYPE\": \"geometry\",\n      \"TOPOLOGY\": \"triangles\",\n      \"VERTEX_COUNT\": 6,\n      \"INSTANCE_COUNT\": \"$VERTEX_COUNT_geoIn\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"out_position\",    \"SEMANTIC\": \"position\",    \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"instance\" },\n        { \"NAME\": \"out_color\",       \"SEMANTIC\": \"color\",       \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"instance\" },\n        { \"NAME\": \"out_sprite_size\", \"SEMANTIC\": \"sprite_size\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"instance\" },\n        { \"NAME\": \"out_velocity\",    \"SEMANTIC\": \"velocity\",    \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\", \"RATE\": \"instance\" }\n      ]\n    },\n    {\n      \"NAME\": \"geoIn\",\n      \"TYPE\": \"geometry\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"in_position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" },\n        { \"NAME\": \"in_color\",    \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" },\n        { \"NAME\": \"in_velocity\", \"SEMANTIC\": \"velocity\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\", \"REQUIRED\": false }\n      ]\n    },\n    { \"NAME\": \"spriteSize\", \"TYPE\": \"float\", \"DEFAULT\": 0.1,  \"MIN\": 0.001, \"MAX\": 5.0 }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_INSTANCE\" } }\n  ]\n}*/\n\nvoid main()\n{\n    uint idx = gl_GlobalInvocationID.x;\n    uint count = uint(ISF_READ(geoIn, in_position).length());\n    if(idx >= count)\n        return;\n\n    vec4 pos = ISF_READ(geoIn, in_position)[idx];\n    vec4 col = ISF_READ(geoIn, in_color)[idx];\n\n    ISF_WRITE(geoOut, out_position)[idx]    = pos;\n    ISF_WRITE(geoOut, out_color)[idx]       = col;\n    ISF_WRITE(geoOut, out_sprite_size)[idx] = vec4(spriteSize, spriteSize, 0.0, 0.0);\n    // Velocity is forwarded (zero when upstream has none) for StretchedBillboard\n    // and VelocityLines-style renderers.\n    ISF_WRITE(geoOut, out_velocity)[idx]    = ISF_READ(geoIn, in_velocity)[idx];\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/modifiers/PointsToSprites.cs","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geoIn","Exposed":"geoin"},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"spriteSize","Exposed":"spritesize","Value":{"Float":0.2351560741662979},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":0.0010000000474974513,"Max":5.0}}}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geoOut_out","Exposed":"geoout_out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":31,"Metadata":{"ScriptingName":"CircularHistory","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[993.4046334058525,-437.9771730394299],"Size":[159.0,40.0],"Loops":false,"FoldMode":2,"Compute":"/*{\n  \"DESCRIPTION\": \"Trail of the last 100 2D points received: every frame the [x, y] pairs in xyBuffer (e.g. Arraygen -> Array to buffer, Float32) are appended to a ring buffer of 100 points on the z = 0 plane; the newest are orange and each older point fades toward transparent black (its colour is premultiplied) and shrinks its sprite_size by 1 % per frame. The ring buffer lives in the output geometry: cable geoOut back into geoIn with a delayed cable, otherwise the trail restarts every frame. Render with a point or sprite renderer.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Generator\", \"Particles\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geoOut\",\n      \"TYPE\": \"geometry\",\n      \"VERTEX_COUNT\": 100,\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"out_position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\" },\n        { \"NAME\": \"out_color\",    \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\" },\n        { \"NAME\": \"out_sprite_size\", \"SEMANTIC\": \"sprite_size\", \"TYPE\": \"vec4\", \"ACCESS\": \"write_only\" }\n      ],\n      \"AUXILIARY\": [\n        {\n          \"NAME\": \"state\",\n          \"ACCESS\": \"read_write\",\n          \"LAYOUT\": [\n            { \"NAME\": \"write_index\", \"TYPE\": \"uint\" },\n            { \"NAME\": \"initialized\", \"TYPE\": \"uint\" }\n          ]\n        }\n      ]\n    },\n    {\n      \"NAME\": \"geoIn\",\n      \"TYPE\": \"geometry\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"in_position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" },\n        { \"NAME\": \"in_color\",    \"SEMANTIC\": \"color\",    \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" },\n        { \"NAME\": \"in_sprite_size\", \"SEMANTIC\": \"sprite_size\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_only\" }\n      ],\n      \"AUXILIARY\": [\n        {\n          \"NAME\": \"state\",\n          \"ACCESS\": \"read_only\",\n          \"LAYOUT\": [\n            { \"NAME\": \"write_index\", \"TYPE\": \"uint\" },\n            { \"NAME\": \"initialized\", \"TYPE\": \"uint\" }\n          ]\n        }\n      ]\n    },\n    {\n      \"NAME\": \"xyBuffer\",\n      \"TYPE\": \"storage\",\n      \"ACCESS\": \"read_only\",\n      \"LAYOUT\": [\n        { \"NAME\": \"particles\", \"TYPE\": \"vec2[]\" }\n      ],\n      \"DESCRIPTION\": \"SSBO containing the NEW points for this frame as flat [x,y,x,y...].\"\n    }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\nvoid main()\n{\n    uint idx = gl_GlobalInvocationID.x;\n    uint poolSize = 100u;\n    if(idx >= poolSize)\n        return;\n\n    // --- 1. Initialization ---\n    // The CSF codegen detects the name collision on 'state' and prefixes them\n    // as 'geoIn_state' and 'geoOut_state'.\n    if(geoIn_state.initialized == 0u)\n    {\n        ISF_WRITE(geoOut, out_position)[idx] = vec4(0.0);\n        ISF_WRITE(geoOut, out_color)[idx] = vec4(1.0);\n        ISF_WRITE(geoOut, out_sprite_size)[idx] = vec4(0.1, 0.1, 0.0, 0.0);\n        if(idx == 0u)\n        {\n            geoOut_state.write_index = 0u;\n            geoOut_state.initialized = 1u;\n        }\n        return;\n    }\n\n    // --- 2. Read state from previous frame ---\n    vec4 pos = ISF_READ(geoIn, in_position)[idx];\n    vec4 col = ISF_READ(geoIn, in_color)[idx];\n    vec4 size = ISF_READ(geoIn, in_sprite_size)[idx];\n    uint writeIdx = geoIn_state.write_index;\n\n    // --- 3. Process new points ---\n    // Access the SSBO directly via the resource name and layout member\n    uint newPointsCount = uint(xyBuffer.particles.length());\n    \n    // If we have more than 100 points, we only care about the last 100\n    uint startIndex = 0u;\n    if(newPointsCount > poolSize)\n    {\n        startIndex = newPointsCount - poolSize;\n        newPointsCount = poolSize;\n    }\n\n    // Determine if this slot 'idx' should be overwritten this frame\n    bool shouldUpdate = false;\n    uint inputOffset = 0u;\n\n    uint endIdx = (writeIdx + newPointsCount) % poolSize;\n    \n    if(writeIdx <= endIdx)\n    {\n        if(idx >= writeIdx && idx < endIdx)\n        {\n            shouldUpdate = true;\n            inputOffset = idx - writeIdx;\n        }\n    }\n    else\n    {\n        // Wrap-around case\n        if(idx >= writeIdx)\n        {\n            shouldUpdate = true;\n            inputOffset = idx - writeIdx;\n        }\n        else if(idx < endIdx)\n        {\n            shouldUpdate = true;\n            inputOffset = (poolSize - writeIdx) + idx;\n        }\n    }\n\n    if(shouldUpdate)\n    {\n        vec2 newPos = xyBuffer.particles[startIndex + inputOffset];\n        pos = vec4(newPos, 0.0, 1.0);\n        \n        // New points are bright orange\n        col = vec4(1.0, 0.5, 0.2, 1.0);\n        size = vec4(0.1, 0.1, 0.0, 0.0);\n    }\n    else\n    {\n        // Fade out and shrink existing points (tail effect)\n        col *= 0.98;\n        size.xy *= 0.99;\n    }\n\n    // --- 4. Write results ---\n    ISF_WRITE(geoOut, out_position)[idx] = pos;\n    ISF_WRITE(geoOut, out_color)[idx] = col;\n    ISF_WRITE(geoOut, out_sprite_size)[idx] = size;\n\n    // Only one thread updates the global write index\n    if(idx == 0u)\n    {\n        geoOut_state.write_index = (writeIdx + newPointsCount) % poolSize;\n        geoOut_state.initialized = 1u;\n    }\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/generators/CircularHistory.cs","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geoIn","Exposed":"geoin"},{"uuid":"5ac86198-2d03-4830-9e41-a6d529922d29","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"xyBuffer","Exposed":"xybuffer","Format":0,"FormatSet":false,"Filter":2,"AddressMode":1,"MipmapMode":0}],"Outlets":[{"uuid":"848061c5-e8a0-4a13-9985-e8df30ce6d4f","ObjectName":"Outlet","id":0,"Hidden":false,"Custom":"geoOut_out","Exposed":"geoout_out"}]},{"uuid":"a5bbffe0-93d2-4e70-995c-cf46c2c43520","ObjectName":"CSF","id":32,"Metadata":{"ScriptingName":"Deform","Comment":"","Color":"Transparent1","Label":"","Touched":true},"Duration":10584000000,"Height":300.0,"StartOffset":0,"LoopDuration":10584000000,"Pos":[982.9603432749808,-329.85250340508094],"Size":[285.0,161.0],"Loops":false,"FoldMode":0,"Compute":"/*{\n  \"DESCRIPTION\": \"Procedural deformation around center, along axis. amount means: Twist = radians of rotation per unit along the axis; Bend = curvature (1 / bend radius) per unit along the axis, bending toward the first perpendicular axis; Taper = change of the cross-section scale per unit along the axis (1 + amount x distance); Spherize = blend from the shape (0) to a sphere of the given radius (1), negative values push away; Quantize = snap to a grid of gridSize (amount unused). radius is used by Spherize only, gridSize by Quantize only. Normals are re-derived from the deformation; a geometry without normals is deformed too.\",\n  \"CREDIT\": \"ossia score\",\n  \"ISFVSN\": \"2.0\",\n  \"MODE\": \"COMPUTE_SHADER\",\n  \"CATEGORIES\": [\"Geometry Modifier\"],\n  \"RESOURCES\": [\n    {\n      \"NAME\": \"geo\",\n      \"TYPE\": \"geometry\",\n      \"ATTRIBUTES\": [\n        { \"NAME\": \"position\", \"SEMANTIC\": \"position\", \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\" },\n        { \"NAME\": \"normal\",   \"SEMANTIC\": \"normal\",   \"TYPE\": \"vec4\", \"ACCESS\": \"read_write\", \"REQUIRED\": false }\n      ]\n    },\n    { \"NAME\": \"deformType\", \"TYPE\": \"long\", \"VALUES\": [0, 1, 2, 3, 4], \"LABELS\": [\"Twist\", \"Bend\", \"Taper\", \"Spherize\", \"Quantize\"], \"DEFAULT\": 0 },\n    { \"NAME\": \"amount\",     \"TYPE\": \"float\",   \"DEFAULT\": 1.0,  \"MIN\": -10.0, \"MAX\": 10.0 },\n    { \"NAME\": \"axis\",       \"TYPE\": \"long\",    \"VALUES\": [0, 1, 2], \"LABELS\": [\"X\", \"Y\", \"Z\"], \"DEFAULT\": 1 },\n    { \"NAME\": \"center\",     \"TYPE\": \"point3D\", \"DEFAULT\": [0, 0, 0], \"MIN\": [-100, -100, -100], \"MAX\": [100, 100, 100] },\n    { \"NAME\": \"radius\",     \"TYPE\": \"float\",   \"DEFAULT\": 1.0,  \"MIN\": 0.01,  \"MAX\": 100.0 },\n    { \"NAME\": \"gridSize\",   \"TYPE\": \"float\",   \"DEFAULT\": 0.1,  \"MIN\": 0.01,  \"MAX\": 10.0 }\n  ],\n  \"PASSES\": [\n    { \"LOCAL_SIZE\": [64, 1, 1], \"EXECUTION_MODEL\": { \"TYPE\": \"PER_VERTEX\" } }\n  ]\n}*/\n\n// Extract the component along the chosen axis and the two perpendicular components.\n// Returns vec3(along_axis, perp1, perp2) and sets up indices for reassembly.\n// axis: 0=X, 1=Y, 2=Z\n\nfloat getAxisComponent(vec3 p, int ax)\n{\n    if(ax == 0) return p.x;\n    if(ax == 1) return p.y;\n    return p.z;\n}\n\nvec3 setAxisComponent(vec3 p, int ax, float v)\n{\n    if(ax == 0) p.x = v;\n    else if(ax == 1) p.y = v;\n    else p.z = v;\n    return p;\n}\n\n// Get the two perpendicular axis indices\nivec2 perpAxes(int ax)\n{\n    if(ax == 0) return ivec2(1, 2);\n    if(ax == 1) return ivec2(0, 2);\n    return ivec2(0, 1);\n}\n\nfloat getComp(vec3 p, int i)\n{\n    if(i == 0) return p.x;\n    if(i == 1) return p.y;\n    return p.z;\n}\n\nvec3 setComp(vec3 p, int i, float v)\n{\n    if(i == 0) p.x = v;\n    else if(i == 1) p.y = v;\n    else p.z = v;\n    return p;\n}\n\nvec3 doTwist(vec3 pos, vec3 ctr, int ax, float amt)\n{\n    vec3 p = pos - ctr;\n    float along = getAxisComponent(p, ax);\n    float angle = amt * along;\n    float c = cos(angle), s = sin(angle);\n\n    ivec2 perp = perpAxes(ax);\n    float u = getComp(p, perp.x);\n    float v = getComp(p, perp.y);\n\n    float nu = c * u - s * v;\n    float nv = s * u + c * v;\n\n    p = setComp(p, perp.x, nu);\n    p = setComp(p, perp.y, nv);\n    return p + ctr;\n}\n\nvec3 doBend(vec3 pos, vec3 ctr, int ax, float amt)\n{\n    vec3 p = pos - ctr;\n    float along = getAxisComponent(p, ax);\n    float angle = amt * along;\n\n    // Bend in the plane of (axis, first perpendicular axis)\n    ivec2 perp = perpAxes(ax);\n    float u = getComp(p, perp.x);\n\n    // If amount is near zero, skip to avoid division by zero\n    if(abs(amt) < 0.0001)\n        return pos;\n\n    float bendRadius = 1.0 / amt;\n    // Circular arc: the along-axis coordinate maps to an angle,\n    // and the perpendicular offset shifts the radius\n    float r = bendRadius + u;\n    float newAlong = r * sin(angle);\n    float newPerp  = r * cos(angle) - bendRadius;\n\n    p = setAxisComponent(p, ax, newAlong);\n    p = setComp(p, perp.x, newPerp);\n    return p + ctr;\n}\n\nvec3 doTaper(vec3 pos, vec3 ctr, int ax, float amt)\n{\n    vec3 p = pos - ctr;\n    float along = getAxisComponent(p, ax);\n    float taperScale = 1.0 + amt * along;\n    taperScale = max(taperScale, 0.0);\n\n    ivec2 perp = perpAxes(ax);\n    float u = getComp(p, perp.x) * taperScale;\n    float v = getComp(p, perp.y) * taperScale;\n\n    p = setComp(p, perp.x, u);\n    p = setComp(p, perp.y, v);\n    return p + ctr;\n}\n\nvec3 doSpherize(vec3 pos, vec3 ctr, float r, float amt)\n{\n    vec3 d = pos - ctr;\n    float len = length(d);\n    if(len < 0.0001)\n        return pos;\n\n    vec3 spherePos = normalize(d) * r + ctr;\n    return mix(pos, spherePos, clamp(amt, -1.0, 1.0));\n}\n\nvec3 doQuantize(vec3 pos, float grid)\n{\n    return round(pos / grid) * grid;\n}\n\n// Approximate normal after deformation by computing the Jacobian via finite differences.\nvec3 deformNormal(vec3 pos, vec3 nrm, vec3 ctr, int ax, int dtype, float amt, float r, float grid)\n{\n    float eps = 0.001;\n    vec3 tangentX, tangentY, tangentZ;\n\n    // Compute displaced neighbors along each axis\n    vec3 px, mx, py, my, pz, mz;\n\n    // We compute the deformed positions at small offsets to approximate partial derivatives\n    vec3 ppx = pos + vec3(eps, 0.0, 0.0);\n    vec3 pmx = pos - vec3(eps, 0.0, 0.0);\n    vec3 ppy = pos + vec3(0.0, eps, 0.0);\n    vec3 pmy = pos - vec3(0.0, eps, 0.0);\n    vec3 ppz = pos + vec3(0.0, 0.0, eps);\n    vec3 pmz = pos - vec3(0.0, 0.0, eps);\n\n    if(dtype == 0) // Twist\n    {\n        px = doTwist(ppx, ctr, ax, amt); mx = doTwist(pmx, ctr, ax, amt);\n        py = doTwist(ppy, ctr, ax, amt); my = doTwist(pmy, ctr, ax, amt);\n        pz = doTwist(ppz, ctr, ax, amt); mz = doTwist(pmz, ctr, ax, amt);\n    }\n    else if(dtype == 1) // Bend\n    {\n        px = doBend(ppx, ctr, ax, amt); mx = doBend(pmx, ctr, ax, amt);\n        py = doBend(ppy, ctr, ax, amt); my = doBend(pmy, ctr, ax, amt);\n        pz = doBend(ppz, ctr, ax, amt); mz = doBend(pmz, ctr, ax, amt);\n    }\n    else if(dtype == 2) // Taper\n    {\n        px = doTaper(ppx, ctr, ax, amt); mx = doTaper(pmx, ctr, ax, amt);\n        py = doTaper(ppy, ctr, ax, amt); my = doTaper(pmy, ctr, ax, amt);\n        pz = doTaper(ppz, ctr, ax, amt); mz = doTaper(pmz, ctr, ax, amt);\n    }\n    else if(dtype == 3) // Spherize\n    {\n        px = doSpherize(ppx, ctr, r, amt); mx = doSpherize(pmx, ctr, r, amt);\n        py = doSpherize(ppy, ctr, r, amt); my = doSpherize(pmy, ctr, r, amt);\n        pz = doSpherize(ppz, ctr, r, amt); mz = doSpherize(pmz, ctr, r, amt);\n    }\n    else // Quantize - normals are meaningless after quantize, keep original\n    {\n        return nrm;\n    }\n\n    // Jacobian columns (partial derivatives of deformation)\n    vec3 dFdx = (px - mx) / (2.0 * eps);\n    vec3 dFdy = (py - my) / (2.0 * eps);\n    vec3 dFdz = (pz - mz) / (2.0 * eps);\n\n    // Transform normal by inverse-transpose of Jacobian:\n    // n' = normalize( inv(J)^T * n )\n    // For a 3x3 matrix, inv(J)^T can be computed via cofactor matrix.\n    // cofactor(J) = transpose of adjugate\n    mat3 J = mat3(dFdx, dFdy, dFdz);\n\n    // Cofactor matrix (each element is the 2x2 minor determinant with sign)\n    mat3 cof;\n    cof[0][0] = J[1][1]*J[2][2] - J[1][2]*J[2][1];\n    cof[0][1] = J[1][2]*J[2][0] - J[1][0]*J[2][2];\n    cof[0][2] = J[1][0]*J[2][1] - J[1][1]*J[2][0];\n    cof[1][0] = J[0][2]*J[2][1] - J[0][1]*J[2][2];\n    cof[1][1] = J[0][0]*J[2][2] - J[0][2]*J[2][0];\n    cof[1][2] = J[0][1]*J[2][0] - J[0][0]*J[2][1];\n    cof[2][0] = J[0][1]*J[1][2] - J[0][2]*J[1][1];\n    cof[2][1] = J[0][2]*J[1][0] - J[0][0]*J[1][2];\n    cof[2][2] = J[0][0]*J[1][1] - J[0][1]*J[1][0];\n\n    // inv(J)^T * n = cofactor * n (unnormalized)\n    vec3 newNormal = cof * nrm;\n    float len = length(newNormal);\n    return len > 0.0001 ? newNormal / len : nrm;\n}\n\nvoid main()\n{\n    uint idx = gl_GlobalInvocationID.x;\n    uint count = uint(ISF_WRITE(geo, position).length());\n    if(idx >= count)\n        return;\n\n    vec3 pos = ISF_READ(geo, position)[idx].xyz;\n    vec3 nrm = ISF_READ(geo, normal)[idx].xyz;\n\n    int dtype = int(deformType);\n    int ax = int(axis);\n\n    // Compute deformed normal (uses original position for Jacobian)\n    nrm = deformNormal(pos, nrm, center, ax, dtype, amount, radius, gridSize);\n\n    // Deform position\n    vec3 newPos;\n    if(dtype == 0)\n        newPos = doTwist(pos, center, ax, amount);\n    else if(dtype == 1)\n        newPos = doBend(pos, center, ax, amount);\n    else if(dtype == 2)\n        newPos = doTaper(pos, center, ax, amount);\n    else if(dtype == 3)\n        newPos = doSpherize(pos, center, radius, amount);\n    else\n        newPos = doQuantize(pos, gridSize);\n\n    ISF_WRITE(geo, position)[idx] = vec4(newPos, ISF_READ(geo, position)[idx].w);\n    ISF_WRITE(geo, normal)[idx] = vec4(nrm, 0.0);\n}\n","Root":"<LIBRARY>:packages/score-csf-testers/shaderlib/modifiers/Deform.cs","Inlets":[{"uuid":"f2ab26ea-415d-45a2-bfbc-2968c7c92a33","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"geo","Exposed":"geo"},{"uuid