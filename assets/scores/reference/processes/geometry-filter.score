color2;\n\tfloat\t\tsize = width * RENDERSIZE.x;\n\n\tif (size == 0.0)\t{\n\t\tout_color = color1;\n\t}\n\telse if ((mod(((gl_FragCoord.x+(offset.x*RENDERSIZE.x)) / size),2.0) < 2.0 * splitPos.x)&&(mod(((gl_FragCoord.y+(offset.y*RENDERSIZE.y)) / size),2.0) > 2.0 * splitPos.y))\t{\n\t\tout_color = color1;\n\t}\n\telse if ((mod(((gl_FragCoord.x+(offset.x*RENDERSIZE.x)) / size),2.0) > 2.0 * splitPos.x)&&(mod(((gl_FragCoord.y+(offset.y*RENDERSIZE.y)) / size),2.0) < 2.0 * splitPos.y))\t{\n\t\tout_color = color1;\n\t}\n\t\n\tgl_FragColor = out_color;\n}","Root":"<LIBRARY>:packages/default/Presets/GLSL_shaders/basic/generator/Checkerboard.fs","Inlets":[{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":0,"Hidden":true,"Custom":"width","Exposed":"width","Value":{"Float":0.16041536629199982},"Init":{"Float":0.25},"Domain":{"Float":{"Min":-0.25,"Max":0.5}}},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":1,"Hidden":true,"Custom":"offset","Exposed":"offset","Value":{"Vec2f":[0.0,0.0]},"Init":{"Vec2f":[0.0,0.0]},"Domain":{"Vec2f":{"Min":[0.0,0.0],"Max":[1.0,1.0],"Values":[[],[]]}},"Integral":false},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"color1","Exposed":"color1","Value":{"Vec4f":[0.03283741697669029,1.0,0.1276264637708664,1.0]},"Init":{"Vec4f":[1.0,1.0,1.0,1.0]},"Domain":{}},{"uuid":"8f38638e-9f9f-48b0-ae36-1cba86ef5703","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"color2","Exposed":"color2","Value":{"Vec4f":[0.6472877264022827,0.009842068888247013,0.7186388969421387,1.0]},"Init":{"Vec4f":[0.0,0.0,0.0,1.0]},"Domain":{}},{"uuid":"0adbbdda-fda4-451e-91cc-1da731bde9d5","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"splitPos","Exposed":"splitpos","Value":{"Vec2f":[0.5,0.5]},"Init":{"Vec2f":[0.5,0.5]},"Domain":{"Vec2f":{"Min":[0.0,0.0],"Max":[1.0,1.0],"Values":[[],[]]}},"Integral":false}],"Outlets":[{"uuid":"f1c71046-b754-49a5-8e66-d01374773dfc","ObjectName":"Outle